@inject AdminSessionService Session
@inject ActiveProjectState ActiveProject
@inject EngineApiClient Engine
@inject ThemeState Theme
@inject ClientMediaFolderService MediaFolder
@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IDisposable

@* Mobile hamburger (desktop collapse is on MainLayout) *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler" id="nav-toggler" />

<div class="nav-scrollable @(Collapsed ? "nav-collapsed" : null)"
     onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="nav flex-column nav-main" aria-label="Main">
        <div class="nav-main-links">
        @* Prototype look-feel: Home · Demo · Settings, then project studio pipeline *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" title="Home & Studio Overview" data-testid="nav-studio">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                @if (!Collapsed) { <span class="nav-label">Home</span> }
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/demo" title="Public demo gallery — no sign-in required" data-testid="nav-demo">
                <span class="bi bi-film-nav-menu" aria-hidden="true"></span>
                @if (!Collapsed) { <span class="nav-label">Demo</span> }
            </NavLink>
        </div>

        @if (Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/configuration" title="Settings — API keys, models, media folder" data-testid="nav-configuration">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Settings</span> }
                </NavLink>
            </div>
        }

        @if (ActiveProject.HasProject)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/adaptation" Match="NavLinkMatch.Prefix" title="Book & screenplay (studio)" data-testid="nav-adaptation">
                    <span class="bi bi-book-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Book</span> }
                </NavLink>
            </div>

            @NavItem(
                enabled: ActiveProject.CanCharacters,
                href: "/characters",
                title: ActiveProject.CanCharacters ? "Cast & voices" : ActiveProject.CharactersBlockedReason,
                iconClass: "bi-people-fill-nav-menu",
                label: "Cast",
                testId: "nav-characters")

            @NavItem(
                enabled: ActiveProject.CanScenes,
                href: "/scenes",
                title: ActiveProject.CanScenes ? "Scenes & film" : ActiveProject.ScenesBlockedReason,
                iconClass: "bi-film-nav-menu",
                label: "Film",
                testId: "nav-scenes")

            @NavItem(
                enabled: ActiveProject.CanReview,
                href: "/review",
                title: ActiveProject.CanReview ? "Review" : ActiveProject.ReviewBlockedReason,
                iconClass: "bi-check2-square-nav-menu",
                label: "Review",
                testId: "nav-review")

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/cost" title="Estimate & cost">
                    <span class="bi bi-cash-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Estimate</span> }
                </NavLink>
            </div>
        }



        @if (Session.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin" title="Admin">
                    <span class="bi bi-shield-lock-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Admin</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/demos" title="Demo moderation" data-testid="nav-admin-demos">
                    <span class="bi bi-film-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Demo review</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/users" title="Users & credits" data-testid="nav-admin-users">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Users &amp; credits</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/config" title="Admin config">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Admin config</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/learning" title="Learning from reviews" data-testid="nav-learning">
                    <span class="bi bi-lightbulb-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">Learning</span> }
                </NavLink>
            </div>
        }
        </div>@* /nav-main-links *@

        <div class="nav-user-footer"
             @onclick:stopPropagation="true">
            @if (Session.IsLoggedIn)
            {
                <div class="nav-user-menu @(_userMenuOpen ? "is-open" : null) @(Collapsed ? "is-collapsed" : null)">
                    <button type="button"
                            class="nav-user-trigger"
                            data-testid="nav-user-menu"
                            title="@Session.DisplayHandle — account menu"
                            aria-expanded="@_userMenuOpen"
                            aria-haspopup="menu"
                            @onclick="ToggleUserMenu"
                            @onclick:stopPropagation="true">
                        <span class="nav-user-avatar" aria-hidden="true">@UserInitials</span>
                        @if (!Collapsed)
                        {
                            <span class="nav-user-meta">
                                <span class="nav-user-name text-truncate">@Session.DisplayHandle</span>
                                <span class="nav-user-role">@(Session.IsAdmin ? "Admin" : "Account")</span>
                            </span>
                            <span class="nav-user-caret" aria-hidden="true">@(_userMenuOpen ? "▴" : "▾")</span>
                        }
                    </button>
                    @if (_userMenuOpen)
                    {
                        <button type="button"
                                class="nav-user-backdrop"
                                aria-label="Close account menu"
                                @onclick="CloseUserMenu"></button>
                        <div class="nav-user-dropdown" role="menu" @onclick:stopPropagation="true">
                            <div class="nav-user-dropdown-head">
                                <span class="nav-user-avatar nav-user-avatar--lg" aria-hidden="true">@UserInitials</span>
                                <div class="nav-user-dropdown-id">
                                    <div class="nav-user-name text-truncate">@Session.DisplayHandle</div>
                                    <div class="nav-user-role">@(Session.IsAdmin ? "Administrator" : "Signed in")</div>
                                </div>
                            </div>
                            <a class="nav-user-item" role="menuitem" href="/configuration"
                               @onclick="CloseUserMenu">
                                Configuration
                            </a>
                            @if (Session.IsAdmin)
                            {
                                <a class="nav-user-item" role="menuitem" href="/admin"
                                   @onclick="CloseUserMenu">
                                    Admin dashboard
                                </a>
                                <a class="nav-user-item" role="menuitem" href="/admin/demos"
                                   @onclick="CloseUserMenu">
                                    Demo review
                                </a>
                            }
                            <a class="nav-user-item" role="menuitem" href="/about"
                               @onclick="CloseUserMenu">
                                About
                            </a>
                            <button type="button"
                                    class="nav-user-item"
                                    role="menuitem"
                                    title="@(MediaFolder.IsConnected ? MediaFolder.FolderName : (MediaFolder.NeedsReconnect ? $"Re-grant access to {MediaFolder.PendingReconnectFolderName}" : "Store gen clips on your disk"))"
                                    @onclick="ConnectMediaFolderAsync">
                                @(MediaFolder.IsConnected
                                    ? $"Media: {MediaFolder.FolderName}"
                                    : (MediaFolder.NeedsReconnect ? $"Reconnect {MediaFolder.PendingReconnectFolderName}…" : "Connect media folder…"))
                            </button>
                            <button type="button"
                                    class="nav-user-item nav-user-item--danger"
                                    role="menuitem"
                                    data-testid="nav-sign-out"
                                    @onclick="LogoutAsync">
                                Sign out
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <NavLink class="nav-link nav-user-signin" href="/login" title="Sign In / Register" data-testid="nav-sign-in">
                    <span class="nav-user-avatar nav-user-avatar--ghost" aria-hidden="true">?</span>
                    @if (!Collapsed) { <span class="nav-label">Sign in</span> }
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {
    [Parameter] public bool Collapsed { get; set; }

    private bool _started;
    private bool _userMenuOpen;

    private string UserInitials
    {
        get
        {
            // Initials from public handle, not email
            var id = Session.DisplayHandle.TrimStart('@').Trim();
            if (id.Length == 0) return "?";
            var parts = id.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]));
            return id.Length >= 2
                ? id[..2].ToUpperInvariant()
                : id.ToUpperInvariant();
        }
    }

    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;

    private void CloseUserMenu() => _userMenuOpen = false;

    private RenderFragment NavItem(bool enabled, string href, string title, string iconClass, string label, string? testId = null) => __builder =>
    {
        <div class="nav-item px-3">
            @if (enabled)
            {
                <NavLink class="nav-link" href="@href" title="@title" data-testid="@testId">
                    <span class="bi @iconClass" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@label</span> }
                </NavLink>
            }
            else
            {
                <span class="nav-link nav-link-disabled"
                      title="@title"
                      data-testid="@(testId is null ? null : testId + "-disabled")"
                      aria-disabled="true">
                    <span class="bi @iconClass" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@label</span> }
                </span>
            }
        </div>
    };

    private string? _themedProjectId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;
        await Session.EnsureHydratedAsync();
        Session.Changed += OnSessionChanged;
        ActiveProject.Changed += OnProjectChanged;
        await ActiveProject.RefreshFromApiAsync(Engine);
        await RefreshThemeAsync();
        await MediaFolder.TryReconnectAsync();
        StateHasChanged();
    }

    private void OnSessionChanged() => InvokeAsync(() =>
    {
        if (!Session.IsLoggedIn)
            _userMenuOpen = false;
        StateHasChanged();
    });

    // Readiness is refreshed by RefreshFromApiAsync / callers after Set — only re-render here
    // (RefreshReadinessAsync must not be invoked from Changed or it loops).
    private void OnProjectChanged() => InvokeAsync(async () =>
    {
        await RefreshThemeAsync();
        StateHasChanged();
    });

    /// <summary>Pulls ui_theme from the active project's config and applies it to the DOM.
    /// Cheap no-op re-fetch guarded by project id so it only hits the API on an actual switch.</summary>
    private async Task RefreshThemeAsync()
    {
        var pid = ActiveProject.HasProject ? ActiveProject.ProjectId : null;
        if (string.Equals(pid, _themedProjectId, StringComparison.OrdinalIgnoreCase)) return;
        _themedProjectId = pid;

        var pref = "dark";
        if (pid is { Length: > 0 })
        {
            try
            {
                var dto = await Engine.GetConfigAsync(pid);
                if (dto?.Config is { } cfg &&
                    cfg.TryGetValue("ui_theme", out var el) &&
                    el.ValueKind == System.Text.Json.JsonValueKind.String)
                    pref = el.GetString() ?? "dark";
            }
            catch { /* API blip — keep default */ }
        }

        Theme.Set(pref);
        try { await Js.InvokeVoidAsync("fsTheme.apply", pref); }
        catch { /* prerender / no JS yet */ }
    }

    private async Task ConnectMediaFolderAsync()
    {
        _userMenuOpen = false;
        if (MediaFolder.NeedsReconnect)
            await MediaFolder.ReconnectAsync();
        else
            await MediaFolder.ConnectFolderAsync();
        await MediaFolder.EnsureHubHookAsync();
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        _userMenuOpen = false;
        await Engine.LogoutAsync();
        // LogoutAsync already ClearAsync's the session; ensure storage is gone before forceLoad.
        await Session.ClearAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    protected override void OnInitialized()
    {
        MediaFolder.Changed += OnMediaFolderChanged;
    }

    private void OnMediaFolderChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MediaFolder.Changed -= OnMediaFolderChanged;
        Session.Changed -= OnSessionChanged;
        ActiveProject.Changed -= OnProjectChanged;
    }
}
