@namespace PageToMovie.Web.Components
@*
  Shared film length target control. Loads natural/target from GET /film-runtime.
  Autosaves on change (debounced) and raises OnChanged so the estimate refreshes.
*@
@inject EngineApiClient Engine
@implements IDisposable

@if (_visible)
{
    @if (Embedded)
    {
        @LengthControl
    }
    else
    {
        <div class="card mb-3 border-primary border-opacity-25" data-testid="film-length-card">
            <div class="card-body p-3">
                @LengthControl
            </div>
        </div>
    }
}

@* Shared inner control — reused flat (Embedded) or inside the card. *@
@code {
    private RenderFragment LengthControl => __builder =>
    {
        <div class="fw-semibold mb-2">Film length</div>
        <label class="form-label small mb-1" for="@_inputId">Target length (minutes)</label>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input id="@_inputId"
                   type="number"
                   class="form-control form-control-sm"
                   style="max-width: 7rem;"
                   min="1"
                   max="180"
                   @bind="_edit"
                   @bind:event="oninput"
                   @bind:after="ScheduleAutosave"
                   disabled="@(_busy || Disabled)"
                   data-testid="film-length-input" />
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@(_busy || Disabled)"
                    data-testid="film-length-estimate"
                    @onclick="UseEstimateAsync">
                Use estimate (@_natural min)
            </button>
            @if (_busy)
            {
                <span class="small text-muted" data-testid="film-length-saving">Saving…</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="small text-danger mt-2" data-testid="film-length-error">@_error</div>
        }
    };
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Render the control flat (no card wrapper) so a host page can group it in one card.</summary>
    [Parameter] public bool Embedded { get; set; }

    private readonly string _inputId = "film-target-" + Guid.NewGuid().ToString("N")[..8];
    private string? _loadedFor;

    private bool _visible;
    private bool _busy;
    private int _natural = 1;
    private int _target = 1;
    private int _edit = 1;
    private string? _error;
    private CancellationTokenSource? _saveCts;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectId))
        {
            _visible = false;
            _loadedFor = null;
            return;
        }
        if (string.Equals(_loadedFor, ProjectId, StringComparison.OrdinalIgnoreCase) && _visible)
            return;
        await RefreshAsync();
    }

    public async Task RefreshAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectId)) return;
        _error = null;
        try
        {
            var dto = await Engine.GetFilmRuntimeAsync(ProjectId);
            _loadedFor = ProjectId;
            // Length is only meaningful after the book is imported / prepared.
            if (dto is null || !dto.Ok || !dto.HasBookText || dto.NaturalMinutes <= 0)
            {
                _visible = false;
                return;
            }
            _natural = Math.Clamp(dto.NaturalMinutes, 1, 180);
            _target = Math.Clamp(dto.TargetMinutes > 0 ? dto.TargetMinutes : _natural, 1, 180);
            _edit = _target;
            _visible = true;
        }
        catch (Exception ex)
        {
            _loadedFor = ProjectId;
            _visible = false;
            _error = ex.Message;
        }
    }

    /// <summary>Debounced autosave after the user edits the target.</summary>
    private void ScheduleAutosave()
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        var ct = _saveCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(700, ct);
                await InvokeAsync(async () =>
                {
                    if (!ct.IsCancellationRequested)
                        await SaveAsync();
                });
            }
            catch (OperationCanceledException) { /* superseded by a newer edit */ }
        });
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectId)) return;
        var minutes = Math.Clamp(_edit, 1, 180);
        if (minutes == _target) return; // no change
        _busy = true;
        _error = null;
        try
        {
            var dto = await Engine.SetFilmRuntimeAsync(ProjectId, minutes);
            if (dto is null || !dto.Ok)
                throw new InvalidOperationException("Save failed.");
            _natural = dto.NaturalMinutes > 0 ? dto.NaturalMinutes : _natural;
            _target = dto.TargetMinutes > 0 ? dto.TargetMinutes : minutes;
            _edit = _target;
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync(); // refreshes the estimate
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UseEstimateAsync()
    {
        _edit = _natural;
        await SaveAsync();
    }

    public void Dispose() => _saveCts?.Cancel();
}
