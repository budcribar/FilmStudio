@* Scene version history panel — list snapshots and restore. *@
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json
@using System.Text.Json

<div class="scene-version-history border rounded p-2 mt-2 bg-body-tertiary">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong class="small">Scene history</strong>
        <div class="d-flex gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="SnapshotAsync">
                Snapshot
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="LoadAsync">
                Refresh
            </button>
            <button type="button" class="btn btn-sm btn-link text-muted py-0" @onclick="OnClose">Close</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_ok ? "alert-success" : "alert-warning") py-1 small mb-2">@_message</div>
    }

    @if (_loading)
    {
        <div class="text-muted small">Loading…</div>
    }
    else if (_versions.Count == 0)
    {
        <div class="text-muted small">No snapshots yet. Click Snapshot to save the current scene state.</div>
    }
    else
    {
        <ul class="list-unstyled mb-0 small">
            @foreach (var v in _versions)
            {
                <li class="d-flex justify-content-between align-items-start gap-2 py-1 border-bottom">
                    <div>
                        <code>@v.VersionId</code>
                        <span class="text-muted ms-1">@v.CreatedUtc.ToLocalTime().ToString("g")</span>
                        @if (!string.IsNullOrWhiteSpace(v.Note))
                        {
                            <div class="text-muted">@v.Note</div>
                        }
                        @if (v.Files.Count > 0)
                        {
                            <div class="text-muted">@v.Files.Count file(s)</div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary flex-shrink-0"
                            disabled="@_busy"
                            @onclick="() => RestoreAsync(v)">
                        Restore
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string SceneKey { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnRestored { get; set; }

    private List<VersionDto> _versions = new();
    private bool _loading;
    private bool _busy;
    private bool _ok;
    private string? _message;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(ProjectId) && !string.IsNullOrWhiteSpace(SceneKey))
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            var resp = await Http.GetFromJsonAsync<ListResponse>(
                $"/api/projects/{ProjectId}/scenes/{Uri.EscapeDataString(SceneKey)}/versions");
            _versions = resp?.Versions ?? new();
        }
        catch (Exception ex)
        {
            _ok = false;
            _message = ex.Message;
            _versions = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SnapshotAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var resp = await Http.PostAsJsonAsync(
                $"/api/projects/{ProjectId}/scenes/{Uri.EscapeDataString(SceneKey)}/versions",
                new { note = "manual snapshot" });
            var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
            _ok = json.TryGetProperty("ok", out var o) && o.GetBoolean();
            _message = _ok ? "Snapshot saved." : "Snapshot failed.";
            if (_ok) await LoadAsync();
        }
        catch (Exception ex)
        {
            _ok = false;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreAsync(VersionDto v)
    {
        var when = v.CreatedUtc.ToLocalTime().ToString("g");
        var note = string.IsNullOrWhiteSpace(v.Note) ? "(no note)" : v.Note!;
        var msg =
            $"Restore scene version?\n\n" +
            $"Version: {v.VersionId}\n" +
            $"Saved: {when}\n" +
            $"Note: {note}\n\n" +
            "Current scene state/media for this scene may be overwritten. " +
            "This cannot be undone except by restoring another snapshot.";
        if (!await JS.InvokeAsync<bool>("confirm", msg))
            return;

        _busy = true;
        _message = null;
        try
        {
            var resp = await Http.PostAsync(
                $"/api/projects/{ProjectId}/scenes/{Uri.EscapeDataString(SceneKey)}/versions/{Uri.EscapeDataString(v.VersionId)}/restore",
                null);
            var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
            _ok = json.TryGetProperty("ok", out var o) && o.GetBoolean();
            if (_ok)
            {
                _message = $"Restored {v.VersionId}. Reloading scene…";
                // Parent reloads project/clips first; then refresh this list.
                await OnRestored.InvokeAsync();
                await LoadAsync();
                _message = $"Restored {v.VersionId}.";
            }
            else
            {
                _message = json.TryGetProperty("error", out var e) ? e.GetString() : "Restore failed.";
            }
        }
        catch (Exception ex)
        {
            _ok = false;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ListResponse
    {
        public bool Ok { get; set; }
        public List<VersionDto> Versions { get; set; } = new();
    }

    private sealed class VersionDto
    {
        public string VersionId { get; set; } = "";
        public string SceneKey { get; set; } = "";
        public DateTime CreatedUtc { get; set; }
        public string? Note { get; set; }
        public string? CreatedBy { get; set; }
        public List<string> Files { get; set; } = new();
    }
}
