@* Reusable "read along in your voice" capture step: prepare phrases from the narrator's own lines,
   then per-phrase Listen → record → score → keep best takes → build + apply the cloned voice. Host
   supplies the ProjectId and handles what happens next via OnComplete. Extracted from the former
   /voice-capture page so the easy-start flow (and anywhere else) can embed the good recorder. *@
@using PageToMovie.Core.Models
@inject EngineApiClient Engine
@inject ClientVideoStitchService Stitch
@inject ClientVoiceCaptureService Capture
@inject ClientMediaFolderService MediaFolder
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IJSRuntime Js

<style>
    .ptm-ball-track { position: relative; height: 10px; background: rgba(255,255,255,.12); border-radius: 6px; overflow: hidden; }
    .ptm-ball-dot { position: absolute; top: -5px; width: 20px; height: 20px; border-radius: 50%;
        background: #ffc107; box-shadow: 0 0 10px #ffc107; }
    .ptm-ball-run { animation: ptm-ball-move var(--ptm-ball-dur, 3s) linear forwards; }
    @@keyframes ptm-ball-move { from { left: 0; } to { left: calc(100% - 20px); } }
    .ptm-light-box { display: inline-flex; flex-direction: column; gap: 8px; padding: 10px; border-radius: 12px; background: #1b1b1b; }
    .ptm-light { width: 34px; height: 34px; border-radius: 50%; transition: background .15s, box-shadow .15s; }
    .ptm-red-off { background: #3a1310; } .ptm-red-on { background: #ff3b30; box-shadow: 0 0 14px #ff3b30; }
    .ptm-yellow-off { background: #3a3210; } .ptm-yellow-on { background: #ffcc00; box-shadow: 0 0 14px #ffcc00; }
    .ptm-green-off { background: #123a1f; } .ptm-green-on { background: #34c759; box-shadow: 0 0 14px #34c759; }
    .ptm-light-box-h { display: inline-flex; flex-direction: row; gap: 6px; padding: 6px 8px; border-radius: 10px; background: #1b1b1b; }
    .ptm-light-sm { width: 18px; height: 18px; border-radius: 50%; }
    .tele-viewport { position: relative; overflow: hidden; height: 1.9em; }
    .tele-text { position: absolute; left: 6%; white-space: nowrap; will-change: transform; }
    .tele-w { display: inline-block; margin-right: 0.32em; }
    .tele-w.tele-active { background: rgba(255,193,7,.32); border-radius: 4px; }
    .ptm-wave-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .ptm-wave-label { width: 62px; flex-shrink: 0; font-size: .8rem; color: #93a3b8; }
    .ptm-wave { flex-grow: 1; width: 100%; max-width: 520px; height: 34px; background: rgba(255,255,255,.05); border-radius: 6px; }
</style>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" data-testid="voice-capture-error">@_error</div>
}

@if (_loading)
{
    <p class="text-muted">Getting things ready…</p>
}
else if (string.IsNullOrEmpty(_projectId))
{
    <div class="alert alert-info">No film selected.</div>
}
else if (_phrases.Count == 0)
{
    <div class="text-center py-2">
        <p class="text-muted mb-3">We just need to find your dialogue first — a one-time step (about a minute).</p>
        <button class="btn btn-primary" disabled="@_busy" data-testid="voice-capture-prepare" @onclick="PreparePhrasesAsync">
            @(_busy ? "Preparing…" : "Prepare phrases")
        </button>
        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="small text-muted mt-3">@_status</div>
        }
    </div>
}
else if (_done)
{
    <div class="text-center py-2">
        <div class="h4 mb-2">🎉 Your voice is ready</div>
        <p class="text-muted mb-0">@_status</p>
    </div>
}
else
{
    <div data-testid="voice-capture-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold">Phrase @(_i + 1) of @_phrases.Count</span>
            <span class="badge text-bg-secondary">@_kept.Count kept</span>
        </div>
        @{ var words = SplitWords(CurrentPhrase.Text); }
        @{ var inTele = _recording || _light > 0 || _listening; }
        @if (inTele)
        {
            @* The light sits just left of the marker, so your eye flows light → start → scrolling
               words. Shown for Listen (original scrolls), the countdown (static), and recording. *@
            <div class="d-flex align-items-center gap-2 mb-1">
                <div class="ptm-light-box-h" data-testid="voice-capture-light">
                    <span class="ptm-light-sm @(_light == 1 ? "ptm-red-on" : "ptm-red-off")"></span>
                    <span class="ptm-light-sm @(_light == 2 ? "ptm-yellow-on" : "ptm-yellow-off")"></span>
                    <span class="ptm-light-sm @(_light == 3 ? "ptm-green-on" : "ptm-green-off")"></span>
                </div>
                <div class="tele-viewport flex-grow-1">
                    <div id="tele-text" @key="_teleSession" class="tele-text fs-5">
                        @foreach (var w in words)
                        {
                            <span class="tele-w">@w</span>
                        }
                    </div>
                </div>
            </div>
            <div class="small mb-3 @(_listening ? "text-info" : "text-danger")">
                @(_light == 1 ? "Get ready…"
                    : _light == 2 ? "Set…"
                    : _light == 3 ? "Go — read it!"
                    : _listening ? "This is how the narrator reads it — watch the words"
                    : "● Read the word at the line")
            </div>
        }
        else
        {
            <div style="overflow-x:auto; max-width:100%;" class="mb-1">
                <p class="fs-5 mb-0" data-testid="voice-capture-text" style="white-space:nowrap;">
                    @for (var wi = 0; wi < words.Count; wi++)
                    {
                        <span style="@WordStyle(wi)">@words[wi]</span>@(" ")
                    }
                </p>
            </div>
            @if (_regions is { Count: > 0 })
            {
                <div class="small text-muted mb-3">Colours show where your rhythm matched — aim to turn the red/orange words green.</div>
            }
            else
            {
                <div class="mb-3"></div>
            }
        }

        @* Compare — play the narrator, yourself, or both together; the strips show the rhythm. *@
        <div class="mb-3">
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button class="btn btn-outline-primary btn-sm"
                        disabled="@(_busy || _recording || _light > 0 || _listening || string.IsNullOrEmpty(_originalUrl))"
                        data-testid="voice-capture-listen" @onclick="ListenAsync">
                    @(_listening ? "▶ Narrator…" : "▶ Narrator")
                </button>
                @if (!string.IsNullOrEmpty(_takeUrl))
                {
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(_busy || _recording || _light > 0 || _listening)"
                            data-testid="voice-capture-play-you" @onclick="PlayYouAsync">▶ You</button>
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(_busy || _recording || _light > 0 || _listening)"
                            data-testid="voice-capture-play-both" @onclick="PlayBothAsync">▶ Both</button>
                }
                @if (string.IsNullOrEmpty(_originalUrl))
                {
                    <span class="text-muted small align-self-center">Loading original…</span>
                }
            </div>

            <div class="ptm-wave-row">
                <span class="ptm-wave-label">Narrator</span>
                <canvas id="ptm-wave-narrator" class="ptm-wave" height="34"></canvas>
            </div>
            @if (!string.IsNullOrEmpty(_takeUrl))
            {
                <div class="ptm-wave-row">
                    <span class="ptm-wave-label">You</span>
                    <canvas id="ptm-wave-you" class="ptm-wave" height="34"></canvas>
                </div>
                @if (_score is int sc)
                {
                    <div class="mt-1 small fw-semibold @ScoreClass(sc)" data-testid="voice-capture-score">@ScoreLabel(sc)</div>
                }
            }
        </div>

        @* Controls (hidden during the light countdown) *@
        <div class="d-flex flex-wrap gap-2">
            @if (_recording)
            {
                <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="StopAndScoreAsync">
                    ⏹ Stop
                </button>
            }
            else if (_light == 0)
            {
                <button class="btn btn-danger" disabled="@(_busy || string.IsNullOrEmpty(_originalUrl))"
                        data-testid="voice-capture-record" @onclick="RecordAsync">
                    🔴 @(_takeUrl is null ? "Record" : "Re-record")
                </button>

                @if (!string.IsNullOrEmpty(_takeUrl))
                {
                    <button class="btn btn-primary" disabled="@_busy" data-testid="voice-capture-keep" @onclick="KeepAndNextAsync">
                        Keep &amp; @(_i + 1 < _phrases.Count ? "next →" : "finish")
                    </button>
                }

                @if (_kept.Count > 0)
                {
                    <button class="btn btn-success ms-auto" disabled="@_busy" data-testid="voice-capture-finish" @onclick="FinishAsync">
                        ✓ Create my voice (@_kept.Count)
                    </button>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="small text-muted mt-2">@_status</div>
        }
    </div>
}

@code {
    /// <summary>The film to build the narrator's cloned voice for. Supplied by the host.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    /// <summary>Which character this recording becomes the voice of. Defaults to the narrator —
    /// pass a different character key when the host resolved a non-narrator target (e.g. the story
    /// has no narrator and the user picked a speaking character instead).</summary>
    [Parameter] public string CharKey { get; set; } = "Character_Narrator";

    /// <summary>Fired once the cloned voice has been built and applied — host advances to the next step.</summary>
    [Parameter] public EventCallback OnComplete { get; set; }

    private const int MaxPhrases = 8;

    private string? _projectId;
    private bool _loading = true;
    private bool _busy;
    private bool _done;
    private string? _error;
    private string? _status;

    private List<VoiceCapturePhrase> _phrases = new();
    private int _i;

    // Scene stitched video URLs, cached so we only stitch a scene once.
    private readonly Dictionary<int, string> _sceneUrls = new();

    private string? _originalUrl;   // extracted original segment (Listen)
    private string? _takeUrl;       // user's recording as a data: URL
    private int? _score;
    private List<double>? _regions; // per-word rhythm match (0..1), for colouring

    private bool _recording;
    private bool _listening; // playing the original + scrolling it so the user sees the narrator's pace
    private int _light; // 0 = off, 1 = red, 2 = yellow, 3 = green (go)
    private double _ballDurationSec = 3;
    private int _recordSession;
    private int _teleSession; // bumped to (re)start the teleprompter scroll (Listen and on "Go")
    private bool _teleStartPending; // set when a scroll should start on the next render (spans in DOM)
    private bool _renderNarratorWave; // draw the narrator strip on the next render
    private bool _renderYouWave;      // draw the "you" strip (coloured by match) on the next render

    private readonly List<string> _kept = new(); // kept take data URLs

    private VoiceCapturePhrase CurrentPhrase => _phrases[Math.Clamp(_i, 0, _phrases.Count - 1)];

    protected override async Task OnInitializedAsync()
    {
        // Ensure the login session is loaded before any identity-gated call.
        try { await Session.EnsureHydratedAsync(); } catch { /* ignore */ }
        _projectId = ProjectId;
        _loading = false;
        if (!string.IsNullOrEmpty(_projectId))
            await LoadPhrasesAsync();
    }

    private async Task LoadPhrasesAsync()
    {
        _phrases = new(); _i = 0; _sceneUrls.Clear();
        _originalUrl = null; _takeUrl = null; _score = null; _regions = null;
        _kept.Clear(); _done = false; _error = null; _status = null;
        if (string.IsNullOrEmpty(_projectId)) { StateHasChanged(); return; }
        try
        {
            var data = await Engine.GetVoiceCapturePhrasesAsync(_projectId);
            // Ignore a cache built for a different character — old caches (before CharKey existed)
            // are implicitly the narrator's.
            var cachedKey = string.IsNullOrWhiteSpace(data?.CharKey) ? "Character_Narrator" : data!.CharKey!.Trim();
            if (string.Equals(cachedKey, CharKey, StringComparison.OrdinalIgnoreCase))
                _phrases = SelectPool(data?.Phrases);
        }
        catch (Exception ex) { _error = ex.Message; }
        if (_phrases.Count > 0) await PreparePhraseAsync();
        StateHasChanged();
    }

    private static List<VoiceCapturePhrase> SelectPool(List<VoiceCapturePhrase>? all) =>
        (all ?? new())
            .Where(p => p.Confident)
            .OrderBy(p => p.Rank < 0 ? int.MaxValue : p.Rank)
            .ThenByDescending(p => p.DurationSec)
            .Take(MaxPhrases)
            .ToList();

    private async Task PreparePhrasesAsync()
    {
        if (string.IsNullOrEmpty(_projectId)) return;
        _busy = true; _error = null; _status = "Finding your dialogue…";
        StateHasChanged();
        try
        {
            var built = await Capture.BuildPhrasesAsync(_projectId, s => { _status = s; _ = InvokeAsync(StateHasChanged); }, CharKey);
            _phrases = SelectPool(built?.Phrases);
            if (_phrases.Count == 0)
                _status = "Couldn't find clear narrator dialogue to match — make sure the clips are generated.";
            else { _i = 0; await PreparePhraseAsync(); }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task PreparePhraseAsync()
    {
        _originalUrl = null;
        _takeUrl = null;
        _score = null; _regions = null;
        StateHasChanged();

        var p = CurrentPhrase;
        _ballDurationSec = Math.Max(1.0, p.DurationSec);
        try
        {
            var sceneUrl = await GetSceneUrlAsync(p.Scene);
            if (string.IsNullOrEmpty(sceneUrl)) { _status = "Couldn't load that scene."; return; }
            var res = await Js.InvokeAsync<ExtractUrlResult>(
                "PageToMovieFfmpeg.extractAudioSegmentToUrlAsync", sceneUrl, p.WindowStartSec, p.WindowEndSec);
            if (res is { Success: true }) { _originalUrl = res.Url; _renderNarratorWave = true; }
            else _status = res?.Error ?? "Couldn't load the original clip.";
        }
        catch (Exception ex) { _status = ex.Message; }
        StateHasChanged();
    }

    private Task<string?> GetSceneUrlAsync(int scene) =>
        ScenePlaybackSupport.GetSceneUrlAsync(Stitch, _projectId!, scene, _sceneUrls);

    private async Task ListenAsync()
    {
        if (string.IsNullOrEmpty(_originalUrl) || _listening || _recording || _light > 0) return;
        _listening = true;
        _teleSession++;
        _teleStartPending = true; // the scroll starts in OnAfterRenderAsync, once the spans render
        StateHasChanged();
        try { await Js.InvokeAsync<bool>("PageToMovieFfmpeg.playAudioAsync", _originalUrl); }
        catch { /* ignore playback errors */ }
        _listening = false;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_teleStartPending)
        {
            _teleStartPending = false;
            var (starts, ends) = BuildWordTimeline(SplitWords(CurrentPhrase.Text), _ballDurationSec);
            try { await Js.InvokeVoidAsync("PageToMovieFfmpeg.startWordTeleprompter", starts, ends, _ballDurationSec); }
            catch { /* ignore */ }
        }
        if (_renderNarratorWave && !string.IsNullOrEmpty(_originalUrl))
        {
            _renderNarratorWave = false;
            try { await Js.InvokeVoidAsync("PageToMovieFfmpeg.renderWaveformAsync", "ptm-wave-narrator", _originalUrl, (object?)null); }
            catch { /* ignore */ }
        }
        if (_renderYouWave && !string.IsNullOrEmpty(_takeUrl))
        {
            _renderYouWave = false;
            try { await Js.InvokeVoidAsync("PageToMovieFfmpeg.renderWaveformAsync", "ptm-wave-you", _takeUrl, _regions); }
            catch { /* ignore */ }
        }
    }

    private async Task PlayYouAsync()
    {
        if (string.IsNullOrEmpty(_takeUrl) || _busy || _recording || _light > 0 || _listening) return;
        try { await Js.InvokeAsync<bool>("PageToMovieFfmpeg.playAudioAsync", _takeUrl); }
        catch { /* ignore playback errors */ }
    }

    private async Task PlayBothAsync()
    {
        if (string.IsNullOrEmpty(_takeUrl) || string.IsNullOrEmpty(_originalUrl) || _busy || _recording || _light > 0 || _listening) return;
        try { await Js.InvokeAsync<bool>("PageToMovieFfmpeg.playOverlayAsync", _originalUrl, _takeUrl); }
        catch { /* ignore playback errors */ }
    }

    private (double[] starts, double[] ends) BuildWordTimeline(List<string> disp, double durSec)
    {
        var n = disp.Count;
        var starts = new double[n];
        var ends = new double[n];
        if (n == 0) return (starts, ends);

        var words = CurrentPhrase.Words;
        if (words is null || words.Count == 0)
        {
            for (var i = 0; i < n; i++) { starts[i] = durSec * i / n; ends[i] = durSec * (i + 1) / n; }
            return (starts, ends);
        }

        var knownStart = new double?[n];
        var knownEnd = new double?[n];
        var si = 0;
        for (var di = 0; di < n; di++)
        {
            var dt = NormTok(disp[di]);
            if (dt.Length == 0) continue;
            for (var j = si; j < words.Count && j <= si + 4; j++)
            {
                if (NormTok(words[j].Text) == dt)
                {
                    knownStart[di] = Math.Max(0, words[j].StartSec);
                    knownEnd[di] = Math.Max(words[j].StartSec, words[j].EndSec);
                    si = j + 1;
                    break;
                }
            }
        }

        int prevIdx = -1; double prevTime = 0;
        for (var di = 0; di < n; di++)
        {
            if (knownStart[di] is not double kt) continue;
            for (var g = prevIdx + 1; g < di; g++)
                starts[g] = prevTime + (kt - prevTime) * (g - prevIdx) / (di - prevIdx);
            starts[di] = kt; prevIdx = di; prevTime = kt;
        }
        for (var g = prevIdx + 1; g < n; g++)
            starts[g] = prevTime + (durSec - prevTime) * (g - prevIdx) / (n - prevIdx);

        double last = 0;
        for (var i = 0; i < n; i++)
        {
            if (starts[i] < last) starts[i] = last;
            if (starts[i] > durSec) starts[i] = durSec;
            last = starts[i];
        }

        for (var i = 0; i < n; i++)
        {
            var cap = i + 1 < n ? starts[i + 1] : durSec;
            var e = knownEnd[i] ?? cap;
            if (e < starts[i]) e = starts[i];
            if (e > cap) e = cap;
            ends[i] = e;
        }
        return (starts, ends);
    }

    private static string NormTok(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        var chars = s.ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray();
        return new string(chars);
    }

    private async Task RecordAsync()
    {
        _error = null; _status = null; _takeUrl = null; _score = null; _regions = null;

        // Red → yellow → green. Recording (and the ball) start on green, so you're not caught mid-click.
        _light = 1; StateHasChanged(); await Task.Delay(650); // red
        _light = 2; StateHasChanged(); await Task.Delay(650); // yellow
        _light = 3; StateHasChanged();                        // green = go

        try
        {
            await Js.InvokeAsync<object>("PageToMovieVoiceCapture.start");
            _recording = true;
            _teleSession++;             // fresh teleprompter element on "Go"
            _teleStartPending = true;   // its paced scroll starts in OnAfterRenderAsync
            var session = ++_recordSession;
            StateHasChanged();
            _ = ClearLightAsync();
            _ = AutoStopAsync(session, (int)((_ballDurationSec + 1.0) * 1000));
        }
        catch (Exception ex) { _error = "Microphone failed: " + ex.Message; _recording = false; _light = 0; }
    }

    private async Task ClearLightAsync()
    {
        await Task.Delay(650); // let the green light linger a beat once recording is live
        _light = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AutoStopAsync(int session, int delayMs)
    {
        await Task.Delay(delayMs);
        if (_recording && session == _recordSession)
            await InvokeAsync(StopAndScoreAsync);
    }

    private async Task StopAndScoreAsync()
    {
        if (!_recording) return;
        _busy = true;
        _recording = false;
        _light = 0;
        _recordSession++; // invalidate any pending auto-stop
        StateHasChanged();
        try
        {
            var result = await Js.InvokeAsync<VoiceCaptureStopResult>("PageToMovieVoiceCapture.stop");
            if (result is null || !result.Ok || string.IsNullOrEmpty(result.Base64))
            {
                _status = result?.Error ?? "No audio captured.";
                return;
            }
            var mime = MimeFor(result.FileName);
            _takeUrl = $"data:{mime};base64,{result.Base64}";
            StateHasChanged();

            if (!string.IsNullOrEmpty(_originalUrl))
            {
                var wc = SplitWords(CurrentPhrase.Text).Count;
                var s = await Js.InvokeAsync<RhythmResult>(
                    "PageToMovieFfmpeg.analyzeRhythmMatchAsync", _originalUrl, _takeUrl, wc);
                if (s is { Success: true }) { _score = s.Score; _regions = s.Regions; _renderYouWave = true; }
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task KeepAndNextAsync()
    {
        if (!string.IsNullOrEmpty(_takeUrl)) _kept.Add(_takeUrl);
        if (_i + 1 < _phrases.Count)
        {
            _i++;
            await PreparePhraseAsync();
        }
        else
        {
            await FinishAsync();
        }
    }

    private async Task FinishAsync()
    {
        if (_kept.Count == 0 || string.IsNullOrEmpty(_projectId)) return;
        _busy = true; _error = null; _status = "Building your voice from your best takes…";
        StateHasChanged();
        try
        {
            // Trim each take's ragged edge silence, then rejoin with a natural ~0.4 s pause between
            // sentences — a clean clone sample that still has real between-sentence dead air.
            var bytes = await Js.InvokeAsync<byte[]>("PageToMovieFfmpeg.buildCloneSampleAsync", (object)_kept.ToArray(), 0.4);
            if (bytes is null || bytes.Length < 512) { _error = "Couldn't assemble your takes."; return; }

            var rel = "assets/characters/" + CharKey + "/voice_clone_sample.wav";
            if (!MediaFolder.IsConnected) await MediaFolder.TryReconnectAsync();
            try { await MediaFolder.SaveBytesAsync(_projectId, rel, bytes, promptToConnectFolder: false); } catch { /* best effort */ }

            await using var ms = new MemoryStream(bytes);
            await Engine.UploadVoiceCloneSampleAsync(_projectId, CharKey, ms, "voice_clone_sample.wav");

            _status = "Applying your voice…";
            StateHasChanged();
            var apply = await Engine.ApplyVoiceCloneAsync(_projectId, CharKey);
            _done = true;
            _status = apply.Ok
                ? (apply.UsedMock ? "Demo voice applied. You can make the movie." : "Voice applied. You can make the movie.")
                : ("Takes saved. " + (apply.Error ?? apply.Message ?? "Could not apply the voice."));
            StateHasChanged();
            if (apply.Ok)
                await OnComplete.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private static string MimeFor(string? fileName) =>
        Path.GetExtension(fileName ?? "").ToLowerInvariant() switch
        {
            ".wav" => "audio/wav",
            ".mp3" => "audio/mpeg",
            ".m4a" or ".aac" => "audio/mp4",
            ".ogg" => "audio/ogg",
            _ => "audio/webm",
        };

    private static List<string> SplitWords(string? t) =>
        string.IsNullOrWhiteSpace(t) ? new() : t.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).ToList();

    private string WordStyle(int wordIndex)
    {
        if (_recording || _regions is not { Count: > 0 } r) return "";
        var m = r[Math.Min(wordIndex, r.Count - 1)];
        var (rr, gg, bb) = m >= 0.7 ? (52, 199, 89) : m >= 0.5 ? (255, 204, 0) : (255, 59, 48);
        return $"background: rgba({rr},{gg},{bb},.32); border-radius:4px; padding:0 3px;";
    }

    private static string ScoreLabel(int s) => s >= 80 ? "Great match!" : s >= 60 ? "Nice!" : s >= 40 ? "Good — try the rhythm again" : "Give it another go";
    private static string ScoreClass(int s) => s >= 60 ? "text-success" : s >= 40 ? "text-warning" : "text-muted";

    private sealed class ExtractUrlResult { public bool Success { get; set; } public string? Url { get; set; } public string? Error { get; set; } }
    private sealed class RhythmResult { public bool Success { get; set; } public int Score { get; set; } public List<double>? Regions { get; set; } public string? Error { get; set; } }
    private sealed class VoiceCaptureStopResult { public bool Ok { get; set; } public string? Error { get; set; } public string? Base64 { get; set; } public string? FileName { get; set; } }
}
