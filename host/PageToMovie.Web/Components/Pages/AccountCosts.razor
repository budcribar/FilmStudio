@page "/account/costs"
@inject EngineApiClient Engine
@inject AdminSessionService Session
@using System.Globalization

<PageTitle>Account · Costs</PageTitle>

<div class="ptm-page-head mb-3">
    <span class="ptm-adapt-kicker">Account · Billing</span>
    <h1 class="ptm-adapt-title mb-1">All projects &amp; account costs</h1>
    <p class="ptm-adapt-lede mb-0">
        Everything you’ve spent across every project, by project and by vendor.
        For a single film’s quote, open <a href="cost">Estimate</a>.
    </p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_mySpend is null)
{
    <div class="alert alert-light border">No tracked spend yet.</div>
}
else
{
    <div class="card mb-4" data-testid="account-my-spend">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                <div class="fw-semibold">Your spending</div>
                <button class="btn btn-sm btn-outline-secondary" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
            </div>
            <p class="small text-muted mb-3">
                Tracked under your account (shown as list rate × admin multiplier; ledger stores list only).
                Vendor = catalog provider (xAI, Google, ElevenLabs, …).
            </p>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted text-uppercase">All projects</div>
                        <div class="fs-4 fw-semibold" data-testid="account-my-total-charge">@Usd(_mySpend.TotalChargeUsd)</div>
                        <div class="small text-muted">List @Usd(_mySpend.TotalListUsd) · @_mySpend.TotalCalls calls</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted text-uppercase">Projects with spend</div>
                        <div class="fs-4 fw-semibold">@_mySpend.ByProject.Count(p => p.ChargeUsd > 0)</div>
                        <div class="small text-muted">across your account</div>
                    </div>
                </div>
            </div>

            @if (_mySpend.ByProject.Count > 0)
            {
                <div class="fw-semibold small mb-2">By project</div>
                <div class="table-responsive mb-3">
                    <table class="table table-sm mb-0" data-testid="account-my-by-project">
                        <thead>
                            <tr class="small text-muted">
                                <th>Project</th>
                                <th class="text-end">Calls</th>
                                <th class="text-end">List</th>
                                <th class="text-end">Charge</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _mySpend.ByProject.OrderByDescending(x => x.ChargeUsd))
                            {
                                <tr class="@(string.Equals(p.ProjectId, _activeProjectId, StringComparison.OrdinalIgnoreCase) ? "table-primary" : "")">
                                    <td>@p.ProjectId</td>
                                    <td class="text-end">@p.Calls</td>
                                    <td class="text-end">@Usd(p.ListUsd)</td>
                                    <td class="text-end">@Usd(p.ChargeUsd)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (_mySpend.ByProvider.Count > 0)
            {
                <div class="fw-semibold small mb-2">By vendor</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0" data-testid="account-my-by-vendor">
                        <thead>
                            <tr class="small text-muted">
                                <th>Vendor</th>
                                <th class="text-end">Calls</th>
                                <th class="text-end">List</th>
                                <th class="text-end">Charge</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kv in _mySpend.ByProvider.OrderByDescending(kv => kv.Value.TotalChargeUsd > 0 ? kv.Value.TotalChargeUsd : kv.Value.TotalUsd))
                            {
                                var charge = kv.Value.TotalChargeUsd > 0 ? kv.Value.TotalChargeUsd : kv.Value.TotalUsd;
                                var list = kv.Value.TotalListUsd > 0 ? kv.Value.TotalListUsd : kv.Value.TotalUsd;
                                <tr>
                                    <td>@ProviderLabel(kv.Key)</td>
                                    <td class="text-end">@kv.Value.Count</td>
                                    <td class="text-end">@Usd(list)</td>
                                    <td class="text-end">@Usd(charge)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <td>Total</td>
                                <td class="text-end">@_mySpend.TotalCalls</td>
                                <td class="text-end">@Usd(_mySpend.TotalListUsd)</td>
                                <td class="text-end">@Usd(_mySpend.TotalChargeUsd)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string _activeProjectId = "";
    private EngineApiClient.UserSpendSummaryDto? _mySpend;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            // Active project only to highlight its row — this page is account-wide.
            try
            {
                var projs = await Engine.GetProjectsAsync();
                _activeProjectId = projs?.Active?.Id ?? "";
            }
            catch { _activeProjectId = ""; }

            _mySpend = await Engine.GetMySpendAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _mySpend = null;
        }
        finally { _loading = false; }
    }

    private static string Usd(double v) => $"${v:0.00}";

    private static string ProviderLabel(string? id)
    {
        if (string.IsNullOrWhiteSpace(id)) return "Unknown";
        return id.Trim().ToLowerInvariant() switch
        {
            "xai" or "grok" => "xAI",
            "google" or "gemini" => "Google",
            "openai" => "OpenAI",
            "anthropic" => "Anthropic",
            "elevenlabs" => "ElevenLabs",
            "fal" => "Fal",
            "suno" => "Suno API",
            "aimusicapi" => "AI Music API",
            "perplexity" => "Perplexity",
            "unknown" => "Unknown",
            _ => id,
        };
    }
}
