@page "/simple-voice"
@implements IAsyncDisposable
@using PageToMovie.Core.Models
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject ClientMediaFolderService MediaFolder
@inject ClientVoiceSubstitutionService VoiceSub
@inject NavigationManager Nav
@inject IJSRuntime Js
@using PageToMovie.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Read in your voice · PageToMovie</PageTitle>

<div class="ptm-page-head mb-3">
    <span class="ptm-adapt-kicker">Easiest start</span>
    <h1 class="ptm-adapt-title mb-1">Two steps · story and your voice</h1>
    <p class="ptm-adapt-lede mb-0">
        Pick a library book, record one sample, then make the movie.
        Stock pictures stay as-is — we only re-speak the narrator as you.
    </p>
</div>

@if (!Session.IsLoggedIn)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span>Sign in to open a library book and save your voice sample.</span>
        <a class="btn btn-sm btn-primary" href="login?returnUrl=/simple-voice">Sign in</a>
    </div>
}
else
{
    <StudioProcessStrip Active="@(_phase == Phase.Movie ? "film" : _phase is Phase.Record or Phase.Done ? "cast" : "book")" SimpleMode="true" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" data-testid="simple-voice-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message) && string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-success py-2" data-testid="simple-voice-message">@_message</div>
    }

    @* ── Step 1: choose story ─────────────────────────────────────────── *@
    @if (_phase == Phase.Pick)
    {
        <div class="card border-primary border-opacity-50 mb-3" data-testid="simple-voice-pick">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge text-bg-primary">Step 1 of 2</span>
                    <span class="badge text-bg-secondary">Voice-only · low cost</span>
                </div>
                <h2 class="h5 mb-2">Choose a story</h2>
                <p class="small text-muted mb-3">
                    Pick a film — we make your own copy, then you record one sample and we put your voice on the narrator.
                </p>
                @if (_storiesLoading)
                {
                    <p class="small text-muted">Loading stories…</p>
                }
                else if (_forkableStories.Count == 0)
                {
                    <div class="alert alert-light border small mb-3">
                        No shareable stories yet. Mark a film “Public (Forkable)” in the full studio to see it here.
                    </div>
                }
                else
                {
                    <div class="list-group mb-3">
                        @foreach (var story in _forkableStories)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action"
                                    disabled="@_busy"
                                    data-testid="@($"simple-voice-story-{story.Id}")"
                                    @onclick="() => SelectStoryAsync(story)">
                                <div class="d-flex justify-content-between gap-2 align-items-center">
                                    <div class="fw-semibold text-start">@story.Title</div>
                                    <span class="small text-muted flex-shrink-0">Read in my voice →</span>
                                </div>
                            </button>
                        }
                    </div>
                }
                <a class="btn btn-link btn-sm px-0" href="/" data-testid="simple-voice-home">
                    Full studio instead
                </a>
            </div>
        </div>
    }

    @* ── Step 2: record narrator (no character list) ──────────────────── *@
    else if (_phase is Phase.Record or Phase.Done)
    {
        <div class="card border-primary border-opacity-50 mb-3" data-testid="simple-voice-record">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge text-bg-primary me-2">Step 2 of 3</span>
                    <span class="fw-semibold">Record your voice</span>
                    @if (!string.IsNullOrEmpty(_projectLabel))
                    {
                        <span class="text-muted small ms-2">· @_projectLabel</span>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="BackToPick">
                    ← Change story
                </button>
            </div>
            <div class="card-body">
                @if (_hasSample && !_reRecording)
                {
                    <div class="mb-3" data-testid="simple-voice-ready">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge text-bg-success">Your voice is ready</span>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    disabled="@_busy"
                                    data-testid="simple-voice-rerecord"
                                    @onclick="StartReRecord">
                                Re-record
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_samplePlayUrl))
                        {
                            <div class="small text-muted mb-1">Have a listen to make sure it sounds like you:</div>
                            <audio class="w-100" controls src="@_samplePlayUrl" @key="_samplePlayUrl"
                                   data-testid="simple-voice-ready-audio"></audio>
                        }
                        else
                        {
                            <div class="small text-muted">
                                Not sure it recorded? Tap <strong>Re-record</strong> to try again.
                            </div>
                        }
                    </div>
                }
                @if (!_hasSample || _reRecording)
                {
                <p class="small text-muted mb-3">
                    One sample for the narrator. Library pictures stay as-is.
                    Read the script aloud, then tap Done — we save and apply automatically.
                </p>

                <div class="border rounded p-3 bg-dark bg-opacity-25 mb-3"
                     data-testid="simple-voice-script">
                    <div class="small text-info fw-semibold mb-1">Read this aloud</div>
                    <p class="mb-0 small" style="white-space: pre-wrap;">@VoiceCloneScripts.KidsShort</p>
                    <button type="button" class="btn btn-link btn-sm px-0 mt-1"
                            @onclick="() => _showFullScript = !_showFullScript">
                        @(_showFullScript ? "Hide longer script" : "Longer script (optional)")
                    </button>
                    @if (_showFullScript)
                    {
                        <p class="mb-0 small text-muted mt-1" style="white-space: pre-wrap;">@VoiceCloneScripts.KidsFull</p>
                    }
                </div>

                @* Mutually exclusive: Record OR Upload — never both, so “upload my recording” isn’t confusing. *@
                @if (_captureMode == CaptureMode.Choose)
                {
                    <p class="small text-muted mb-2">How do you want to add your sample?</p>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2" data-testid="simple-voice-capture-choose">
                        <button type="button" class="btn btn-primary"
                                disabled="@(_busy || string.IsNullOrEmpty(_projectId))"
                                data-testid="simple-voice-choose-record"
                                @onclick="ChooseRecordAsync">
                            Record with mic
                        </button>
                        <label class="btn btn-outline-primary mb-0 @(_busy || string.IsNullOrEmpty(_projectId) ? "disabled" : "")"
                               data-testid="simple-voice-choose-upload">
                            Upload audio file
                            <InputFile OnChange="OnUploadChosenAsync" accept="audio/*,.mp3,.wav,.m4a,.webm,.ogg"
                                       class="d-none" disabled="@(_busy || string.IsNullOrEmpty(_projectId))" />
                        </label>
                        @if (_hasSample)
                        {
                            <span class="badge text-bg-success" data-testid="simple-voice-sample-ready">Sample ready</span>
                        }
                    </div>
                }
                else if (_captureMode == CaptureMode.Record)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2" data-testid="simple-voice-capture-record">
                        @if (!_recording)
                        {
                            <button type="button" class="btn btn-primary"
                                    disabled="@(_busy || string.IsNullOrEmpty(_projectId))"
                                    data-testid="simple-voice-mic-start"
                                    @onclick="StartMicAsync">
                                Record
                            </button>
                            <button type="button" class="btn btn-link btn-sm"
                                    disabled="@_busy"
                                    data-testid="simple-voice-switch-upload"
                                    @onclick="BackToChoose">
                                Use a file instead
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger"
                                    disabled="@_busy"
                                    data-testid="simple-voice-mic-stop"
                                    @onclick="StopMicAsync">
                                Done
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    disabled="@_busy"
                                    @onclick="CancelMicAsync">
                                Cancel
                            </button>
                            <span class="small text-danger">Recording…</span>
                        }
                        @if (_hasSample && !_recording)
                        {
                            <span class="badge text-bg-success" data-testid="simple-voice-sample-ready">Sample ready</span>
                        }
                    </div>
                    @* Upload hidden while recording path is active *@
                }
                else @* Upload *@
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2" data-testid="simple-voice-capture-upload">
                        <label class="btn btn-primary mb-0 @(_busy || string.IsNullOrEmpty(_projectId) ? "disabled" : "")"
                               data-testid="simple-voice-upload">
                            Choose audio file…
                            <InputFile OnChange="OnUploadAsync" accept="audio/*,.mp3,.wav,.m4a,.webm,.ogg"
                                       class="d-none" disabled="@(_busy || string.IsNullOrEmpty(_projectId))" />
                        </label>
                        <button type="button" class="btn btn-link btn-sm"
                                disabled="@_busy"
                                data-testid="simple-voice-switch-record"
                                @onclick="BackToChoose">
                            Record with mic instead
                        </button>
                        @if (_hasSample)
                        {
                            <span class="badge text-bg-success" data-testid="simple-voice-sample-ready">Sample ready</span>
                        }
                    </div>
                    @* Record hidden while upload path is active *@
                }
                } @* end: show record UI only when no sample yet or re-recording *@

                @if (!string.IsNullOrEmpty(_hint))
                {
                    <div class="form-text" data-testid="simple-voice-hint">@_hint</div>
                }
                @if (_hasSample && !_applied && !_busy)
                {
                    <div class="alert alert-warning py-2 small mt-2 mb-0" data-testid="simple-voice-apply-fix">
                        @if (!string.IsNullOrEmpty(_hint) && _hint.Contains("Sample", StringComparison.OrdinalIgnoreCase))
                        {
                            <span>@_hint</span>
                        }
                        else
                        {
                            <span>Sample is saved. @(string.IsNullOrEmpty(_hint) ? "Voice apply did not finish." : _hint)</span>
                        }
                        <span class="d-block mt-1">
                            <a href="configuration?focus=voice#api-keys" class="alert-link">Open Settings → Voice clone &amp; speech</a>
                            · then
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="RetryApplyAsync">try apply again</button>
                        </span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_samplePlayUrl) && (!_hasSample || _reRecording))
                {
                    <audio class="mt-2 w-100" controls src="@_samplePlayUrl" @key="_samplePlayUrl"></audio>
                }

                @if (_hasSample && _applied)
                {
                    <hr class="my-3" />
                    <div class="d-flex flex-wrap align-items-center gap-2" data-testid="simple-voice-finish">
                        <div class="flex-grow-1">
                            <div class="fw-semibold">You’re set</div>
                            <div class="small text-muted">
                                We keep the pictures and put your voice on every line — no video regen.
                            </div>
                        </div>
                        <button type="button"
                                class="btn btn-primary btn-lg"
                                data-testid="simple-voice-make-movie"
                                disabled="@_busy"
                                @onclick="MakeMovieAsync">
                            Make my movie →
                        </button>
                    </div>
                }
            </div>
        </div>

        <p class="small text-muted mb-0">
            Want faces of family in the frame later?
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="SwitchToFullStudioAsync">
                Switch to full studio
            </button>
        </p>
    }

    @* ── Step 3: your movie ───────────────────────────────────────────── *@
    else if (_phase == Phase.Movie)
    {
        <div class="card border-primary border-opacity-50 mb-3" data-testid="simple-voice-movie">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge text-bg-primary me-2">Step 3</span>
                    <span class="fw-semibold">Your movie</span>
                    @if (!string.IsNullOrEmpty(_projectLabel))
                    {
                        <span class="text-muted small ms-2">· @_projectLabel</span>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        disabled="@_dubbing"
                        data-testid="simple-voice-movie-back"
                        @onclick="@(() => { _phase = Phase.Done; _dubbedUrl = null; _error = null; })">
                    ← Back to my voice
                </button>
            </div>
            <div class="card-body">
                @if (_dubbedUrl is not null)
                {
                    <div data-testid="simple-voice-result">
                        <div class="fw-semibold mb-1">Your movie, in your voice 🎉</div>
                        @if (!string.IsNullOrEmpty(_dubSummary))
                        {
                            <div class="small text-muted mb-2" data-testid="simple-voice-dub-summary">@_dubSummary</div>
                        }
                        <video class="w-100 rounded" style="max-height: 60vh; background:#000;"
                               src="@_dubbedUrl" controls autoplay playsinline
                               data-testid="simple-voice-player"></video>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-primary"
                                    data-testid="simple-voice-download"
                                    @onclick="DownloadDubbedAsync">
                                Download
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    disabled="@_dubbing"
                                    data-testid="simple-voice-remake"
                                    @onclick="MakeMovieAsync">
                                Make again
                            </button>
                        </div>
                    </div>
                }
                else if (_dubbing)
                {
                    <div data-testid="simple-voice-progress">
                        <div class="fw-semibold mb-2">Making your movie…</div>
                        <div class="progress" role="progressbar" aria-label="Making your movie">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 style="width: 100%"></div>
                        </div>
                        <div class="small text-muted mt-1">@(_dubStatus ?? "Working…")</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger py-2 small mb-2" data-testid="simple-voice-movie-error">
                        @(_error ?? "Something went wrong making your movie.")
                    </div>
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="MakeMovieAsync">
                        Try again
                    </button>
                }
            </div>
        </div>
    }
}

@code {
    private enum Phase { Pick, Record, Done, Movie }

    /// <summary>Step-2 capture path: pick one so Record and Upload are never shown together.</summary>
    private enum CaptureMode { Choose, Record, Upload }

    private Phase _phase = Phase.Pick;
    private List<ForkableStoryDto> _forkableStories = new();
    private bool _storiesLoading = true;
    private bool _reRecording;
    private bool _dubbing;
    private string? _dubStatus;
    private string? _dubbedUrl;
    private string? _dubSummary;
    private string? _projectId;
    private string? _projectLabel;
    private string _narratorKey = "Character_Narrator";
    private bool _busy;
    private CaptureMode _captureMode = CaptureMode.Choose;
    private bool _recording;
    private bool _hasSample;
    private bool _applied;
    private bool _showFullScript;
    private string? _error;
    private string? _message;
    private string? _hint;
    private string? _samplePlayUrl;
    private long _sampleBust;

    protected override async Task OnInitializedAsync()
    {
        _storiesLoading = true;
        try { _forkableStories = await Engine.ListForkableProjectsAsync(); }
        catch { /* empty list shown */ }
        finally { _storiesLoading = false; }

        // Resume mid-flow if active project is already on simple path.
        if (Session.IsLoggedIn
            && ActiveProject.IsSimpleVoice
            && !string.IsNullOrEmpty(ActiveProject.ProjectId))
        {
            _projectId = ActiveProject.ProjectId;
            _projectLabel = ActiveProject.Label;
            _phase = Phase.Record;
            _captureMode = CaptureMode.Choose;
            await EnsureVoiceModelAsync();
            await ResolveNarratorKeyAsync();
            await RefreshSampleStateAsync();
        }
    }

    private async Task SelectStoryAsync(ForkableStoryDto story)
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("login?returnUrl=/simple-voice");
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            // Make the user's own copy of the film (fork), then set up the voice step on it.
            var fork = await Engine.ForkProjectAsync(story.Id);
            var forkId = fork?.Id;
            if (string.IsNullOrEmpty(forkId))
                throw new InvalidOperationException("Could not open that story.");

            try { await Engine.SetStudioPathAsync(forkId, ProjectStudioPaths.SimpleVoice); }
            catch { /* older API */ }
            await Engine.ActivateProjectAsync(forkId);
            ActiveProject.Set(forkId, fork?.Title ?? story.Title, studioPath: ProjectStudioPaths.SimpleVoice);
            await ActiveProject.RefreshReadinessAsync(Engine);

            _projectId = forkId;
            _projectLabel = fork?.Title ?? story.Title;
            _reRecording = false;
            _dubbedUrl = null;
            _phase = Phase.Record;
            await EnsureVoiceModelAsync();
            await ResolveNarratorKeyAsync();
            await RefreshSampleStateAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartReRecord()
    {
        _reRecording = true;
        _captureMode = CaptureMode.Choose;
        _hint = null;
        _error = null;
    }

    private void BackToPick()
    {
        _phase = Phase.Pick;
        _captureMode = CaptureMode.Choose;
        _recording = false;
        _error = null;
        _message = null;
        _hint = null;
    }

    private async Task ResolveNarratorKeyAsync()
    {
        _narratorKey = "Character_Narrator";
        if (string.IsNullOrEmpty(_projectId)) return;
        try
        {
            var dto = await Engine.GetCharactersAsync(_projectId);
            var list = dto?.Characters;
            if (list is { Count: > 0 })
            {
                var pick = list.FirstOrDefault(c =>
                               (c.Key?.Contains("narrator", StringComparison.OrdinalIgnoreCase) ?? false)
                               || (c.DisplayName?.Contains("narrator", StringComparison.OrdinalIgnoreCase) ?? false))
                           ?? list.FirstOrDefault(c => c.VoiceOnly)
                           ?? list[0];
                if (!string.IsNullOrEmpty(pick?.Key))
                    _narratorKey = pick.Key;
            }
        }
        catch
        {
            // Seed will be created on upload if cast not built yet.
        }
    }

    private async Task EnsureVoiceModelAsync()
    {
        if (string.IsNullOrEmpty(_projectId)) return;
        try
        {
            var cfgDto = await Engine.GetConfigAsync(_projectId);
            var map = cfgDto?.Config;
            string voice = "none";
            if (map is not null && map.TryGetValue("voice_model_name", out var el)
                && el.ValueKind == System.Text.Json.JsonValueKind.String)
                voice = el.GetString() ?? "none";
            if (!string.IsNullOrWhiteSpace(voice)
                && !voice.Equals("none", StringComparison.OrdinalIgnoreCase)
                && !voice.Equals("disabled", StringComparison.OrdinalIgnoreCase))
                return;
            var defaultClone = SupportedModelCatalog.FirstEnabledVoiceCloneModelId();
            if (string.IsNullOrWhiteSpace(defaultClone))
                return;
            await Engine.SaveConfigAsync(_projectId, new Dictionary<string, object?>
            {
                ["voice_model_name"] = defaultClone,
            });
        }
        catch { /* non-fatal */ }
    }

    private async Task RefreshSampleStateAsync()
    {
        _hasSample = false;
        _samplePlayUrl = null;
        if (string.IsNullOrEmpty(_projectId)) return;
        try
        {
            var dto = await Engine.GetCharactersAsync(_projectId);
            var c = dto?.Characters?.FirstOrDefault(x =>
                string.Equals(x.Key, _narratorKey, StringComparison.OrdinalIgnoreCase));
            _hasSample = c?.HasVoiceCloneSample == true
                || !string.IsNullOrEmpty(c?.VoiceProviderVoiceId);
            if (c?.HasVoiceCloneSample == true)
            {
                _sampleBust = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                _samplePlayUrl = Engine.CharacterVoiceCloneSampleUrl(_projectId, _narratorKey, _sampleBust);
            }
            if (_hasSample && !string.IsNullOrEmpty(c?.VoiceProviderVoiceId))
            {
                _applied = true;
                _phase = Phase.Done;
            }
        }
        catch { /* ignore */ }
    }

        private async Task ChooseRecordAsync()
    {
        _captureMode = CaptureMode.Record;
        _error = null;
        await StartMicAsync();
    }

    private void BackToChoose()
    {
        if (_recording || _busy) return;
        _captureMode = CaptureMode.Choose;
        _hint = null;
    }

    private async Task OnUploadChosenAsync(InputFileChangeEventArgs e)
    {
        _captureMode = CaptureMode.Upload;
        await OnUploadAsync(e);
    }

private async Task StartMicAsync()
    {
        _error = null;
        _hint = null;
        try
        {
            if (!MediaFolder.IsConnected)
                await MediaFolder.TryReconnectAsync();
            var result = await Js.InvokeAsync<VoiceCaptureStartResult>("PageToMovieVoiceCapture.start");
            if (result is null || !result.Ok)
            {
                _error = string.IsNullOrWhiteSpace(result?.Error)
                    ? "Could not access the microphone. Check browser permissions."
                    : result!.Error;
                return;
            }
            _recording = true;
            _hint = "Recording — read the script, then tap Done.";
        }
        catch (JSException jex)
        {
            _error = "Microphone failed: " + jex.Message;
            _recording = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _recording = false;
        }
    }

    private async Task StopMicAsync()
    {
        if (string.IsNullOrEmpty(_projectId)) return;
        _busy = true;
        _error = null;
        _hint = "Saving…";
        try
        {
            var result = await Js.InvokeAsync<VoiceCaptureStopResult>("PageToMovieVoiceCapture.stop");
            _recording = false;
            if (result is null || !result.Ok || string.IsNullOrEmpty(result.Base64))
            {
                _error = result?.Error ?? "No audio captured";
                return;
            }
            var raw = Convert.FromBase64String(result.Base64);
            var name = string.IsNullOrWhiteSpace(result.FileName) ? "voice_clone_sample.webm" : result.FileName!;
            await PersistAndApplyAsync(raw, name);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _recording = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelMicAsync()
    {
        try { await Js.InvokeVoidAsync("PageToMovieVoiceCapture.cancel"); } catch { }
        _recording = false;
        _hint = "Recording cancelled.";
    }

    private async Task OnUploadAsync(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(_projectId) || e.File is null) return;
        _busy = true;
        _error = null;
        _hint = "Saving…";
        try
        {
            const long max = 15 * 1024 * 1024;
            await using var stream = e.File.OpenReadStream(max);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            await PersistAndApplyAsync(ms.ToArray(), e.File.Name);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PersistAndApplyAsync(byte[] bytes, string fileName)
    {
        if (string.IsNullOrEmpty(_projectId)) return;
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        if (ext is not (".webm" or ".mp3" or ".wav" or ".m4a" or ".ogg" or ".aac" or ".mp4"))
            ext = ".webm";
        if (ext == ".mp4") ext = ".webm";

        var safeKey = string.Join("_", _narratorKey.Split(Path.GetInvalidFileNameChars()));
        var rel = $"assets/characters/{safeKey}/voice_clone_sample{ext}";
        if (!MediaFolder.IsConnected)
            await MediaFolder.TryReconnectAsync();
        await MediaFolder.SaveBytesAsync(_projectId, rel, bytes, promptToConnectFolder: false);

        await using var ms = new MemoryStream(bytes);
        await Engine.UploadVoiceCloneSampleAsync(_projectId, _narratorKey, ms, "voice_clone_sample" + ext);
        _hasSample = true;
        _sampleBust = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _samplePlayUrl = Engine.CharacterVoiceCloneSampleUrl(_projectId, _narratorKey, _sampleBust);
        _hint = "Sample saved — applying voice…";
        StateHasChanged();

        // Auto-apply so user doesn't need a second button or the cast page.
        try
        {
            var apply = await Engine.ApplyVoiceCloneAsync(_projectId, _narratorKey);
            if (!apply.Ok)
            {
                _applied = false;
                _hint = "Sample saved. " + FriendlyApplyError(apply.Error ?? apply.Message);
                _message = null;
                return;
            }
            _applied = true;
            _phase = Phase.Done;
            _error = null;
            _hint = apply.UsedMock
                ? "Demo voice applied. You can make the movie."
                : "Voice applied. You can make the movie.";
            _message = null;
        }
        catch (Exception ex)
        {
            _hint = "Sample saved. " + FriendlyApplyError(ex.Message);
            _applied = false;
            _message = null;
        }
    }

    private async Task RetryApplyAsync()
    {
        if (string.IsNullOrEmpty(_projectId) || !_hasSample) return;
        _busy = true;
        _error = null;
        _hint = "Applying voice…";
        try
        {
            var apply = await Engine.ApplyVoiceCloneAsync(_projectId, _narratorKey);
            if (!apply.Ok)
            {
                _hint = FriendlyApplyError(apply.Error);
                _applied = false;
                return;
            }
            _applied = true;
            _phase = Phase.Done;
            _message = null;
            _hint = apply.UsedMock
                ? "Demo voice applied. You can make the movie."
                : "Voice applied. You can make the movie.";
        }
        catch (Exception ex)
        {
            _hint = FriendlyApplyError(ex.Message);
            _applied = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MakeMovieAsync()
    {
        if (string.IsNullOrEmpty(_projectId)) return;
        // Clips + synthesized audio live in the browser media folder — it must be connected.
        if (!MediaFolder.IsConnected)
        {
            var connected = await MediaFolder.ConnectFolderAsync();
            if (!connected && !MediaFolder.IsConnected)
            {
                _error = "Connect your media folder so we can build your movie.";
                return;
            }
        }
        _phase = Phase.Movie; // step 3
        _dubbing = true;
        _busy = true;
        _error = null;
        _message = null;
        _dubbedUrl = null;
        _dubStatus = "Starting…";
        try
        {
            var res = await VoiceSub.DubMovieInMyVoiceAsync(
                _projectId,
                charKey: _narratorKey,
                onProgress: s => { _dubStatus = s; _ = InvokeAsync(StateHasChanged); });
            _dubSummary = $"{res.ClipsDubbed} scene(s) in your voice"
                          + (res.ClipsFailed > 0 ? $" · {res.ClipsFailed} skipped" : "");
            if (res.Ok && !string.IsNullOrWhiteSpace(res.DownloadUrl))
                _dubbedUrl = res.DownloadUrl;
            else
                _error = res.Error ?? "Could not make your movie.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _dubbing = false;
            _busy = false;
            _dubStatus = null;
        }
    }

    private async Task DownloadDubbedAsync()
    {
        if (string.IsNullOrWhiteSpace(_dubbedUrl)) return;
        var name = string.IsNullOrWhiteSpace(_projectLabel) ? "movie" : _projectLabel;
        await VoiceSub.DownloadAsync(_dubbedUrl, $"{name}-in-my-voice.mp4");
    }

    private async Task SwitchToFullStudioAsync()
    {
        if (!string.IsNullOrEmpty(_projectId))
        {
            try
            {
                await Engine.SetStudioPathAsync(_projectId, ProjectStudioPaths.Full);
                ActiveProject.SetStudioPathLocal(ProjectStudioPaths.Full);
            }
            catch { /* ignore */ }
        }
        Nav.NavigateTo("characters");
    }

    public async ValueTask DisposeAsync()
    {
        if (_recording)
        {
            try { await Js.InvokeVoidAsync("PageToMovieVoiceCapture.cancel"); } catch { }
        }
    }

    private static string FriendlyApplyError(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "Apply failed.";
        if (raw.Contains("create_instant_voice_clone", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("Instant Voice Clone", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("missing_permissions", StringComparison.OrdinalIgnoreCase))
        {
            return "This ElevenLabs key cannot create Instant Voice Clones. "
                   + "Enable that permission on the key, upgrade the plan, or switch Voice to Fal MiniMax in Settings. "
                   + "Your recording is still saved.";
        }
        return raw;
    }

    private sealed class VoiceCaptureStartResult
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
    }

    private sealed class VoiceCaptureStopResult
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
        public string? Base64 { get; set; }
        public string? FileName { get; set; }
    }
