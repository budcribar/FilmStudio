@page "/admin"
@implements IAsyncDisposable
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject JobHubClient Hub
@inject NavigationManager Nav
@inject ClientMediaFolderService MediaFolder
@inject IJSRuntime Js
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Admin — PageToMovie</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h3 mb-0">Admin dashboard</h1>
            <div class="text-muted small">
                Live ops · SignalR <code>admin:ops</code>
                @if (_hubLive)
                {
                    <span class="badge text-bg-success ms-1">live</span>
                }
                else
                {
                    <span class="badge text-bg-secondary ms-1">poll 5s</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            @if (Session.IsAuthenticated)
            {
                <span class="badge text-bg-secondary">@Session.UserId</span>
                <button class="btn btn-sm btn-outline-info" @onclick="ExportLogsAsync" disabled="@(_archiveBusy && _archiveAction == "export_logs")" title="Download zip archive of all server logs, prompts, edit history, and system state">
                    @(_archiveBusy && _archiveAction == "export_logs" ? "Exporting logs…" : "📥 Download Server Logs")
                </button>
                <a href="/admin/models-catalog" class="btn btn-sm btn-outline-primary" title="Manage model catalog entries and enablement toggles">🤖 Models Catalog</a>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="LogoutAsync">Log out</button>
            }
        </div>
    </div>

    @if (!_started)
    {
        <p class="text-muted">Loading admin session…</p>
    }
    else if (!Session.IsAdmin)
    {
        <div class="alert alert-warning">
            Admin session required. <a href="/admin/login">Sign in</a>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Retry</button>
    }
    else if (_state is null)
    {
        <p class="text-muted">Loading server state…</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_actionMsg))
        {
            <div class="alert alert-info py-2">@_actionMsg</div>
        }

        @if (_state.Http is { } http)
        {
            <div class="alert @(http.NonAdminLast5Sec > 5 ? "alert-success" : "alert-warning") py-2 small">
                <strong>HTTP traffic</strong>
                · last 5s: <strong>@http.RequestsLast5Sec</strong> total
                · <strong>@http.NonAdminLast5Sec</strong> non-admin
                · last 30s non-admin: <strong>@http.NonAdminLast30Sec</strong>
                @if (http.NonAdminLast5Sec <= 2)
                {
                    <span class="ms-1">
                        — LoadSim does not appear to be hitting this API (only admin poll).
                        Check LoadSim console: “running…”, baseUrl <code>http://127.0.0.1:5088</code>, project <code>LoadSimBuster</code>.
                    </span>
                }
                @if (http.ByPrefixLast5Sec is { Count: > 0 } pref)
                {
                    <div class="mt-1 font-monospace" style="font-size:0.75rem;">
                        @foreach (var kv in pref.OrderByDescending(k => k.Value).Take(8))
                        {
                            <span class="me-2">@kv.Key=@(kv.Value)</span>
                        }
                    </div>
                }
            </div>
        }

        @* ── Action & Camera Timing Telemetry Panel ───────────────────── *@
        <div class="card mb-3 border-0 shadow-sm" style="background: #0f172a; color: #e2e8f0;">
            <div class="card-header border-bottom border-dark d-flex flex-wrap justify-content-between align-items-center gap-2"
                 style="background: rgba(255,255,255,0.03);">
                <div>
                    <strong class="text-info">⏱️ Action & Camera Timing Telemetry</strong>
                    <span class="badge bg-success ms-2">SQLite Active</span>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge bg-dark border border-secondary text-info">Hit Rate: @(_timingTelemetry?.Stats?.HitRatePercent.ToString("F1") ?? "0.0")% (@(_timingTelemetry?.Stats?.TotalHits ?? 0)/@((_timingTelemetry?.Stats?.TotalHits ?? 0) + (_timingTelemetry?.Stats?.TotalMisses ?? 0)))</span>
                    <span class="badge bg-dark border border-secondary text-success">MAE: @(_timingTelemetry?.Stats?.MeanAbsoluteErrorSec.ToString("F2") ?? "0.00")s Error</span>
                    <button class="btn btn-sm btn-outline-success border border-success ms-2" @onclick="SeedTimingDatabaseAsync" disabled="@_seedingTiming">
                        🌱 Seed Database with Benchmarks
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (_seedingTiming)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-success fw-bold">🌱 Seeding Database with Ground-Truth Benchmark Categories...</span>
                            <span class="text-success">Executing</span>
                        </div>
                        <div class="progress" style="height: 8px; background: rgba(255,255,255,0.05);">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 100%;"></div>
                        </div>
                    </div>
                }

                <div class="row align-items-center">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="p-3 rounded" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                            <div class="text-muted small mb-1">DATABASE CACHE HIT RATE</div>
                            <div class="h2 text-success mb-1">@(_timingTelemetry?.Stats?.HitRatePercent.ToString("F1") ?? "0.0")%</div>
                            <div class="progress mb-2" style="height: 6px; background: rgba(255,255,255,0.08);">
                                <div class="progress-bar bg-success" style="width: @(Math.Clamp(_timingTelemetry?.Stats?.HitRatePercent ?? 0.0, 0.0, 100.0))%;"></div>
                            </div>
                            <div class="small text-muted">@(_timingTelemetry?.Stats?.TotalHits ?? 0) Cache Hits · @(_timingTelemetry?.Stats?.TotalMisses ?? 0) Misses (JIT/AI Fallback)</div>
                        </div>
                        <div class="p-3 rounded mt-2" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                            <div class="text-muted small mb-1">ESTIMATE vs ACTUAL ACCURACY</div>
                            <div class="h2 text-info mb-1">@(_timingTelemetry?.Stats?.MeanAbsoluteErrorSec.ToString("F2") ?? "0.00")s</div>
                            <div class="progress mb-2" style="height: 6px; background: rgba(255,255,255,0.08);">
                                <div class="progress-bar bg-info" style="width: 85%;"></div>
                            </div>
                            <div class="small text-muted">Mean Absolute Error (measured across scene cuts)</div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="text-muted small mb-2 d-flex justify-content-between">
                            <span>CACHE HIT RATE & ERROR TREND OVER TIME</span>
                            <span>Legend: <span class="text-success">■ Hit Rate (%)</span> · <span class="text-info">■ MAE (x10 sec)</span></span>
                        </div>
                        <svg viewBox="0 0 500 120" style="width:100%; height:120px; background: rgba(0,0,0,0.3); border-radius:6px; padding:10px;">
                            <!-- Grid lines -->
                            <line x1="40" y1="20" x2="480" y2="20" stroke="#334155" stroke-dasharray="2,2"/>
                            <line x1="40" y1="60" x2="480" y2="60" stroke="#334155" stroke-dasharray="2,2"/>
                            <line x1="40" y1="100" x2="480" y2="100" stroke="#334155"/>
                            
                            @if (_timingTelemetry?.Trend is { Count: > 0 } trendList)
                            {
                                var count = trendList.Count;
                                var stepX = count > 1 ? (440.0 - 50.0) / (count - 1) : 0;

                                <!-- Dynamic Green Line: Cache Hit Rate % -->
                                <polyline fill="none" stroke="#22c55e" stroke-width="3" points="@GetHitRatePolylinePoints()" />
                                @for (int i = 0; i < count; i++)
                                {
                                    var idx = i;
                                    var x = 50.0 + (idx * stepX);
                                    var hitRate = Math.Clamp(trendList[idx].HitRatePercent, 0.0, 100.0);
                                    var y = 100.0 - (hitRate / 100.0 * 80.0);
                                    <circle cx="@x.ToString("F1")" cy="@y.ToString("F1")" r="4" fill="#22c55e">
                                        <title>Hit Rate: @trendList[idx].HitRatePercent.ToString("F1")% (@trendList[idx].Timestamp)</title>
                                    </circle>
                                }

                                <!-- Dynamic Blue Line: MAE Error in sec -->
                                <polyline fill="none" stroke="#38bdf8" stroke-width="3" points="@GetMaePolylinePoints()" />
                                @for (int i = 0; i < count; i++)
                                {
                                    var idx = i;
                                    var x = 50.0 + (idx * stepX);
                                    var mae = Math.Clamp(trendList[idx].MeanAbsoluteErrorSec, 0.0, 2.0);
                                    var y = 100.0 - (mae / 2.0 * 80.0);
                                    <circle cx="@x.ToString("F1")" cy="@y.ToString("F1")" r="4" fill="#38bdf8">
                                        <title>MAE: @trendList[idx].MeanAbsoluteErrorSec.ToString("F2")s (@trendList[idx].Timestamp)</title>
                                    </circle>
                                }

                                <!-- Dynamic X Axis Labels -->
                                @for (int i = 0; i < count; i++)
                                {
                                    var idx = i;
                                    if (idx == 0 || idx == count - 1 || (count > 4 && idx == count / 2))
                                    {
                                        var x = 50.0 + (idx * stepX);
                                        var label = FormatTrendTimestamp(trendList[idx].Timestamp);
                                        @((MarkupString)$"<text x=\"{x:F1}\" y=\"115\" fill=\"#94a3b8\" font-size=\"10\" text-anchor=\"middle\">{label}</text>")
                                    }
                                }
                            }
                            else
                            {
                                @((MarkupString)"<text x=\"240\" y=\"65\" fill=\"#94a3b8\" font-size=\"11\" text-anchor=\"middle\">No telemetry trend snapshots recorded yet</text>")
                            }
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        @* ── LoadSim live panel ─────────────────────────────────────────── *@
        <div class="card mb-3 border-0 shadow-sm loadsim-panel">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2"
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%); color: #e2e8f0;">
                <div>
                    <strong>LoadSim</strong>
                    @if (_loadSim?.Active == true)
                    {
                        <span class="badge bg-success ms-2">LIVE</span>
                    }
                    else if (_loadSim?.Latest is not null)
                    {
                        <span class="badge bg-secondary ms-2">@(_loadSim.Latest.Status ?? "idle")</span>
                    }
                    else
                    {
                        <span class="badge bg-dark ms-2">idle</span>
                    }
                </div>
                @if (_loadSim?.Latest is { } ls)
                {
                    <div class="small" style="opacity:0.9;">
                        run <code class="text-info">@ls.RunId</code>
                        · @ls.Users VU · @ls.Scenario · @ls.ProjectId
                        · @ls.ElapsedSec.ToString("0")s / @ls.DurationSec s
                        @if (ls.Passed == true) { <span class="badge bg-success ms-1">PASS</span> }
                        else if (ls.Passed == false) { <span class="badge bg-danger ms-1">FAIL</span> }
                    </div>
                }
            </div>
            <div class="card-body" style="background:#0b1220; color:#cbd5e1;">
                @if (_loadSim?.Latest is null)
                {
                    <p class="small mb-0" style="opacity:0.7;">
                        No LoadSim telemetry yet. Start LoadSim — it posts every 2s to
                        <code class="text-info">POST /api/loadsim/progress</code>.
                    </p>
                }
                else
                {
                    var L = _loadSim.Latest;
                    <div class="row g-2 mb-3 text-center">
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val">@L.ActionsTotal.ToString("N0")</div>
                                <div class="loadsim-kpi__lbl">actions</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val">@L.ActionsPerSec.ToString("0.0")</div>
                                <div class="loadsim-kpi__lbl">actions/s</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val @(L.ErrorRate > 0.01 ? "text-warning" : "text-success")">
                                    @((L.ErrorRate * 100).ToString("0.00"))%
                                </div>
                                <div class="loadsim-kpi__lbl">error rate</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val">@L.BrowseP95Ms<span class="fs-6">ms</span></div>
                                <div class="loadsim-kpi__lbl">browse p95</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val">@L.P50Ms<span class="fs-6">ms</span></div>
                                <div class="loadsim-kpi__lbl">p50 latency</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val">@L.JobsSubmitted</div>
                                <div class="loadsim-kpi__lbl">jobs ok</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val">@L.JobsRejected</div>
                                <div class="loadsim-kpi__lbl">409 rejects</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="loadsim-kpi">
                                <div class="loadsim-kpi__val @(L.Jobs5xx > 0 ? "text-danger" : "")">@L.Jobs5xx</div>
                                <div class="loadsim-kpi__lbl">5xx</div>
                            </div>
                        </div>
                    </div>
                    @if (_chartWarning is { Length: > 0 } cw)
                    {
                        <div class="alert alert-warning py-1 small mb-2">
                            Charts failed to update: @cw
                            <button type="button" class="btn btn-sm btn-link p-0 ms-1 align-baseline" @onclick="UpdateChartsAsync">Retry</button>
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="loadsim-chart-wrap">
                                <div class="loadsim-chart-title">Throughput</div>
                                <canvas id="chartLoadSimThroughput"></canvas>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="loadsim-chart-wrap">
                                <div class="loadsim-chart-title">Latency &amp; errors</div>
                                <canvas id="chartLoadSimLatency"></canvas>
                            </div>
                        </div>
                    </div>
                    @if (L.ActionLatency is { Count: > 0 } al)
                    {
                        <div class="mt-3">
                            <div class="loadsim-chart-title mb-1">Per-action latency (p95 desc)</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-dark loadsim-action-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>action</th>
                                            <th class="text-end">count</th>
                                            <th class="text-end">p50</th>
                                            <th class="text-end">p95</th>
                                            <th class="text-end">p99</th>
                                            <th class="text-end">errs</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in al)
                                        {
                                            <tr class="@(a.P95Ms >= 1000 ? "table-warning" : null)">
                                                <td class="font-monospace">@a.Action</td>
                                                <td class="text-end font-monospace">@a.Count.ToString("N0")</td>
                                                <td class="text-end font-monospace">@a.P50Ms<span class="text-secondary">ms</span></td>
                                                <td class="text-end font-monospace fw-semibold">@a.P95Ms<span class="text-secondary">ms</span></td>
                                                <td class="text-end font-monospace">@a.P99Ms<span class="text-secondary">ms</span></td>
                                                <td class="text-end font-monospace @(a.Errors > 0 ? "text-warning" : "")">@a.Errors</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="small mt-1" style="opacity:0.65;">
                                Combined browse p95 uses health+projects+scenes+scene_detail+browse samples.
                                Work the hottest row first.
                            </div>
                        </div>
                    }
                    else if (L.ActionsByType is { Count: > 0 } acts)
                    {
                        <div class="mt-2 small font-monospace" style="opacity:0.8;">
                            @foreach (var kv in acts.OrderByDescending(a => a.Value).Take(10))
                            {
                                <span class="me-2">@kv.Key=@(kv.Value)</span>
                            }
                        </div>
                    }
                }

                <div class="row g-3 mt-1">
                    <div class="col-12">
                        <div class="loadsim-chart-wrap loadsim-chart-wrap--tall">
                            <div class="loadsim-chart-title">
                                Process memory
                                @if (_state.Process is { } proc)
                                {
                                    <span class="ms-2" style="font-weight:400; opacity:0.85;">
                                        WS <strong>@proc.WorkingSetMb</strong> MB · GC <strong>@proc.GcHeapMb</strong> MB · threads @proc.ThreadCount
                                    </span>
                                }
                            </div>
                            <canvas id="chartProcessMemory"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-header">Process</div>
                    <div class="card-body small">
                        <div>Uptime: <strong>@FormatUptime(_state.Process?.UptimeSec ?? 0)</strong></div>
                        <div>Working set: <strong>@(_state.Process?.WorkingSetMb ?? 0) MB</strong></div>
                        <div>GC heap: <strong>@(_state.Process?.GcHeapMb ?? 0) MB</strong></div>
                        <div>Threads: <strong>@(_state.Process?.ThreadCount ?? 0)</strong></div>
                        <div>Env: <strong>@(_state.Process?.Environment ?? "?")</strong></div>
                        <div>Fakes: <strong>@((_state.Process?.UseFakes ?? false) ? "ON" : "off")</strong></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-header">Capacity</div>
                    <div class="card-body small">
                        @if (_state.Capacity is { } c)
                        {
                            <div>MaxVideoInFlight: <strong>@c.MaxVideoInFlight</strong></div>
                            <div>MaxVideoInFlightPerUser: <strong>@c.MaxVideoInFlightPerUser</strong></div>
                            <div>MaxQueuePerUser: <strong>@c.MaxQueuePerUser</strong></div>
                        }
                        <div class="mt-2">
                            API in-flight: <strong>@_apiInFlight</strong>
                        </div>
                        <div>Rejects: <strong>@_capacityRejects</strong> · Lock conflicts: <strong>@_lockConflicts</strong></div>
                        <a class="btn btn-sm btn-link px-0" href="/admin/config">Edit capacity…</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-header">Projects</div>
                    <div class="card-body small">
                        <div>Active: <strong>@(_state.Projects?.Active ?? "—")</strong></div>
                        <div class="text-truncate" title="@_state.Projects?.Workspace">
                            Workspace: <code class="small">@(_state.Projects?.Workspace ?? "—")</code>
                        </div>
                        <div class="mt-2 text-muted">
                            Snapshot @(_state.GeneratedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-header">Disk Space & Storage</div>
                    <div class="card-body small">
                        <div class="text-truncate" title="@(_state.Disk?.VolumePath ?? "/data")">
                            Volume: <code class="small">@(_state.Disk?.VolumePath ?? "/data")</code>
                        </div>
                        <div>Total size: <strong>@(_state.Disk?.FormattedTotal ?? "—")</strong></div>
                        <div>Used: <strong>@(_state.Disk?.FormattedUsed ?? "—")</strong> (@(_state.Disk?.UsedPercent ?? 0)%)</div>
                        <div>Free left: <strong class="text-success">@(_state.Disk?.FormattedFree ?? "—")</strong></div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar @GetDiskProgressBarClass(_state.Disk?.UsedPercent ?? 0)"
                                 role="progressbar"
                                 style="width: @(Math.Min(100, Math.Max(0, _state.Disk?.UsedPercent ?? 0)))%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (_state.DiskHistory is { Count: > 0 })
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Daily Storage Usage History (Railway Volume <code>@(_state.Disk?.VolumePath ?? "/data")</code>)</span>
                    <span class="badge bg-secondary">@_state.DiskHistory.Count day(s) tracked</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 small">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Used Space</th>
                                    <th>Free Space</th>
                                    <th>Total Capacity</th>
                                    <th>Daily Usage Change</th>
                                    <th>Usage %</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var snap in _state.DiskHistory)
                                {
                                    <tr>
                                        <td><strong>@snap.SnapshotDate</strong></td>
                                        <td>@snap.FormattedUsed</td>
                                        <td><span class="text-muted">@snap.FormattedFree</span></td>
                                        <td>@snap.FormattedTotal</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(snap.FormattedDailyChange))
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else if (snap.DailyChangeBytes > 0)
                                            {
                                                <span class="text-danger fw-semibold">@snap.FormattedDailyChange</span>
                                            }
                                            else if (snap.DailyChangeBytes < 0)
                                            {
                                                <span class="text-success fw-semibold">@snap.FormattedDailyChange</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0 KB</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px; min-width: 60px;">
                                                    <div class="progress-bar @GetDiskProgressBarClass(snap.UsedPercent)" style="width: @(snap.UsedPercent)%"></div>
                                                </div>
                                                <span>@snap.UsedPercent%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>Project export / import</span>
                <span class="small text-muted">Full folder zip for local debug</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fw-semibold small mb-2">Export (download zip)</div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <select class="form-select form-select-sm" style="max-width: 16rem;"
                                    @bind="_exportProjectId"
                                    disabled="@(_archiveBusy || _projectOptions.Count == 0)">
                                @if (_projectOptions.Count == 0)
                                {
                                    <option value="">No projects</option>
                                }
                                else
                                {
                                    @foreach (var p in _projectOptions)
                                    {
                                        <option value="@p">@p</option>
                                    }
                                }
                            </select>
                            <button type="button" class="btn btn-sm btn-primary"
                                    disabled="@(_archiveBusy || string.IsNullOrWhiteSpace(_exportProjectId))"
                                    @onclick="ExportProjectAsync">
                                @(_archiveBusy && _archiveAction == "export" ? "Zipping…" : "Download full project")
                            </button>
                        </div>
                        <p class="form-text mb-0 mt-1">
                            Includes <code>source/</code>, <code>assets/</code>, scenes, cast, book page PNGs, clips.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold small mb-2">Import (upload zip)</div>
                        <InputFile OnChange="OnImportFileSelected" accept=".zip,application/zip"
                                   class="form-control form-control-sm mb-2"
                                   disabled="@_archiveBusy" />
                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <input class="form-control form-control-sm" style="max-width: 11rem;"
                                   placeholder="Optional new id"
                                   @bind="_importPreferredId"
                                   disabled="@_archiveBusy" />
                            <select class="form-select form-select-sm" style="max-width: 13rem;"
                                    @bind="_importTargetUserId"
                                    disabled="@_archiveBusy"
                                    title="Select a target user to own the imported project area">
                                <option value="">Target owner: (unassigned / admin)</option>
                                @foreach (var u in _userList)
                                {
                                    <option value="@u">User: @u</option>
                                }
                            </select>
                            <div class="form-check mb-0">
                                <InputCheckbox class="form-check-input" id="importOverwrite" @bind-Value="_importOverwrite" />
                                <label class="form-check-label small" for="importOverwrite">Overwrite</label>
                            </div>
                            <button type="button" class="btn btn-sm btn-success"
                                    disabled="@(_archiveBusy || _importFile is null)"
                                    @onclick="ImportProjectAsync">
                                @(_archiveBusy && _archiveAction == "import" ? "Importing…" : "Import project")
                            </button>
                        </div>
                        <p class="form-text mb-0 mt-1">
                            Max ~512&nbsp;MB. Zip should contain <code>project.json</code> (optionally under a top folder).
                        </p>
                    </div>
                    <div class="col-md-12 mt-3 pt-3 border-top">
                        <div class="fw-semibold small mb-2">🎵 Augment &amp; Synthesize Project Music Scores</div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <select class="form-select form-select-sm" style="max-width: 16rem;"
                                    @bind="_augmentProjectId"
                                    disabled="@(_archiveBusy || _projectOptions.Count == 0)">
                                @if (_projectOptions.Count == 0)
                                {
                                    <option value="">No projects</option>
                                }
                                else
                                {
                                    @foreach (var p in _projectOptions)
                                    {
                                        <option value="@p">@p</option>
                                    }
                                }
                            </select>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    disabled="@(_archiveBusy || string.IsNullOrWhiteSpace(_augmentProjectId))"
                                    @onclick="AugmentMusicAsync">
                                @(_archiveBusy && _archiveAction == "augment" ? "Composing Scores…" : "1. Compose Score Prompts")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success ms-1"
                                    disabled="@(_archiveBusy || string.IsNullOrWhiteSpace(_augmentProjectId))"
                                    @onclick="SynthesizeAudioAsync">
                                @(_archiveBusy && _archiveAction == "synthesize" ? $"Synthesizing Audio ({_synthesizeCurrent}/{_synthesizeTotal})…" : "🎼 Synthesize Scene Audio Tracks (Skip Existing)")
                            </button>
                        </div>
                        @if (_archiveBusy && _archiveAction == "synthesize" && _synthesizeTotal > 0)
                        {
                            var pct = Math.Min(100, Math.Max(5, (int)Math.Round((double)_synthesizeCurrent / _synthesizeTotal * 100.0)));
                            <div class="progress mt-2 mb-1" style="height: 20px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                     role="progressbar"
                                     style="width: @pct%"
                                     aria-valuenow="@pct"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    @_synthesizeCurrent / @_synthesizeTotal scenes (@pct%)
                                </div>
                            </div>
                        }
                        <p class="form-text mb-0 mt-2">
                            1. <strong>Compose Score Prompts</strong> non-destructively enriches <code>blueprint.clips.grok.json</code> with AI background music score prompts across all scenes.<br/>
                            2. <strong>Synthesize Scene Audio Tracks</strong> checks each scene and queues AI stereo background music generation for any scene missing audio.
                        </p>
                        @if (_archiveBusy && _archiveAction == "synthesize")
                        {
                            <p class="form-text mb-0 mt-1">
                                Local media folder:
                                @if (MediaFolder.IsConnected)
                                {
                                    <span class="text-success">connected (@MediaFolder.FolderName)</span>
                                }
                                else
                                {
                                    <span class="text-danger">not connected — generated audio cannot be saved</span>
                                }
                                @if (!string.IsNullOrEmpty(MediaFolder.LastStatus))
                                {
                                    <text> · </text><code>@MediaFolder.LastStatus</code>
                                }
                            </p>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_archiveMsg))
                {
                    <div class="alert alert-info py-2 small mt-3 mb-0">@_archiveMsg</div>
                }
                @if (!string.IsNullOrEmpty(_archiveError))
                {
                    <div class="alert alert-danger py-2 small mt-3 mb-0">@_archiveError</div>
                }
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <span>Jobs (running / queued)</span>
                        <span class="badge text-bg-primary">@(_state.Jobs?.Count ?? 0)</span>
                    </div>
                    <div class="card-body p-0">
                        @if (MediaFolder.IsSyncing)
                        {
                            <div class="p-3 border-bottom bg-light">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div>
                                        <span class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></span>
                                        <strong>Syncing MP4 clips to client disk…</strong>
                                        @if (!string.IsNullOrEmpty(MediaFolder.SyncCurrentFile))
                                        {
                                            <span class="text-muted ms-2"><code>@MediaFolder.SyncCurrentFile</code></span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-2" style="min-width: 180px;">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: @(MediaFolder.SyncPercent)%"></div>
                                        </div>
                                        <span class="small font-monospace">@MediaFolder.SyncCurrent / @MediaFolder.SyncTotal</span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (_state.Jobs?.Items is { Count: > 0 } items)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead>
                                    <tr>
                                        <th>Job</th>
                                        <th>User</th>
                                        <th>Kind</th>
                                        <th>Scene</th>
                                        <th>Status</th>
                                        <th>Progress</th>
                                        <th>Age</th>
                                        <th></th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var j in items)
                                    {
                                        var selected = string.Equals(j.JobId, _logJobId, StringComparison.OrdinalIgnoreCase);
                                        <tr class="@(selected ? "table-active" : null)">
                                            <td class="font-monospace small">@(ShortId(j.JobId))</td>
                                            <td>@(j.UserId ?? "—")</td>
                                            <td>@(j.Kind ?? "—")</td>
                                            <td>@(j.Scene?.ToString() ?? "—")</td>
                                            <td>@(j.Status ?? "—")</td>
                                            <td>@(j.Total > 0 ? $"{j.Index}/{j.Total}" : "—")</td>
                                            <td>@FormatAge(j.AgeMs)</td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                        disabled="@(string.IsNullOrEmpty(j.JobId))"
                                                        title="Load job log"
                                                        @onclick="() => LoadJobLogAsync(j.JobId!)">
                                                    Log
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        disabled="@_busy || string.IsNullOrEmpty(j.JobId)"
                                                        @onclick="() => CancelJobAsync(j.JobId!)">
                                                    Cancel
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted p-3 mb-0">No active jobs.</p>
                        }

                        <div class="border-top p-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                <div class="small fw-semibold">Job log</div>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <input class="form-control form-control-sm font-monospace"
                                           style="width: 12rem;"
                                           placeholder="Job id…"
                                           @bind="_logJobIdInput"
                                           @bind:event="oninput"
                                           title="Paste a job id from Home / Characters or this table" />
                                    <button class="btn btn-sm btn-outline-secondary"
                                            disabled="@(string.IsNullOrWhiteSpace(_logJobIdInput))"
                                            @onclick="() => LoadJobLogAsync(_logJobIdInput.Trim())">
                                        Load
                                    </button>
                                    @if (_jobLog is not null)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearJobLog">Clear</button>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_logError))
                            {
                                <div class="alert alert-warning py-1 small mb-2">@_logError</div>
                            }
                            @if (_jobLog is null)
                            {
                                <p class="text-muted small mb-0">
                                    Click <strong>Log</strong> on a running job, or paste a job id.
                                    Cast “Build cast” is not a job (no log) — use Characters admin details after extract.
                                </p>
                            }
                            else
                            {
                                <div class="small mb-2">
                                    <code>@_jobLog.JobId</code>
                                    · @(_jobLog.Kind ?? "—")
                                    · <span class="badge text-bg-secondary">@(_jobLog.Status ?? "—")</span>
                                    @if (!string.IsNullOrWhiteSpace(_jobLog.ProjectId))
                                    {
                                        <span class="text-muted"> · @_jobLog.ProjectId</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_jobLog.Message))
                                    {
                                        <div class="text-muted mt-1">@_jobLog.Message</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_jobLog.Error))
                                    {
                                        <div class="text-danger mt-1">@_jobLog.Error</div>
                                    }
                                </div>
                                <pre class="small mb-0 p-2 rounded border bg-dark text-light"
                                     style="max-height: 22rem; overflow: auto; white-space: pre-wrap;">@JobLogText</pre>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <span>Locks</span>
                        <span class="badge text-bg-secondary">@_locks.Count</span>
                    </div>
                    <div class="card-body p-0">
                        @if (_locks.Count == 0)
                        {
                            <p class="text-muted p-3 mb-0 small">No active locks.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush small">
                                @foreach (var l in _locks.Take(20))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-start py-2">
                                        <div>
                                            <code>@l.Resource</code>
                                            <div>@l.UserId
                                                @if (!string.IsNullOrEmpty(l.Reason))
                                                {
                                                    <span class="text-muted"> · @l.Reason</span>
                                                }
                                            </div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-warning"
                                                disabled="@_busy || string.IsNullOrEmpty(l.Resource)"
                                                @onclick="() => ReleaseLockAsync(l.Resource!)">
                                            Force release
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AdminStateDto? _state;
    private string? _error;
    private string? _actionMsg;
    private bool _busy;
    private bool _hubLive;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _pollCts;
    private int _apiInFlight;
    private int _capacityRejects;
    private int _lockConflicts;
    private List<AdminLockDto> _locks = new();
    private LoadSimLiveStateDto? _loadSim;
    private List<ProcessSampleDto> _processHistory = new();
    private EngineApiClient.TimingTelemetryTrendDto? _timingTelemetry;
    /// <summary>Set when a chart upsert throws after we had real data to draw — surfaced in the UI so failures aren't silent.</summary>
    private string? _chartWarning;

    private string? _logJobId;
    private string _logJobIdInput = "";
    private JobSnapshot? _jobLog;
    private string? _logError;

    private string JobLogText =>
        _jobLog?.Log is { Count: > 0 } lines
            ? string.Join("\n", lines)
            : "(no log lines — job may have finished and been pruned, or never wrote logs)";

    private List<string> _projectOptions = new();
    private List<string> _userList = new();
    private string _exportProjectId = "";
    private string _augmentProjectId = "";
    private string _importPreferredId = "";
    private string _importTargetUserId = "";
    private bool _importOverwrite;
    private IBrowserFile? _importFile;
    private bool _archiveBusy;
    private string? _archiveAction;
    private string? _archiveMsg;
    private string? _archiveError;
    private const long MaxImportBytes = 512L * 1024 * 1024;

    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;

        await Session.EnsureHydratedAsync();
        if (!Session.IsAdmin)
        {
            Nav.NavigateTo("/admin/login", forceLoad: true);
            return;
        }

        StateHasChanged();

        Hub.AdminState += OnAdminState;
        MediaFolder.Changed += OnMediaFolderChanged;
        // Explicit, not just relying on MainLayout's app-wide hook — makes the local-save pipeline
        // (auto-save-on-generate) definitely live before this page starts queuing gen jobs, and
        // surfaces its status/errors here (see OnMediaFolderChanged) instead of nowhere.
        await MediaFolder.EnsureHubHookAsync();
        // Do not block UI on SignalR
        _ = ConnectHubAsync();
        await RefreshAsync();
        StateHasChanged();

        _pollCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task ConnectHubAsync()
    {
        try
        {
            await Hub.StartAsync();
            _hubLive = Hub.IsConnected;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _hubLive = false;
        }
    }

    private void OnMediaFolderChanged() => InvokeAsync(StateHasChanged);

    private void OnAdminState(object? payload)
    {
        _hubLive = true;
        if (payload is not null)
        {
            try
            {
                AdminStateDto? dto = null;
                if (payload is System.Text.Json.JsonElement elem)
                {
                    dto = System.Text.Json.JsonSerializer.Deserialize<AdminStateDto>(elem.GetRawText(), EngineApiClient.JsonOpts);
                }
                else
                {
                    var json = System.Text.Json.JsonSerializer.Serialize(payload, EngineApiClient.JsonOpts);
                    dto = System.Text.Json.JsonSerializer.Deserialize<AdminStateDto>(json, EngineApiClient.JsonOpts);
                }

                if (dto is not null)
                {
                    _state = dto;
                    if (dto.ApiInFlight > 0) _apiInFlight = dto.ApiInFlight;
                    if (dto.CapacityRejects > 0) _capacityRejects = dto.CapacityRejects;
                    if (dto.LockConflicts > 0) _lockConflicts = dto.LockConflicts;
                    if (dto.Locks is { Count: > 0 }) _locks = dto.Locks;
                    if (dto.LoadSim is not null) _loadSim = dto.LoadSim;
                    if (dto.ProcessHistory is { Count: > 0 }) _processHistory = dto.ProcessHistory;
                    _ = InvokeAsync(async () =>
                    {
                        await UpdateChartsAsync();
                        StateHasChanged();
                    });
                    return;
                }
            }
            catch { /* fallback to HTTP refresh if payload shape differs */ }
        }
        _ = InvokeAsync(RefreshAsync);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    // Only poll over HTTP when SignalR is disconnected
                    if (!_hubLive)
                    {
                        await RefreshAsync();
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch { /* keep polling */ }
            }
        }
        catch (OperationCanceledException) { /* disposed */ }
    }

    private async Task RefreshAsync()
    {
        if (!Session.IsAdmin) return;
        _busy = true;
        try
        {
            _state = await Api.GetAdminStateAsync();
            if (_state is not null)
            {
                _apiInFlight = _state.ApiInFlight;
                _capacityRejects = _state.CapacityRejects;
                _lockConflicts = _state.LockConflicts;
                _locks = _state.Locks ?? new();
                _loadSim = _state.LoadSim;
                _processHistory = _state.ProcessHistory ?? new();
            }
            _timingTelemetry = await Api.GetAdminTimingTelemetryTrendAsync();
            _error = null;
            await RefreshProjectOptionsAsync();
            await UpdateChartsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            // Only hard-logout on clear auth failures (not every message containing "admin")
            var msg = ex.Message;
            if (msg.Contains("403", StringComparison.Ordinal) ||
                msg.Contains("401", StringComparison.Ordinal) ||
                msg.Contains("admin role required", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase))
            {
                await Session.ClearAsync();
                Nav.NavigateTo("/admin/login", forceLoad: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshProjectOptionsAsync()
    {
        try
        {
            var projs = await Api.GetProjectsAsync();
            _projectOptions = projs?.Projects?
                                  .Select(p => p.Id ?? "")
                                  .Where(s => s.Length > 0)
                                  .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                                  .ToList()
                              ?? new List<string>();
            if (string.IsNullOrWhiteSpace(_exportProjectId) ||
                !_projectOptions.Contains(_exportProjectId, StringComparer.OrdinalIgnoreCase))
            {
                _exportProjectId = projs?.Active?.Id
                                   ?? _projectOptions.FirstOrDefault()
                                   ?? "";
            }
            if (string.IsNullOrWhiteSpace(_augmentProjectId) ||
                !_projectOptions.Contains(_augmentProjectId, StringComparer.OrdinalIgnoreCase))
            {
                _augmentProjectId = projs?.Active?.Id
                                    ?? _projectOptions.FirstOrDefault()
                                    ?? "";
            }
        }
        catch
        {
            /* keep prior list */
        }

        try
        {
            var usersOverview = await Api.GetAdminUsersCreditsAsync();
            if (usersOverview?.Users is { Count: > 0 } ulist)
            {
                _userList = ulist.Select(u => u.UserId)
                                 .Where(u => !string.IsNullOrWhiteSpace(u))
                                 .OrderBy(u => u, StringComparer.OrdinalIgnoreCase)
                                 .ToList();
            }
        }
        catch
        {
            /* keep prior list */
        }
    }

    private void OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _importFile = e.FileCount > 0 ? e.File : null;
        _archiveError = null;
        _archiveMsg = _importFile is null
            ? null
            : $"Selected {_importFile.Name} ({_importFile.Size / (1024.0 * 1024.0):F1} MB)";
    }

    private async Task ExportProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(_exportProjectId)) return;
        _archiveBusy = true;
        _archiveAction = "export";
        _archiveError = null;
        _archiveMsg = "Building zip…";
        try
        {
            var (resp, fileName) = await Api.ExportProjectZipAsync(_exportProjectId);
            using (resp)
            {
                await using var stream = await resp.Content.ReadAsStreamAsync();
                using var streamRef = new DotNetStreamReference(stream);
                var result = await Js.InvokeAsync<JsonElement>(
                    "PageToMovieExport.downloadStreamAsync",
                    fileName,
                    streamRef);
                if (result.TryGetProperty("success", out var ok) && ok.GetBoolean())
                    _archiveMsg = $"Downloaded {fileName}";
                else
                {
                    var err = result.TryGetProperty("error", out var e) ? e.GetString() : "download failed";
                    _archiveError = err;
                    _archiveMsg = null;
                }
            }
        }
        catch (Exception ex)
        {
            _archiveError = ex.Message;
            _archiveMsg = null;
        }
        finally
        {
            _archiveBusy = false;
            _archiveAction = null;
        }
    }

    private async Task ExportLogsAsync()
    {
        _archiveBusy = true;
        _archiveAction = "export_logs";
        _archiveError = null;
        _archiveMsg = "Building server log archive zip…";
        try
        {
            var (resp, fileName) = await Api.ExportServerLogsZipAsync();
            using (resp)
            {
                await using var stream = await resp.Content.ReadAsStreamAsync();
                using var streamRef = new DotNetStreamReference(stream);
                var result = await Js.InvokeAsync<JsonElement>(
                    "PageToMovieExport.downloadStreamAsync",
                    fileName,
                    streamRef);
                if (result.TryGetProperty("success", out var ok) && ok.GetBoolean())
                    _archiveMsg = $"Downloaded {fileName}";
                else
                {
                    var err = result.TryGetProperty("error", out var e) ? e.GetString() : "download failed";
                    _archiveError = err;
                    _archiveMsg = null;
                }
            }
        }
        catch (Exception ex)
        {
            _archiveError = ex.Message;
            _archiveMsg = null;
        }
        finally
        {
            _archiveBusy = false;
            _archiveAction = null;
        }
    }

    private async Task ImportProjectAsync()
    {
        if (_importFile is null) return;
        if (_importFile.Size > MaxImportBytes)
        {
            _archiveError = $"File too large ({_importFile.Size / (1024.0 * 1024):F0} MB). Max is 512 MB.";
            return;
        }

        _archiveBusy = true;
        _archiveAction = "import";
        _archiveError = null;
        _archiveMsg = "Uploading and importing…";
        try
        {
            await using var stream = _importFile.OpenReadStream(MaxImportBytes);
            var result = await Api.ImportProjectZipAsync(
                stream,
                _importFile.Name,
                preferredId: string.IsNullOrWhiteSpace(_importPreferredId) ? null : _importPreferredId.Trim(),
                overwrite: _importOverwrite,
                targetUserId: string.IsNullOrWhiteSpace(_importTargetUserId) ? null : _importTargetUserId.Trim());
            _archiveMsg = result?.Message
                          ?? $"Imported {result?.ProjectId ?? "project"}";
            _importFile = null;
            if (result is not null && !string.IsNullOrWhiteSpace(result.ProjectId))
            {
                await MediaFolder.SyncProjectMediaToClientAsync(result.ProjectId);
            }
            await RefreshProjectOptionsAsync();
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _archiveError = ex.Message;
            _archiveMsg = null;
        }
        finally
        {
            _archiveBusy = false;
            _archiveAction = null;
        }
    }

    private async Task AugmentMusicAsync()
    {
        if (string.IsNullOrWhiteSpace(_augmentProjectId)) return;

        _archiveBusy = true;
        _archiveAction = "augment";
        _archiveError = null;
        _archiveMsg = $"Composing AI background music scores for {_augmentProjectId}...";
        try
        {
            var ok = await Api.AugmentProjectMusicAsync(_augmentProjectId);
            if (ok)
            {
                _archiveMsg = $"Successfully augmented blueprint.clips.grok.json for {_augmentProjectId} with AI background music scores.";
            }
            else
            {
                _archiveError = $"Failed to augment background music scores for {_augmentProjectId}. Ensure blueprint.clips.grok.json exists.";
                _archiveMsg = null;
            }
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _archiveError = ex.Message;
            _archiveMsg = null;
        }
        finally
        {
            _archiveBusy = false;
            _archiveAction = null;
        }
    }

    private int _synthesizeCurrent;
    private int _synthesizeTotal;

    private async Task SynthesizeAudioAsync()
    {
        if (string.IsNullOrWhiteSpace(_augmentProjectId)) return;

        // Generated music can only reach disk via the connected local media folder (the browser's
        // File System Access picker needs a real click, which this early-in-the-handler call still
        // has). Without it, jobs would run (and cost real API spend) but the audio could never be
        // saved — the only visible sign was a warning banner that only renders on the Scenes page,
        // so from here it looked like nothing happened at all.
        if (!MediaFolder.IsConnected)
        {
            var connected = await MediaFolder.ConnectFolderAsync();
            if (!connected)
            {
                _archiveError = "Connect a local media folder first (Scenes page → Connect folder) — background music can't be saved without one.";
                return;
            }
        }

        _archiveBusy = true;
        _archiveAction = "synthesize";
        _archiveError = null;
        _synthesizeCurrent = 0;
        _synthesizeTotal = 0;
        _archiveMsg = $"Fetching scene list for {_augmentProjectId}…";
        StateHasChanged();

        try
        {
            var scenesDto = await Api.GetScenesAsync(_augmentProjectId);
            var scenes = scenesDto?.Scenes;
            if (scenes is null || scenes.Count == 0)
            {
                _archiveError = $"No scenes found for project {_augmentProjectId}. Build shot plan first.";
                _archiveMsg = null;
                return;
            }

            _synthesizeTotal = scenes.Count;
            int queuedCount = 0;
            int skippedCount = 0;
            int failedCount = 0;
            var failureMessages = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var sc in scenes)
            {
                _synthesizeCurrent++;
                _archiveMsg = $"Checking background music for {_augmentProjectId} Scene S{sc.SceneNumber:D2} ({_synthesizeCurrent}/{_synthesizeTotal})…";
                StateHasChanged();

                // First music segment's relative path (see MediaRegistryService.MusicSegmentRelativePath) —
                // segment 1 always exists once a scene has any background music synced locally.
                var audioPath = $"assets/music/scene_{sc.SceneNumber:D2}_seg_01.wav";
                var hasLocalAudio = MediaFolder.IsConnected && (await MediaFolder.StatLocalFileAsync(_augmentProjectId, audioPath)).Found;

                if (hasLocalAudio)
                {
                    skippedCount++;
                    continue;
                }

                _archiveMsg = $"Queuing background music synthesis for Scene S{sc.SceneNumber:D2} ({_synthesizeCurrent}/{_synthesizeTotal})…";
                StateHasChanged();

                // One job at a time — FilmJobService caps queued jobs per user (MaxQueuePerUser),
                // and this loop can easily exceed that firing every scene back-to-back.
                var started = await Api.StartSceneMusicGenAsync(_augmentProjectId, sc.SceneNumber);
                queuedCount++;

                if (!string.IsNullOrWhiteSpace(started?.JobId))
                {
                    _archiveMsg = $"Generating background music for Scene S{sc.SceneNumber:D2} ({_synthesizeCurrent}/{_synthesizeTotal})…";
                    StateHasChanged();
                    try
                    {
                        var final = await Api.WaitForJobTerminalAsync(started!.JobId, timeout: TimeSpan.FromMinutes(8));
                        // The job "succeeding" server-side only means audio bytes were fetched from the
                        // provider — it says nothing about whether this browser tab actually wrote them
                        // to the local media folder (SaveJobMediaAsync runs off a SignalR JobUpdated
                        // event this loop doesn't observe). Without this check, a wrong/unconfigured
                        // audio provider (e.g. only an AI Music API key set while audio_model_name is
                        // still the fal-ai/stable-audio default) fails every scene silently — the loop
                        // would report a false "Completed" with no sign anything went wrong.
                        if (!string.Equals(final?.Status, "done", StringComparison.OrdinalIgnoreCase))
                        {
                            failedCount++;
                            var msg = string.IsNullOrWhiteSpace(final?.Error) ? (final?.Message ?? "Unknown error") : final!.Error!;
                            failureMessages.Add(msg);
                        }
                        else
                        {
                            // Don't rely solely on the passive SignalR-triggered auto-save (OnJobUpdated
                            // → SaveJobMediaAsync) — its reliability here is unconfirmed. `final` already
                            // carries the same ClientMediaUrl/ClientRelativePath that path would react to
                            // (the last-generated segment's proxy ticket), so call the save directly, the
                            // same way SyncProjectMediaToClientAsync explicitly pulls each file rather
                            // than waiting on an event. SaveJobMediaAsync's own in-flight/dedup guard
                            // makes this a safe no-op if the passive path already grabbed it.
                            _archiveMsg = $"Saving audio for Scene S{sc.SceneNumber:D2} ({_synthesizeCurrent}/{_synthesizeTotal})…";
                            StateHasChanged();
                            if (final is not null)
                                await MediaFolder.SaveJobMediaAsync(final);

                            _archiveMsg = $"Confirming local save for Scene S{sc.SceneNumber:D2} ({_synthesizeCurrent}/{_synthesizeTotal})…";
                            StateHasChanged();
                            var confirmed = false;
                            for (var attempt = 0; attempt < 10; attempt++)
                            {
                                if ((await MediaFolder.StatLocalFileAsync(_augmentProjectId, audioPath)).Found)
                                {
                                    confirmed = true;
                                    break;
                                }
                                await Task.Delay(1000);
                            }
                            if (!confirmed)
                            {
                                failedCount++;
                                failureMessages.Add(
                                    $"Generated but never saved locally for Scene S{sc.SceneNumber:D2} — " +
                                    (MediaFolder.IsConnected
                                        ? $"check media folder connection ({MediaFolder.LastStatus})"
                                        : "media folder disconnected"));
                            }
                        }
                    }
                    catch (TimeoutException)
                    {
                        // Move on — the job keeps running server-side; this loop just stops waiting on it.
                    }
                }
            }

            _archiveMsg = $"Completed background music synthesis checks for {_augmentProjectId}. Queued: {queuedCount}, Skipped (Existing): {skippedCount}, Failed: {failedCount}.";
            if (failedCount > 0)
            {
                _archiveError = $"{failedCount} scene(s) failed to synthesize: {string.Join(" | ", failureMessages)}";
            }
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _archiveError = $"Failed to synthesize scene audio tracks: {ex.Message}";
            _archiveMsg = null;
        }
        finally
        {
            _archiveBusy = false;
            _archiveAction = null;
            StateHasChanged();
        }
    }

    private async Task CancelJobAsync(string jobId)
    {
        _busy = true;
        _actionMsg = null;
        try
        {
            await Api.AdminCancelJobAsync(jobId);
            _actionMsg = $"Cancel requested for {jobId}";
            await RefreshAsync();
        }
        catch (Exception ex) { _actionMsg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadJobLogAsync(string jobId)
    {
        if (string.IsNullOrWhiteSpace(jobId)) return;
        _logError = null;
        _logJobId = jobId.Trim();
        _logJobIdInput = _logJobId;
        try
        {
            var detail = await Api.GetJobByIdAsync(_logJobId);
            _jobLog = detail?.Job;
            if (_jobLog is null)
                _logError = "Job not found (finished jobs are pruned from memory after a while). Check Railway logs for older work.";
            else
                _actionMsg = $"Loaded log for {ShortId(_logJobId)} · {_jobLog.Log?.Count ?? 0} line(s)";
        }
        catch (Exception ex)
        {
            _jobLog = null;
            _logError = ex.Message;
        }
    }

    private void ClearJobLog()
    {
        _jobLog = null;
        _logJobId = null;
        _logError = null;
    }

    private async Task ReleaseLockAsync(string resource)
    {
        _busy = true;
        _actionMsg = null;
        try
        {
            await Api.AdminReleaseLockAsync(resource, force: true);
            _actionMsg = $"Released {resource}";
            await RefreshAsync();
        }
        catch (Exception ex) { _actionMsg = ex.Message; }
        finally { _busy = false; }
    }

