@page "/"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject NavigationManager Nav
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IJSRuntime Js
@using PageToMovie.Core.Models

<PageTitle>PageToMovie</PageTitle>

<div class="home-hero home-hero--cinema d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="/favicon.png" alt="PageToMovie" width="68" height="68" class="rounded-3 shadow flex-shrink-0" />
        <div>
            <span class="home-hero__badge">AI Film Studio</span>
            <h1 class="display-6 fw-bold mb-0 lh-1">Book, cast, optional voice — then the movie.</h1>
            <p class="home-hero__lede">
                Drop a PDF or pick a classic. Personalize cast (and voice if you want), see the estimate, then generate.
                Media stays on your device where possible — the studio pipeline does the rest.
            </p>
        </div>
    </div>

    <!-- Pages → AI → Movie (HTML labels + gentle CSS motion; fixed stage size so nothing jumps) -->
    <div class="home-pipeline" role="img" aria-label="Pages into AI into movie">
        <div class="home-pipeline__stage">
            <div class="home-pipeline__icon home-pipeline__pages" aria-hidden="true">
                <span class="home-pipeline__sheet s1"></span>
                <span class="home-pipeline__sheet s2"></span>
                <span class="home-pipeline__sheet s3"></span>
            </div>
            <span class="home-pipeline__label">PAGES</span>
        </div>

        <div class="home-pipeline__arrows" aria-hidden="true" title="Pages feeding into AI">
            <span class="home-pipeline__chev c1">›</span>
            <span class="home-pipeline__chev c2">›</span>
            <span class="home-pipeline__chev c3">›</span>
        </div>

        <div class="home-pipeline__stage">
            <div class="home-pipeline__icon home-pipeline__ai" aria-hidden="true">
                <span class="home-pipeline__brain">🧠</span>
            </div>
            <span class="home-pipeline__label">AI</span>
        </div>

        <div class="home-pipeline__arrows" aria-hidden="true" title="AI generating movie">
            <span class="home-pipeline__chev c1">›</span>
            <span class="home-pipeline__chev c2">›</span>
            <span class="home-pipeline__chev c3">›</span>
        </div>

        <div class="home-pipeline__stage">
            <div class="home-pipeline__icon home-pipeline__movie" aria-hidden="true">
                <span class="home-pipeline__clapper">
                    <span class="home-pipeline__clapper-top"></span>
                    <span class="home-pipeline__clapper-body"></span>
                </span>
            </div>
            <span class="home-pipeline__label">MOVIE</span>
        </div>
    </div>
</div>

<div class="ptm-path-steps" aria-label="How a film is made">
    <div class="ptm-path-step">
        <div class="ptm-path-step__kicker">Step 1</div>
        <h2 class="ptm-path-step__title">Book</h2>
        <p class="ptm-path-step__body">Classic (cached, cheaper) or your own PDF/text from scratch.</p>
    </div>
    <div class="ptm-path-step">
        <div class="ptm-path-step__kicker">Step 2</div>
        <h2 class="ptm-path-step__title">Cast</h2>
        <p class="ptm-path-step__body">Put your child, spouse, or yourself into one or more roles.</p>
    </div>
    <div class="ptm-path-step">
        <div class="ptm-path-step__kicker">Step 3</div>
        <h2 class="ptm-path-step__title">Voice (optional)</h2>
        <p class="ptm-path-step__body">Stock voices free — or clone a short personal sample as an add-on.</p>
    </div>
    <div class="ptm-path-step">
        <div class="ptm-path-step__kicker">Step 4</div>
        <h2 class="ptm-path-step__title">Estimate · film</h2>
        <p class="ptm-path-step__body">See the quote, sample if you want, then generate and edit.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info">@_message</div>
}

@if (_healthOk == false)
{
    <div class="alert alert-warning">
        Server not reachable. Start PageToMovie.Api, then reload this page.
    </div>
}

<div class="row g-3">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                @if (!Session.IsLoggedIn)
                {
                    <div class="alert alert-warning py-2 small mb-0">
                        <strong>Sign in required.</strong>
                        <a href="login?returnUrl=/" class="alert-link">Sign in or create an account</a>
                        to create projects and connect your AI provider.
                    </div>
                }
                else
                {
                    var activeProject = _projects?.Projects.FirstOrDefault(p =>
                        string.Equals(p.Id, _projects.Active?.Id, StringComparison.OrdinalIgnoreCase));

                    <!-- Compact picker: the common case (already have a project) takes one row.
                         Full management (visibility, collaborate, delete, fork/sync) lives behind
                         "Manage" so Home doesn't spend most of its height on project chrome. -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted small flex-shrink-0">Project</span>
                        @if (_projects is null)
                        {
                            <span class="text-muted small">Loading…</span>
                        }
                        else if (_projects.Projects.Count == 0)
                        {
                            <span class="text-muted small flex-grow-1">No projects yet</span>
                        }
                        else
                        {
                            <select class="form-select form-select-sm flex-grow-1"
                                    style="min-width: 8rem; max-width: 16rem;"
                                    data-testid="home-project-picker"
                                    value="@_projects.Active?.Id"
                                    disabled="@_busy"
                                    @onchange="OnPickerChangedAsync">
                                @foreach (var p in _projects.Projects)
                                {
                                    <option value="@p.Id">@(p.Label ?? p.Title ?? p.Id)</option>
                                }
                            </select>
                            @if (activeProject is not null)
                            {
                                <span class="badge @VisibilityBadgeClass(activeProject.VisibilityMode) small fw-normal flex-shrink-0"
                                      title="Who can see or fork this project">
                                    @VisibilityBadgeText(activeProject.VisibilityMode)
                                </span>
                            }
                        }
                        <button class="btn btn-outline-primary btn-sm flex-shrink-0"
                                data-testid="home-new-project"
                                disabled="@_busy"
                                title="Create a project"
                                @onclick="OpenNewProjectAsync">
                            + New
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                data-testid="home-manage-projects"
                                aria-expanded="@(_manageExpanded ? "true" : "false")"
                                @onclick="() => _manageExpanded = !_manageExpanded">
                            Manage @(_manageExpanded ? "▴" : "▾")
                        </button>
                    </div>

                    @if (_manageExpanded)
                    {
                        <div class="mt-3">
                        @if (_showNew)
                        {
                    <div class="border border-secondary border-opacity-50 rounded p-3 mb-3 bg-dark bg-opacity-75 text-white shadow-sm">
                        <div class="fw-semibold small text-light mb-2">Create New Project</div>
                        @if (ActiveProject.Status is not null && !ActiveProject.Status.XaiConfigured)
                        {
                            <div class="alert alert-warning py-1 px-2 small mb-2">
                                ⚠️ <strong>Notice:</strong> No AI provider connected yet.
                                <a href="configuration" class="alert-link">Connect your AI provider →</a>
                                before story import.
                            </div>
                        }
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <input @ref="_nameInputRef"
                                   class="form-control form-control-sm flex-grow-1 bg-white text-dark border-secondary fw-medium"
                                   style="min-width: 10rem; color: #111111 !important; background-color: #ffffff !important; caret-color: #000000 !important;"
                                   data-testid="home-new-project-name"
                                   value="@_newName"
                                   @oninput="OnNewNameInput"
                                   @onkeydown="OnNewNameKeyDown"
                                   disabled="@_busy"
                                   placeholder="Enter project name..."
                                   maxlength="80"
                                   autofocus
                                   aria-label="New project name" />
                            <button class="btn btn-success btn-sm flex-shrink-0 px-3"
                                    data-testid="home-create-project"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))"
                                    @onclick="CreateProjectAsync">
                                Create
                            </button>
                            <button class="btn btn-outline-secondary btn-sm flex-shrink-0 px-3 text-light border-secondary"
                                    disabled="@_busy"
                                    @onclick="ToggleNewProjectAsync">
                                Cancel
                            </button>
                        </div>
                    </div>
                }

                @if (_projects is null)
                {
                    <p class="text-muted mb-0">Loading…</p>
                }
                else if (_projects.Projects.Count == 0 && !_showNew)
                {
                    <p class="text-muted mb-0">No projects yet. Click <strong>+ New</strong> to get started.</p>
                }
                else if (_projects.Projects.Count > 0)
                {
                    <div class="list-group project-list">
                        @foreach (var p in _projects.Projects)
                        {
                            var id = p.Id ?? "";
                            var active = string.Equals(id, _projects.Active?.Id, StringComparison.OrdinalIgnoreCase);
                            var canManage = Session.IsAdmin ||
                                string.Equals(Session.UserId, p.OwnerUserId, StringComparison.OrdinalIgnoreCase);
                            // One place for visibility: dropdown when owner can edit; badge only when they cannot.
                            var showVisibilityBadge = !(active && canManage);
                            <div class="list-group-item list-group-item-action p-2 overflow-hidden @(active ? "active" : null)">
                                 <div class="d-flex align-items-center justify-content-between gap-1 min-w-0 w-100">
                                     <button type="button"
                                             class="btn border-0 bg-transparent text-start p-1 project-list__pick min-w-0 flex-grow-1 text-truncate @(active ? "text-white" : null)"
                                             data-testid="@($"home-project-{id}")"
                                             data-project-id="@id"
                                             data-project-active="@(active ? "true" : "false")"
                                             title="Click to open project"
                                             disabled="@_busy"
                                             @onclick="() => OpenProjectAsync(id)">
                                         <strong class="text-truncate d-inline-block mw-100">@(p.Label ?? p.Title ?? id)</strong>
                                     </button>
                                     @if (!string.IsNullOrWhiteSpace(p.ParentProjectId))
                                     {
                                         <span class="badge bg-secondary ms-1 small fw-normal flex-shrink-0" title="Forked from @p.ParentProjectId">🍴 Fork of @p.ParentProjectId</span>
                                     }
                                     @if (showVisibilityBadge)
                                     {
                                         @if (string.Equals(p.VisibilityMode, "Open", StringComparison.OrdinalIgnoreCase))
                                         {
                                             <span class="badge bg-success ms-1 small fw-normal flex-shrink-0" title="Public (forkable)">🍴 Public (Forkable)</span>
                                         }
                                         else if (string.Equals(p.VisibilityMode, "Public", StringComparison.OrdinalIgnoreCase))
                                         {
                                             <span class="badge bg-info text-dark ms-1 small fw-normal flex-shrink-0" title="Public (read-only)">👁️ Public (Read-Only)</span>
                                         }
                                         else
                                         {
                                             <span class="badge bg-dark border border-secondary text-muted ms-1 small fw-normal flex-shrink-0" title="Private">🔒 Private</span>
                                         }
                                     }
                                 </div>
                                 @if (active)
                                 {
                                     <div class="d-flex align-items-center gap-1 flex-wrap mt-1 pt-1 border-top border-secondary border-opacity-25 w-100">
                                         @if (!string.IsNullOrWhiteSpace(p.ParentProjectId) && canManage)
                                         {
                                             <a class="btn btn-sm btn-outline-warning"
                                                href="projects/@id/review-contribution?originProjectId=@p.ParentProjectId"
                                                title="Review line-by-line diffs before syncing">
                                                 🔍 Diff
                                             </a>
                                             <button type="button"
                                                     class="btn btn-sm btn-outline-light"
                                                     disabled="@_busy"
                                                     @onclick="() => SyncOriginAsync(id, p.ParentProjectId!)">
                                                 🔄 Sync
                                             </button>
                                         }
                                         @if (canManage)
                                         {
                                             <select class="form-select form-select-sm bg-dark text-white border-secondary w-auto py-1 px-2"
                                                     value="@p.VisibilityMode"
                                                     title="Who can see or fork this project"
                                                     disabled="@_busy"
                                                     @onchange="(e) => ChangeVisibilityAsync(id, e.Value?.ToString())">
                                                 <option value="Private">🔒 Private</option>
                                                 <option value="Public">👁️ Public (Read-Only)</option>
                                                 <option value="Open">🍴 Public (Forkable)</option>
                                             </select>
                                             <button type="button"
                                                     class="btn btn-sm btn-outline-light py-1 px-2"
                                                     disabled="@_busy"
                                                     @onclick="() => OpenCollaboratorsModal(id)">
                                                 Collaborate
                                             </button>
                                             @if (_historyUrls.TryGetValue(id, out var historyUrl) && !string.IsNullOrWhiteSpace(historyUrl))
                                             {
                                                 <button type="button"
                                                         class="btn btn-sm btn-light py-1 px-2"
                                                         data-testid="home-view-history"
                                                         title="Open package history"
                                                         disabled="@_busy"
                                                         @onclick="() => OpenHistoryAsync(historyUrl)">
                                                     GitHub
                                                 </button>
                                             }
                                             @if (_revisionHashes.TryGetValue(id, out var revHash) && !string.IsNullOrWhiteSpace(revHash))
                                             {
                                                 <span class="badge text-bg-light font-monospace text-dark"
                                                       title="Last saved revision"
                                                       style="font-size: 0.7rem;">@ShortHash(revHash)</span>
                                             }
                                         }
                                         <button type="button"
                                                 class="btn btn-sm btn-outline-danger py-1 px-2 ms-auto"
                                                 title="Delete project"
                                                 disabled="@_busy"
                                                 @onclick="() => BeginDeleteAsync(id, p.Label ?? p.Title ?? id)">
                                             🗑️
                                         </button>
                                     </div>
                                 }
                             </div>
                        }
                    </div>
                }


                @if (_deleteId is not null)
                {
                    <div class="border border-danger border-opacity-50 rounded p-3 mt-3 bg-dark bg-opacity-75 text-white shadow-sm">
                        <p class="small mb-2 text-white">
                            Delete <strong>@_deleteLabel</strong>? This removes the project folder and all its files.
                        </p>
                        <div class="d-flex gap-2">
                            <button class="btn btn-danger btn-sm"
                                    disabled="@_busy"
                                    @onclick="ConfirmDeleteAsync">
                                Delete project
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    disabled="@_busy"
                                    @onclick="CancelDelete">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        @if (ActiveProject.HasProject)
        {
            <div class="card mb-3 border-primary shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-6">🎬 Active Project: @ActiveProject.ProjectId</span>
                    <a href="configuration" class="btn btn-sm btn-light fw-semibold">⚙️ Configuration &amp; Services</a>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Work through the film production workflow steps below or switch projects in the list to the left.
                    </p>

                    <div class="row g-2">
                        <div class="col-6 col-md">
                            <a href="adaptation" class="btn btn-outline-primary w-100 py-3 text-center text-decoration-none rounded-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                <span class="fs-2 mb-1">📜</span>
                                <strong class="small">1. Book</strong>
                                <span class="badge bg-secondary mt-1" style="font-size:0.65rem;">Import · screenplay</span>
                            </a>
                        </div>
                        <div class="col-6 col-md">
                            <a href="characters" class="btn btn-outline-primary w-100 py-3 text-center text-decoration-none rounded-3 h-100 d-flex flex-column align-items-center justify-content-center @(ActiveProject.CanCharacters ? "" : "disabled opacity-50")">
                                <span class="fs-2 mb-1">👥</span>
                                <strong class="small">2. Cast & voice</strong>
                                <span class="badge bg-secondary mt-1" style="font-size:0.65rem;">Photos · optional voice</span>
                            </a>
                        </div>
                        <div class="col-6 col-md">
                            <a href="cost" class="btn btn-outline-primary w-100 py-3 text-center text-decoration-none rounded-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                <span class="fs-2 mb-1">💳</span>
                                <strong class="small">3. Estimate</strong>
                                <span class="badge bg-secondary mt-1" style="font-size:0.65rem;">Quote · confirm</span>
                            </a>
                        </div>
                        <div class="col-6 col-md">
                            <a href="scenes" class="btn btn-outline-primary w-100 py-3 text-center text-decoration-none rounded-3 h-100 d-flex flex-column align-items-center justify-content-center @(ActiveProject.CanScenes ? "" : "disabled opacity-50")">
                                <span class="fs-2 mb-1">🎬</span>
                                <strong class="small">4. Film</strong>
                                <span class="badge bg-secondary mt-1" style="font-size:0.65rem;">Clips · stitch</span>
                            </a>
                        </div>
                        <div class="col-6 col-md">
                            <a href="review" class="btn btn-outline-primary w-100 py-3 text-center text-decoration-none rounded-3 h-100 d-flex flex-column align-items-center justify-content-center @(ActiveProject.CanReview ? "" : "disabled opacity-50")">
                                <span class="fs-2 mb-1">✅</span>
                                <strong class="small">5. Review</strong>
                                <span class="badge bg-secondary mt-1" style="font-size:0.65rem;">Edit · publish</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>🌟 Studio Showcase &amp; Film Gallery</span>
                <a href="/demo" class="btn btn-sm btn-outline-info">View All Demos →</a>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">
                    Explore film adaptations produced with PageToMovie. Select any story from the project menu to start editing, or create a new project.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border border-secondary rounded p-3 bg-dark bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="badge bg-danger mb-2">Gothic Drama</div>
                                <h6 class="fw-bold text-white mb-1">The Tell-Tale Heart</h6>
                                <p class="small text-muted mb-2">Edgar Allan Poe's chilling masterpiece adapted into cinematic video with orchestrations by Suno AI.</p>
                            </div>
                            <a href="/demo" class="btn btn-sm btn-outline-light w-100 mt-2">Watch Demo Film</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border border-secondary rounded p-3 bg-dark bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="badge bg-primary mb-2">Animation / Storybook</div>
                                <h6 class="fw-bold text-white mb-1">Buster &amp; Nick</h6>
                                <p class="small text-muted mb-2">Character-locked visual story featuring hero animals and stylized continuous video clips.</p>
                            </div>
                            <a href="/demo" class="btn btn-sm btn-outline-light w-100 mt-2">Watch Demo Film</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<ProjectCollaboratorsModal IsOpen="_showCollaboratorsModal" ProjectId="_collaboratorsProjectId" OnClose="CloseCollaboratorsModal" />

@code {
    private bool? _healthOk;
    private bool _busy;
    private string? _error;
    private string? _message;
    private ProjectsDto? _projects;
    private bool _showCollaboratorsModal;
    private string _collaboratorsProjectId = "";
    /// <summary>Last successful push history URL per project id (session-local).</summary>
    private readonly Dictionary<string, string> _historyUrls =
        new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Last saved revision hash per project id (session-local).</summary>
    private readonly Dictionary<string, string> _revisionHashes =
        new(StringComparer.OrdinalIgnoreCase);

    private void OpenCollaboratorsModal(string projectId)
    {
        _collaboratorsProjectId = projectId;
        _showCollaboratorsModal = true;
    }

    private void CloseCollaboratorsModal() => _showCollaboratorsModal = false;

    private static string ShortHash(string? hash)
    {
        if (string.IsNullOrWhiteSpace(hash)) return "";
        var h = hash.Trim();
        return h.Length <= 7 ? h : h[..7];
    }
    private JobSnapshot? _job;
    private List<JobSnapshot> _myJobs = new();
    private bool _showNew;
    /// <summary>Home defaults to a one-row project picker; full project management
    /// (visibility, collaborate, delete, fork/sync) is opt-in via "Manage".</summary>
    private bool _manageExpanded;
    private string _newName = "";
    private ElementReference _nameInputRef;
    private string? _deleteId;
    private string _deleteLabel = "";
    private string _deleteConfirm = "";
    /// <summary>My jobs panel; collapsed by default, auto-opens when a job is running/queued.</summary>
    private bool _jobsExpanded;
    /// <summary>Null = follow auto rules; otherwise honor last user click.</summary>
    private bool? _jobsUserPreference;

    private async Task ToggleNewProjectAsync()
    {
        _showNew = !_showNew;
        if (_showNew)
        {
            _newName = "";
            StateHasChanged();
            await Task.Yield();
            try { await _nameInputRef.FocusAsync(); } catch { }
        }
    }

    /// <summary>"+ New" in the compact bar: opens Manage and the create-project form together.</summary>
    private async Task OpenNewProjectAsync()
    {
        _manageExpanded = true;
        if (!_showNew)
            await ToggleNewProjectAsync();
        else
            StateHasChanged();
    }

    /// <summary>Compact picker &lt;select&gt; — switches the active project without navigating away.</summary>
    private async Task OnPickerChangedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(id))
            await SelectProjectAsync(id);
    }

    private static string VisibilityBadgeClass(string? mode) => mode?.Trim().ToLowerInvariant() switch
    {
        "open" => "bg-success",
        "public" => "bg-info text-dark",
        _ => "bg-dark border border-secondary text-muted",
    };

    private static string VisibilityBadgeText(string? mode) => mode?.Trim().ToLowerInvariant() switch
    {
        "open" => "🍴 Forkable",
        "public" => "👁️ Public",
        _ => "🔒 Private",
    };


    private bool CanConfirmDelete => _deleteId is not null;

    private bool HasActiveJob =>
        _job is not null &&
        (string.Equals(_job.Status, "running", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(_job.Status, "queued", StringComparison.OrdinalIgnoreCase));

    private void ToggleJobsExpanded()
    {
        _jobsExpanded = !_jobsExpanded;
        _jobsUserPreference = _jobsExpanded;
    }

    private void SyncJobsExpandedFromJob()
    {
        if (_jobsUserPreference is bool prefer)
            _jobsExpanded = prefer;
        else
            _jobsExpanded = HasActiveJob; // collapsed when idle, open when work is running
    }

    protected override async Task OnInitializedAsync()
    {
        Hub.JobUpdated += OnJobUpdated;
        Hub.JobLog += OnJobLog;
        try { await Session.EnsureHydratedAsync(); } catch { /* optional */ }
        await LoadAsync();
        try
        {
            await Hub.StartAsync();
        }
        catch
        {
            // SignalR optional for browse
        }
    }

    private void OnJobUpdated(JobSnapshot snap)
    {
        _job = snap;
        SyncJobsExpandedFromJob();
        _ = InvokeAsync(async () =>
        {
            try
            {
                var mine = await Engine.GetJobsAsync(mine: true);
                _myJobs = mine?.Jobs?
                    .OrderByDescending(j => j.StartedAt ?? j.QueuedAt)
                    .Take(12)
                    .ToList()
                    ?? new List<JobSnapshot>();
            }
            catch { /* ignore */ }
            SyncJobsExpandedFromJob();
            StateHasChanged();
        });
    }

    private void OnJobLog(string line)
    {
        if (_job is not null)
        {
            _job.Message = line;
            // Keep rolling admin log so video API prompts appear live on Home
            _job.Log ??= new List<string>();
            _job.Log.Add(line);
            if (_job.Log.Count > 2000)
                _job.Log.RemoveRange(0, _job.Log.Count - 1500);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private static bool JobLogHasVideoPayload(JobSnapshot j) =>
        j.Log.Any(l =>
            l.Contains("PROMPT BEGIN", StringComparison.OrdinalIgnoreCase) ||
            l.Contains("[Grok] Submit", StringComparison.OrdinalIgnoreCase) ||
            l.Contains("video-extend", StringComparison.OrdinalIgnoreCase) ||
            l.Contains("reference-to-video", StringComparison.OrdinalIgnoreCase));

    private async Task LoadAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            try
            {
                await Engine.EnsureHealthyAsync();
                _healthOk = true;
            }
            catch
            {
                _healthOk = false;
                _projects = null;
                return;
            }

            // Project inventory requires sign-in — do not hit /api/projects while anonymous
            // (avoids noisy 401 in the browser console on Home / login returnUrl=/).
            if (!Session.IsLoggedIn)
            {
                _projects = new ProjectsDto { Ok = true, Projects = new List<ProjectInfo>() };
                _job = null;
                _myJobs = new List<JobSnapshot>();
                SyncJobsExpandedFromJob();
                return;
            }

            _projects = await Engine.GetProjectsAsync();
            await ActiveProject.RefreshFromApiAsync(Engine);

            var jobs = await Engine.GetJobAsync();
            _job = jobs?.Job;
            try
            {
                var mine = await Engine.GetJobsAsync(mine: true);
                _myJobs = mine?.Jobs?
                    .OrderByDescending(j => j.StartedAt ?? j.QueuedAt)
                    .Take(12)
                    .ToList()
                    ?? new List<JobSnapshot>();
            }
            catch { _myJobs = new List<JobSnapshot>(); }
            SyncJobsExpandedFromJob();
        }
        catch (Exception ex)
        {
            // Stale token / expired JWT → treat as signed out rather than a red wall of text
            var msg = ex.Message ?? "";
            if (msg.Contains("401", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("auth_required", StringComparison.OrdinalIgnoreCase))
            {
                _projects = new ProjectsDto { Ok = true, Projects = new List<ProjectInfo>() };
                _error = null;
            }
            else
            {
                _error = msg;
            }
        }
        finally
        {
            _busy = false;
        }
    }

