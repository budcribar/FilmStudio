@page "/"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject NavigationManager Nav
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IJSRuntime Js
@using PageToMovie.Core.Models

<PageTitle>PageToMovie</PageTitle>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info">@_message</div>
}

@if (_healthOk == false)
{
    <div class="alert alert-warning">
        Server not reachable. Start PageToMovie.Api, then reload this page.
    </div>
}

@if (!Session.IsLoggedIn)
{
    <div class="card mb-3 home-active-card">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-3">
            <img src="/favicon.png" alt="" width="36" height="36" class="rounded-2 shadow-sm flex-shrink-0" />
            <div class="min-w-0 flex-grow-1">
                <div class="small text-muted">Studio</div>
                <div class="fw-semibold">Sign in to open your film</div>
                <div class="small text-muted">Library book + your voice · or full studio</div>
            </div>
            <a href="login?returnUrl=/" class="btn btn-primary btn-sm">Sign in</a>
        </div>
    </div>
}
else if (_projects is null)
{
    <div class="card mb-3 home-studio-card">
        <div class="card-body py-3 text-muted small">Loading projects…</div>
    </div>
}
else
{
    var activeMeta = _projects.Projects.FirstOrDefault(p =>
        string.Equals(p.Id, _projects.Active?.Id, StringComparison.OrdinalIgnoreCase));
    var hasActive = ActiveProject.HasProject || !string.IsNullOrWhiteSpace(_projects.Active?.Id);

    @if (ShowEasyHome)
    {
        @* Default home: easiest start only — advanced project picker is behind Full studio. *@
        <div class="card mb-3 border-primary border-opacity-50" data-testid="home-simple-voice-card">
            <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="min-w-0">
                    <div class="small text-primary fw-semibold text-uppercase" style="letter-spacing:0.06em;">Easiest start</div>
                    <div class="fw-semibold">Read a library book in your voice</div>
                    <div class="small text-muted">
                        Pick a story, record one sample — we put your voice on the narrator.
                        Stock pictures stay as-is.
                    </div>
                </div>
                <a href="simple-voice" class="btn btn-primary btn-sm flex-shrink-0" data-testid="home-open-simple-voice">
                    Try with your voice →
                </a>
            </div>
        </div>

        <div class="card mb-3" data-testid="home-full-studio-card">
            <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="min-w-0">
                    <div class="small text-muted text-uppercase fw-semibold" style="letter-spacing:0.06em;">Advanced</div>
                    <div class="fw-semibold">Full studio</div>
                    <div class="small text-muted">
                        Pick or create a project, cast faces, estimate, film, and review — full control.
                    </div>
                </div>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm flex-shrink-0"
                        data-testid="home-open-full-studio"
                        @onclick="EnterFullStudio">
                    Open full studio →
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <button type="button"
                    class="btn btn-link btn-sm px-0"
                    data-testid="home-back-easy-start"
                    @onclick="ExitFullStudio">
                ← Easy start
            </button>
            <span class="small text-muted">Full studio</span>
        </div>

        <div class="card mb-3 home-studio-card" data-testid="home-studio-card">
            <div class="card-body py-3">
                @if (hasActive)
                {
                    @* Single studio bar: Project · name · visibility · New · Manage · [Setup if keys missing] *@
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2 home-active-toolbar">
                        <span class="home-project-label text-muted small text-uppercase flex-shrink-0">Project</span>
                        <select class="form-select form-select-sm home-project-select flex-grow-1"
                                style="min-width: 10rem; max-width: 22rem;"
                                data-testid="home-project-picker"
                                value="@(_projects.Active?.Id ?? ActiveProject.ProjectId)"
                                disabled="@_busy"
                                title="Project"
                                aria-label="Project"
                                @onchange="OnPickerChangedAsync">
                            @foreach (var p in _projects.Projects)
                            {
                                <option value="@p.Id">@(p.Label ?? p.Title ?? p.Id)</option>
                            }
                        </select>
                        @if (activeMeta is not null)
                        {
                            <span class="badge @VisibilityBadgeClass(activeMeta.VisibilityMode) small fw-normal flex-shrink-0"
                                  title="Visibility">
                                @VisibilityBadgeText(activeMeta.VisibilityMode)
                            </span>
                        }
                        <button type="button"
                                class="btn btn-outline-primary btn-sm flex-shrink-0"
                                data-testid="home-new-project"
                                disabled="@_busy"
                                @onclick="OpenNewProjectAsync"
                                title="New project">
                            + New
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                data-testid="home-manage-projects"
                                aria-expanded="@(_manageExpanded ? "true" : "false")"
                                @onclick="() => _manageExpanded = !_manageExpanded">
                            Manage @(_manageExpanded ? "▴" : "▾")
                        </button>
                        @if (NeedsApiSetup)
                        {
                            <a href="configuration"
                               class="btn btn-warning btn-sm flex-shrink-0"
                               data-testid="home-setup-config"
                               title="Connect your AI API keys">
                                Setup keys
                            </a>
                        }
                    </div>

                    <div class="home-project-cost d-flex flex-wrap align-items-center gap-2 gap-md-3 mb-2"
                         data-testid="home-project-cost">
                        @if (_costLoading && _costEstimateUsd is null && _costActualUsd is null)
                        {
                            <span class="small text-muted">Loading cost…</span>
                        }
                        else
                        {
                            <span class="small">
                                <span class="text-muted">Estimate</span>
                                <strong class="ms-1" data-testid="home-cost-estimate">@FormatUsd(_costEstimateUsd)</strong>
                                @if (!string.IsNullOrWhiteSpace(_costResolution))
                                {
                                    <span class="text-muted ms-1">(@_costResolution</span>
                                    @if (_costVideoRate is > 0)
                                    {
                                        <span class="text-muted"> · @FormatUsd(_costVideoRate)/s</span>
                                    }
                                    <span class="text-muted">)</span>
                                }
                            </span>
                            <span class="text-muted small d-none d-sm-inline">·</span>
                            <span class="small">
                                <span class="text-muted">Spent</span>
                                <strong class="ms-1" data-testid="home-cost-spent">@FormatUsd(_costActualUsd)</strong>
                            </span>
                            <a href="/cost" class="small ms-sm-1" data-testid="home-cost-details">Details</a>
                        }
                    </div>

                    @if (_manageExpanded && hasActive)
                    {
                        <div class="home-manage-panel mb-3 p-2 rounded border border-secondary border-opacity-25">
                            @{
                                var id = _projects.Active?.Id ?? ActiveProject.ProjectId ?? "";
                                var p = activeMeta ?? _projects.Projects.FirstOrDefault(x =>
                                    string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));
                                var canManage = p is not null && (Session.IsAdmin ||
                                    string.Equals(Session.UserId, p.OwnerUserId, StringComparison.OrdinalIgnoreCase));
                            }
                            @if (p is not null)
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (!string.IsNullOrWhiteSpace(p.ParentProjectId) && canManage)
                                    {
                                        <a class="btn btn-sm btn-outline-warning"
                                           href="projects/@id/review-contribution?originProjectId=@p.ParentProjectId">
                                            Diff
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                @onclick="() => SyncOriginAsync(id, p.ParentProjectId!)">
                                            Sync origin
                                        </button>
                                    }
                                    @if (canManage)
                                    {
                                        <select class="form-select form-select-sm w-auto"
                                                value="@p.VisibilityMode"
                                                disabled="@_busy"
                                                @onchange="(e) => ChangeVisibilityAsync(id, e.Value?.ToString())">
                                            <option value="Private">Private</option>
                                            <option value="Public">Public (Read-Only)</option>
                                            <option value="Open">Public (Forkable)</option>
                                        </select>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                @onclick="BeginRenameAsync">
                                            Rename
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                @onclick="() => OpenCollaboratorsModal(id)">
                                            Collaborate
                                        </button>
                                        @if (_historyUrls.TryGetValue(id, out var historyUrl) && !string.IsNullOrWhiteSpace(historyUrl))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                    @onclick="() => OpenHistoryAsync(historyUrl)">
                                                GitHub
                                            </button>
                                        }
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-auto" disabled="@_busy"
                                            @onclick="() => BeginDeleteAsync(id, p.Label ?? p.Title ?? id)">
                                        Delete
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">No project details to manage.</p>
                            }
                        </div>
                    }

                    @if (_showRename && hasActive)
                    {
                        <div class="border border-secondary border-opacity-50 rounded p-3 mt-2 bg-dark bg-opacity-75 text-white shadow-sm">
                            <div class="fw-semibold small text-light mb-2">Rename project</div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <input class="form-control form-control-sm flex-grow-1 bg-white text-dark border-secondary fw-medium"
                                       style="min-width: 10rem; color: #111111 !important; background-color: #ffffff !important;"
                                       data-testid="home-rename-project-name"
                                       value="@_renameName"
                                       @oninput="OnRenameNameInput"
                                       disabled="@_busy"
                                       maxlength="80"
                                       placeholder="New display name"
                                       aria-label="Rename project" />
                                <button class="btn btn-success btn-sm"
                                        data-testid="home-rename-project-save"
                                        disabled="@(_busy || string.IsNullOrWhiteSpace(_renameName))"
                                        @onclick="ConfirmRenameAsync">
                                    Save name
                                </button>
                                <button class="btn btn-outline-secondary btn-sm text-light border-secondary"
                                        disabled="@_busy"
                                        @onclick="CancelRename">
                                    Cancel
                                </button>
                            </div>
                            <div class="form-text text-muted mt-1">Changes the display name only — project id stays the same.</div>
                        </div>
                    }

                    @if (_deleteId is not null)
                    {
                        <div class="border border-danger border-opacity-50 rounded p-3 mt-2 bg-dark bg-opacity-75 text-white shadow-sm">
                            <p class="small mb-2 text-white">
                                Delete <strong>@_deleteLabel</strong>? This removes the project folder and all its files.
                            </p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="ConfirmDeleteAsync">Delete project</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="CancelDelete">Cancel</button>
                            </div>
                        </div>
                    }

                    <StudioProcessStrip Active="@HomeActiveStep" />
                }
                else
                {
                    @* Empty studio: brand + pick/create only. *@
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <img src="/favicon.png" alt="" width="36" height="36" class="rounded-2 shadow-sm flex-shrink-0" />
                            <div class="min-w-0">
                                <div class="small text-muted">Full studio</div>
                                <h1 class="home-top__title mb-0">Choose a film</h1>
                                <div class="home-top__sub">Import a book, cast, estimate, film</div>
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm"
                                data-testid="home-new-project"
                                disabled="@_busy"
                                @onclick="OpenNewProjectAsync">
                            + New project
                        </button>
                    </div>

                    @if (ActiveProject.Status is { XaiConfigured: false })
                    {
                        <StudioProcessStrip Active="setup" />
                    }

                    @if (_projects.Projects.Count == 0 && !_showNew)
                    {
                        <p class="small text-muted mb-0">No projects yet — create one to start Book → Cast → Film.</p>
                    }
                    else if (_projects.Projects.Count > 0)
                    {
                        <div class="list-group project-list">
                            @foreach (var p in _projects.Projects)
                            {
                                var id = p.Id ?? "";
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-2"
                                        data-testid="@($"home-project-{id}")"
                                        disabled="@_busy"
                                        @onclick="() => OpenProjectAsync(id)">
                                    <span class="text-truncate fw-semibold">@(p.Label ?? p.Title ?? id)</span>
                                    <span class="badge @VisibilityBadgeClass(p.VisibilityMode) small fw-normal flex-shrink-0">
                                        @VisibilityBadgeText(p.VisibilityMode)
                                    </span>
                                </button>
                            }
                        </div>
                    }
                }

                @if (_showNew)
                {
                    <div class="border border-secondary border-opacity-50 rounded p-3 mt-3 bg-dark bg-opacity-75 text-white shadow-sm">
                        <div class="fw-semibold small text-light mb-2">Create New Project</div>
                        @if (ActiveProject.Status is not null && !ActiveProject.Status.XaiConfigured)
                        {
                            <div class="alert alert-warning py-1 px-2 small mb-2">
                                No AI provider connected yet — finish <strong>Setup</strong> (step 0) first.
                                <a href="configuration" class="alert-link">Open Setup →</a>
                            </div>
                        }
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <input @ref="_nameInputRef"
                                   class="form-control form-control-sm flex-grow-1 bg-white text-dark border-secondary fw-medium"
                                   style="min-width: 10rem; color: #111111 !important; background-color: #ffffff !important; caret-color: #000000 !important;"
                                   data-testid="home-new-project-name"
                                   value="@_newName"
                                   @oninput="OnNewNameInput"
                                   @onkeydown="OnNewNameKeyDown"
                                   disabled="@_busy"
                                   placeholder="Enter project name..."
                                   maxlength="80"
                                   autofocus
                                   aria-label="New project name" />
                            <button class="btn btn-success btn-sm flex-shrink-0 px-3"
                                    data-testid="home-create-project"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))"
                                    @onclick="CreateProjectAsync">
                                Create
                            </button>
                            <button class="btn btn-outline-secondary btn-sm flex-shrink-0 px-3 text-light border-secondary"
                                    disabled="@_busy"
                                    @onclick="ToggleNewProjectAsync">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Demo films always visible under either mode *@
    <div class="card home-showcase-card mb-3" data-testid="home-demo-films-card">
        <div class="card-body py-3">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                <div class="min-w-0">
                    <div class="ptm-adapt-kicker mb-1">Page to Movie channel</div>
                    <div class="fw-semibold fs-5 mb-0">Demo films</div>
                    <div class="small text-muted text-truncate" title="@_demoShowcaseHint">@_demoShowcaseHint</div>
                </div>
                <a href="/demo" class="btn btn-sm btn-primary flex-shrink-0" data-testid="home-open-demo-gallery">
                    Open gallery →
                </a>
            </div>
            @if (_publicDemos.Count > 0)
            {
                <div class="home-showcase-thumbs" aria-label="Recent demo films">
                    @foreach (var d in _publicDemos.Take(4))
                    {
                        var yt = !string.IsNullOrWhiteSpace(d.YoutubeId) ? d.YoutubeId : null;
                        var href = !string.IsNullOrWhiteSpace(d.YoutubeUrl)
                            ? d.YoutubeUrl!
                            : (yt is not null ? $"https://www.youtube.com/watch?v={yt}" : "/demo");
                        var thumb = yt is not null
                            ? $"https://img.youtube.com/vi/{yt}/mqdefault.jpg"
                            : null;
                        <a class="home-showcase-thumb"
                           href="@href"
                           target="@(yt is not null ? "_blank" : null)"
                           rel="@(yt is not null ? "noopener" : null)"
                           title="@d.Title">
                            @if (thumb is not null)
                            {
                                <img src="@thumb" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="home-showcase-thumb__ph" aria-hidden="true">▶</span>
                            }
                            <span class="home-showcase-thumb__label">@d.Title</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

<ProjectCollaboratorsModal IsOpen="_showCollaboratorsModal" ProjectId="_collaboratorsProjectId" OnClose="CloseCollaboratorsModal" />

@code {
    /// <summary>Show Setup keys only while personal BYOK studio keys are missing.</summary>
    private bool NeedsApiSetup =>
        ActiveProject.Status is { XaiConfigured: false };

    /// <summary>Default home = easy start. Full studio hides easy cards and shows project picker.</summary>
    private bool ShowEasyHome => !_fullStudioHome;

    /// <summary>Only the real current step is highlighted. Setup (0) until keys exist, then pipeline.</summary>
    private string HomeActiveStep
    {
        get
        {
            if (ActiveProject.Status is { XaiConfigured: false })
                return "setup";
            if (!ActiveProject.HasProject) return "book";
            if (!ActiveProject.CanCharacters) return "book";
            if (!ActiveProject.CanEstimate) return "cast";
            if (!ActiveProject.CanScenes) return "estimate";
            return "film";
        }
    }

    private bool? _healthOk;
    private bool _busy;
    private string? _error;
    private string? _message;
    private ProjectsDto? _projects;
    private bool _showCollaboratorsModal;
    private string _collaboratorsProjectId = "";
    /// <summary>Last successful push history URL per project id (session-local).</summary>
    private readonly Dictionary<string, string> _historyUrls =
        new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Last saved revision hash per project id (session-local).</summary>
    private readonly Dictionary<string, string> _revisionHashes =
        new(StringComparer.OrdinalIgnoreCase);

    private void OpenCollaboratorsModal(string projectId)
    {
        _collaboratorsProjectId = projectId;
        _showCollaboratorsModal = true;
    }

    private void CloseCollaboratorsModal() => _showCollaboratorsModal = false;

    private static string ShortHash(string? hash)
    {
        if (string.IsNullOrWhiteSpace(hash)) return "";
        var h = hash.Trim();
        return h.Length <= 7 ? h : h[..7];
    }
    private JobSnapshot? _job;
    private List<JobSnapshot> _myJobs = new();
    private bool _showNew;
    private bool _showSwitch;
    private bool _showRename;
    private string _renameName = "";
    /// <summary>Home defaults to a one-row project picker; full project management
    /// (visibility, collaborate, delete, fork/sync) is opt-in via "Manage".</summary>
    private bool _manageExpanded;
    /// <summary>When true, show project picker / active project; hide easy-start card.</summary>
    private bool _fullStudioHome;

    private string _newName = "";
    private ElementReference _nameInputRef;
    private string? _deleteId;
    private string _deleteLabel = "";
    private string _deleteConfirm = "";
    /// <summary>My jobs panel; collapsed by default, auto-opens when a job is running/queued.</summary>
    private bool _jobsExpanded;
    /// <summary>Null = follow auto rules; otherwise honor last user click.</summary>
    private bool? _jobsUserPreference;
    /// <summary>Titles of real public demos (never invented marketing names).</summary>
    private string _demoShowcaseHint = "Loading gallery…";
    private List<DemoListItem> _publicDemos = new();

    /// <summary>Planning estimate for the full film (draft path) from cost report.</summary>
    private double? _costEstimateUsd;
    /// <summary>Ledger actual spend for this project (catalog list rates).</summary>
    private double? _costActualUsd;
    private string? _costResolution;
    private double? _costVideoRate;
    private bool _costLoading;

    private void EnterFullStudio()
    {
        _fullStudioHome = true;
        _manageExpanded = false;
    }

    private void ExitFullStudio()
    {
        _fullStudioHome = false;
        _manageExpanded = false;
        _showNew = false;
        _showRename = false;
    }

    private async Task ToggleNewProjectAsync()
    {
        _showNew = !_showNew;
        if (_showNew)
        {
            _newName = "";
            StateHasChanged();
            await Task.Yield();
            try { await _nameInputRef.FocusAsync(); } catch { }
        }
    }

    /// <summary>"+ New" in the compact bar: opens Manage and the create-project form together.</summary>
    private async Task OpenNewProjectAsync()
    {
        _fullStudioHome = true;
        _manageExpanded = true;
        if (!_showNew)
            await ToggleNewProjectAsync();
        else
            StateHasChanged();
    }

    /// <summary>Compact picker &lt;select&gt; — switches the active project without navigating away.</summary>
    private async Task OnPickerChangedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(id))
            await SelectProjectAsync(id);
    }

    private static string VisibilityBadgeClass(string? mode) => mode?.Trim().ToLowerInvariant() switch
    {
        "open" => "bg-success",
        "public" => "bg-info text-dark",
        _ => "bg-dark border border-secondary text-muted",
    };

    private static string VisibilityBadgeText(string? mode) => mode?.Trim().ToLowerInvariant() switch
    {
        "open" => "🍴 Forkable",
        "public" => "👁️ Public",
        _ => "🔒 Private",
    };

    private static string FormatUsd(double? amount)
    {
        if (amount is null) return "—";
        return amount.Value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    }

    private async Task RefreshProjectCostAsync()
    {
        var pid = ActiveProject.ProjectId ?? _projects?.Active?.Id;
        if (string.IsNullOrWhiteSpace(pid) || !Session.IsLoggedIn)
        {
            _costEstimateUsd = null;
            _costActualUsd = null;
            _costResolution = null;
            _costVideoRate = null;
            _costLoading = false;
            return;
        }

        _costLoading = true;
        try
        {
            // Match film resolution so Home estimate tracks 480p / 720p / 1080p rates.
            string? draftRes = null;
            try
            {
                var cfg = await Engine.GetConfigAsync(pid);
                if (cfg?.Config is not null &&
                    cfg.Config.TryGetValue("resolution", out var resEl) &&
                    resEl.ValueKind == System.Text.Json.JsonValueKind.String)
                    draftRes = resEl.GetString();
            }
            catch { /* use server default */ }

            var dto = await Engine.GetCostAsync(pid, draftResolution: draftRes);
            var s = dto?.Cost?.Summary;
            _costEstimateUsd = s?.FullFilmAllDraftUsd;
            _costActualUsd = s?.ActualUsd;
            _costResolution = dto?.Cost?.DraftResolution ?? draftRes;
            _costVideoRate = dto?.Cost?.OutputRateDraft;
        }
        catch
        {
            // Keep prior numbers if refresh fails mid-session
        }
        finally
        {
            _costLoading = false;
        }
    }

    private bool CanConfirmDelete => _deleteId is not null;

    private bool HasActiveJob =>
        _job is not null &&
        (string.Equals(_job.Status, "running", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(_job.Status, "queued", StringComparison.OrdinalIgnoreCase));

    private void ToggleJobsExpanded()
    {
        _jobsExpanded = !_jobsExpanded;
        _jobsUserPreference = _jobsExpanded;
    }

    private void SyncJobsExpandedFromJob()
    {
        if (_jobsUserPreference is bool prefer)
            _jobsExpanded = prefer;
        else
            _jobsExpanded = HasActiveJob; // collapsed when idle, open when work is running
    }

    protected override async Task OnInitializedAsync()
    {
        Hub.JobUpdated += OnJobUpdated;
        Hub.JobLog += OnJobLog;
        try { await Session.EnsureHydratedAsync(); } catch { /* optional */ }
        await LoadAsync();
        await LoadDemoShowcaseAsync();
        try
        {
            await Hub.StartAsync();
        }
        catch
        {
            // SignalR optional for browse
        }
    }

    private void OnJobUpdated(JobSnapshot snap)
    {
        _job = snap;
        SyncJobsExpandedFromJob();
        _ = InvokeAsync(async () =>
        {
            try
            {
                var mine = await Engine.GetJobsAsync(mine: true);
                _myJobs = mine?.Jobs?
                    .OrderByDescending(j => j.StartedAt ?? j.QueuedAt)
                    .Take(12)
                    .ToList()
                    ?? new List<JobSnapshot>();
            }
            catch { /* ignore */ }
            SyncJobsExpandedFromJob();
            // Jobs write cost_ledger on completion — keep home spend fresh.
            if (snap.Status is "done" or "error" or "cancelled")
            {
                try { await RefreshProjectCostAsync(); }
                catch { /* ignore */ }
            }
            StateHasChanged();
        });
    }

    private void OnJobLog(string line)
    {
        if (_job is not null)
        {
            _job.Message = line;
            // Keep rolling admin log so video API prompts appear live on Home
            _job.Log ??= new List<string>();
            _job.Log.Add(line);
            if (_job.Log.Count > 2000)
                _job.Log.RemoveRange(0, _job.Log.Count - 1500);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private static bool JobLogHasVideoPayload(JobSnapshot j) =>
        j.Log.Any(l =>
            l.Contains("PROMPT BEGIN", StringComparison.OrdinalIgnoreCase) ||
            l.Contains("[Grok] Submit", StringComparison.OrdinalIgnoreCase) ||
            l.Contains("video-extend", StringComparison.OrdinalIgnoreCase) ||
            l.Contains("reference-to-video", StringComparison.OrdinalIgnoreCase));


    /// <summary>Fill the home gallery blurb from real public demos only.</summary>
    private async Task LoadDemoShowcaseAsync()
    {
        try
        {
            // ListDemos triggers throttled channel sync — cards are real YouTube uploads only.
            var all = await Engine.ListDemosAsync(12, "new");
            _publicDemos = all
                .Where(d => !string.IsNullOrWhiteSpace(d.YoutubeId) && !string.IsNullOrWhiteSpace(d.Title))
                .Take(4)
                .ToList();
            if (_publicDemos.Count == 0)
            {
                _demoShowcaseHint = "No films on the Page to Movie channel yet";
            }
            else
            {
                var titles = _publicDemos
                    .Select(d => (d.Title ?? d.ProjectId ?? "").Trim())
                    .Where(s => s.Length > 0)
                    .Take(4)
                    .ToList();
                if (titles.Count == 0)
                    _demoShowcaseHint = $"{_publicDemos.Count} film{(_publicDemos.Count == 1 ? "" : "s")} on the wall";
                else if (_publicDemos.Count > titles.Count)
                    _demoShowcaseHint = string.Join(", ", titles) + $" · +{_publicDemos.Count - titles.Count} more";
                else
                    _demoShowcaseHint = string.Join(", ", titles);
            }
        }
        catch
        {
            _demoShowcaseHint = "Community films made with PageToMovie";
        }
    }

    private async Task LoadAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            try
            {
                await Engine.EnsureHealthyAsync();
                _healthOk = true;
            }
            catch
            {
                _healthOk = false;
                _projects = null;
                return;
            }

            // Project inventory requires sign-in — do not hit /api/projects while anonymous
            // (avoids noisy 401 in the browser console on Home / login returnUrl=/).
            if (!Session.IsLoggedIn)
            {
                _projects = new ProjectsDto { Ok = true, Projects = new List<ProjectInfo>() };
                _job = null;
                _myJobs = new List<JobSnapshot>();
                SyncJobsExpandedFromJob();
                return;
            }

            _projects = await Engine.GetProjectsAsync();
            await ActiveProject.RefreshFromApiAsync(Engine);
            await RefreshProjectCostAsync();

            var jobs = await Engine.GetJobAsync();
            _job = jobs?.Job;
            try
            {
                var mine = await Engine.GetJobsAsync(mine: true);
                _myJobs = mine?.Jobs?
                    .OrderByDescending(j => j.StartedAt ?? j.QueuedAt)
                    .Take(12)
                    .ToList()
                    ?? new List<JobSnapshot>();
            }
            catch { _myJobs = new List<JobSnapshot>(); }
            SyncJobsExpandedFromJob();
        }
        catch (Exception ex)
        {
            // Stale token / expired JWT → treat as signed out rather than a red wall of text
            var msg = ex.Message ?? "";
            if (msg.Contains("401", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("auth_required", StringComparison.OrdinalIgnoreCase))
            {
                _projects = new ProjectsDto { Ok = true, Projects = new List<ProjectInfo>() };
                _error = null;
            }
            else
            {
                _error = msg;
            }
        }
        finally
        {
            _busy = false;
        }
    }

