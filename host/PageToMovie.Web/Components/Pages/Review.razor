    private void HandleYouTubeOAuthRedirect()
    {
        var uri = new Uri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("youtube", out var status))
            return;
        if (status == "connected")
            _message = "YouTube channel connected";
        else if (status == "error")
            _error = query.TryGetValue("message", out var msg) ? msg.ToString() : "YouTube connect failed";
        // Drop the one-shot query params so a page refresh doesn't re-show the toast.
        Nav.NavigateTo(uri.GetLeftPart(UriPartial.Path), replace: true);
    }

    private void OpenSaveDialog()
    {
        _saveDestination = "demo";
        if (string.IsNullOrWhiteSpace(_youTubeTitle))
            _youTubeTitle = $"{_projectId} — WIP";
        if (string.IsNullOrWhiteSpace(_demoTitle))
            _demoTitle = $"{_projectId}";
        if (string.IsNullOrWhiteSpace(_demoDescription))
            _demoDescription = BuildDefaultDemoAbout();
        _demoAcceptedGuidelines = false;
        _demoMadeForKids = false;
        _demoIsAiSynthetic = true;
        _showSaveDialog = true;
    }

    /// <summary>Starter blurb for the public gallery — user can edit before publish.</summary>
    private string BuildDefaultDemoAbout()
    {
        var withMedia = _scenes.Count(s => s.CompositeExists || s.ClipsOnDisk > 0);
        var clips = _scenes.Sum(s => s.ClipsOnDisk);
        var bits = new List<string>();
        bits.Add($"A PageToMovie short from “{_projectId}”.");
        if (withMedia > 0)
        {
            bits.Add(withMedia == 1
                ? "One scene with picture locked."
                : $"{withMedia} scenes with picture on disk.");
        }
        if (clips > 0)
            bits.Add(clips == 1 ? "1 clip assembled." : $"{clips} clips assembled.");
        bits.Add("AI-assisted adaptation cut shared for feedback.");
        return string.Join(" ", bits);
    }

    private void CloseSaveDialog() => _showSaveDialog = false;

