    private async Task StartYouTubeUploadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await RefreshWipMetaAsync();
            if (!_wipExists || _wipStale)
            {
                _error = "YouTube upload needs an on-disk WIP movie — publish Demo from a browser stitch first, or copy a stitched file to assets/movie_wip.mp4.";
                return;
            }
            await EnsureHubAsync();
            await Engine.StartYouTubeUploadAsync(new StartYouTubeUploadRequest
            {
                ProjectId = _projectId,
                Title = _youTubeTitle,
                Description = _youTubeDescription,
                PrivacyStatus = _youTubePrivacy,
            });
            _showSaveDialog = false;
            _message = "Uploading to YouTube…";
            var jobs = await Engine.GetJobAsync();
            _job = jobs?.Job;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

