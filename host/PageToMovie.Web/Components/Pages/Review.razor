@page "/review"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClientVideoStitchService Stitch
@inject ClientMediaFolderService MediaFolder
@using PageToMovie.Core.Models

<PageTitle>Review</PageTitle>

<h1>Review</h1>

@if (_gateChecked && !ActiveProject.CanReview)
{
    <p class="text-muted mb-3">
        @(string.IsNullOrWhiteSpace(ActiveProject.ReviewBlockedReason)
            ? "Finish the shot plan first."
            : ActiveProject.ReviewBlockedReason)
        <a href="adaptation/shots">Open shot plan →</a>
    </p>
}
else
{
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <p class="text-muted mb-0">
        Review your movie scenes, track approved content, and play or share the final film.
    </p>
    @if (_scenes.Count > 0)
    {
        var approvedCount = _scenes.Count(s => s.IsApproved);
        var pct = Math.Round((approvedCount * 100.0) / Math.Max(1, _scenes.Count));
        <div class="d-flex align-items-center gap-2 bg-dark border border-secondary px-3 py-1.5 rounded-pill text-white small shadow-sm">
            <span><strong>Checklist:</strong> @approvedCount of @_scenes.Count scenes approved (@pct%)</span>
            <div class="progress ms-1" style="width: 80px; height: 6px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @pct%"></div>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info">@_message</div>
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 p-2.5 rounded border border-secondary" style="background-color: #0f172a;">
    <div class="btn-group" role="group" aria-label="Review page views">
        <button type="button" 
                class="btn @(_activeTab == "review" ? "btn-primary fw-bold" : "btn-outline-secondary text-white-50") px-3"
                data-testid="review-tab-review"
                @onclick='() => ToggleTab("review")'>
            🤖 Review &amp; Approve
        </button>
        <button type="button" 
                class="btn @(_activeTab == "play" ? "btn-success fw-bold" : "btn-outline-secondary text-white-50") px-3"
                data-testid="review-tab-play"
                disabled="@(_busy || JobRunning || !CanPlayMovie)"
                @onclick='() => ToggleTab("play")'
                title="@WipPlayTitle">
            ▶ Play
        </button>
        <button type="button" 
                class="btn @(_activeTab == "share" ? "btn-info text-white fw-bold" : "btn-outline-secondary text-white-50") px-3"
                data-testid="review-tab-share"
                disabled="@(_busy || JobRunning || !CanShareMovie)"
                @onclick='() => ToggleTab("share")'>
            📤 Share &amp; Export
        </button>
    </div>

    <div class="d-flex align-items-center gap-2">
        @if (_activeTab == "review")
        {
            <button class="btn btn-sm btn-outline-info fw-semibold" data-testid="review-auto-all"
                    disabled="@(_busy || JobRunning)"
                    title="Run AI visual quality and continuity review on the full movie"
                    @onclick="StartFullMovieReviewAsync">
                ⚡ Run AI Continuity Review
            </button>
        }
        @if (JobRunning)
        {
            <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="CancelAsync">Cancel job</button>
        }
    </div>
</div>

@if (_activeTab == "review")
{
    @if (_movieReport is not null)
    {
        <div class="card mb-3 border-info text-white shadow-sm" style="background-color: #0f172a !important; border-color: #3b82f6 !important;" data-testid="review-movie-report-card">
            <div class="card-header border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2 py-2" style="background-color: #1e293b !important;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fs-5">🤖</span>
                    <span class="fw-bold fs-6">Full Movie Executive AI Review</span>
                    <span class="badge fs-6 @(_movieReport.OverallScore >= 8 ? "bg-success" : _movieReport.OverallScore >= 6 ? "bg-warning text-dark" : "bg-danger")">
                        Overall Score: @_movieReport.OverallScore / 10 — @_movieReport.Verdict
                    </span>
                    <span class="badge bg-dark border border-secondary text-white-50">
                        Model: @_movieReport.ProviderUsed.ToUpperInvariant()
                    </span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="(() => _movieReport = null)">Dismiss</button>
            </div>
            <div class="card-body py-3">
                <!-- Executive Summary & Category Score Breakdown Matrix -->
                <div class="p-3 mb-3 rounded border border-secondary" style="background-color: #1e293b;">
                    <div class="fw-semibold text-info mb-2 d-flex justify-content-between align-items-center">
                        <span>Executive Overview &amp; Category Scores</span>
                    </div>
                    <p class="mb-3 text-light">@(!string.IsNullOrWhiteSpace(_movieReport.ExecutiveSummary) ? _movieReport.ExecutiveSummary : _movieReport.SummaryNotes)</p>
                    
                    @if (_movieReport.CategoryScores is { Count: > 0 })
                    {
                        <div class="row g-2">
                            @foreach (var cat in _movieReport.CategoryScores)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="p-2 rounded bg-dark border border-secondary d-flex justify-content-between align-items-center">
                                        <span class="small text-truncate me-1 text-white-50" title="@cat.Key">@cat.Key</span>
                                        <span class="badge @(cat.Value >= 8 ? "bg-success" : cat.Value >= 6 ? "bg-warning text-dark" : "bg-danger")">@cat.Value/10</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Rollup Sequence Group Accordions -->
                @if (_movieReport.GroupFeedback?.Count > 0)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                        <span class="small fw-semibold text-muted">Sequence Groups Breakdown (@_movieReport.GroupFeedback.Count groups)</span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => ToggleAllSceneGroups(true)">Expand All</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => ToggleAllSceneGroups(false)">Collapse All</button>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var group in _movieReport.GroupFeedback)
                        {
                            var groupRange = group.SceneRange;
                            var expanded = IsSceneGroupExpanded(groupRange);
                            <div class="rounded border border-secondary overflow-hidden" style="background-color: #1e293b;">
                                <div class="p-2.5 d-flex justify-content-between align-items-center cursor-pointer user-select-none" 
                                     style="background-color: rgba(255,255,255,0.03);"
                                     @onclick="() => ToggleSceneGroupExpand(groupRange)">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small">@(expanded ? "▼" : "▶")</span>
                                        <span class="fw-semibold text-info">@groupRange</span>
                                        @if (!string.IsNullOrWhiteSpace(group.ContinuityNotes))
                                        {
                                            <span class="small text-muted text-truncate d-none d-md-inline ms-2" style="max-width: 400px;">
                                                @group.ContinuityNotes
                                            </span>
                                        }
                                    </div>
                                    <span class="badge @(group.Score >= 8 ? "bg-success" : group.Score >= 6 ? "bg-warning text-dark" : "bg-danger")">
                                        Score: @group.Score/10
                                    </span>
                                </div>
                                @if (expanded)
                                {
                                    <div class="p-3 border-top border-secondary border-opacity-50">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <div class="small text-white-50"><strong>Continuity &amp; Transitions:</strong></div>
                                                <div class="small text-light mb-2">@(string.IsNullOrWhiteSpace(group.ContinuityNotes) ? "—" : group.ContinuityNotes)</div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="small text-white-50"><strong>Character Consistency &amp; Wardrobe:</strong></div>
                                                <div class="small text-light mb-2">@(string.IsNullOrWhiteSpace(group.VisualConsistencyNotes) ? "—" : group.VisualConsistencyNotes)</div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(group.LightingNotes))
                                            {
                                                <div class="col-md-6">
                                                    <div class="small text-white-50"><strong>Lighting &amp; Color Grade:</strong></div>
                                                    <div class="small text-light mb-2">@group.LightingNotes</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(group.AudioNotes))
                                            {
                                                <div class="col-md-6">
                                                    <div class="small text-white-50"><strong>Audio &amp; Dialogue Alignment:</strong></div>
                                                    <div class="small text-light mb-2">@group.AudioNotes</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card mb-3 border-info text-white shadow-sm" style="background-color: #0f172a !important; border-color: #3b82f6 !important;">
            <div class="card-body p-4 text-center">
                <div class="fs-1 mb-2">🤖</div>
                <h5 class="fw-bold mb-2">AI Visual &amp; Continuity Review</h5>
                <p class="text-white-50 mb-3 mx-auto" style="max-width: 600px;">
                    Run an automated multi-category visual review across your film's visual continuity, character wardrobe consistency, lighting, and audio alignment.
                </p>
                <button class="btn btn-info text-white fw-bold px-4"
                        disabled="@(_busy || JobRunning)"
                        @onclick="StartFullMovieReviewAsync">
                    ⚡ Run AI Continuity Review
                </button>
            </div>
        </div>
    }
}
else if (_activeTab == "play")
{

@if (_youTubeUpload is not null)
{
    <p class="small text-muted mb-3" data-testid="review-youtube-last-upload">
        Last YouTube upload: <strong>@_youTubeUpload.Title</strong> (@_youTubeUpload.PrivacyStatus, @_youTubeUpload.UploadedAt.ToLocalTime().ToString("g")) —
        <a href="@_youTubeUpload.Url" target="_blank" rel="noopener">@_youTubeUpload.Url</a>
        @if (Session.IsAdmin)
        {
            <a href="#" class="ms-2" @onclick="DisconnectYouTubeAsync" @onclick:preventDefault="true">(disconnect channel)</a>
        }
    </p>
}

@if (_showSaveDialog)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
         style="background:rgba(0,0,0,.45);" @onclick="CloseSaveDialog">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">Share movie</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseSaveDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small mb-1">Where</label>
                        <div class="d-flex flex-column gap-2">
                            <label class="form-check mb-0">
                                <input class="form-check-input" type="radio" name="saveDest" value="demo"
                                       checked="@(_saveDestination == "demo")"
                                       @onchange="@(() => _saveDestination = "demo")" />
                                <span class="form-check-label">
                                    Upload to <strong>Demo</strong> gallery (public)
                                </span>
                            </label>
                            <label class="form-check mb-0">
                                <input class="form-check-input" type="radio" name="saveDest" value="youtube"
                                       checked="@(_saveDestination == "youtube")"
                                       disabled="@(_youTubeStatus?.Connected != true)"
                                       @onchange="@(() => _saveDestination = "youtube")" />
                                <span class="form-check-label">
                                    Upload to YouTube
                                    @if (_youTubeStatus?.Connected != true)
                                    {
                                        <span class="text-muted">(not connected)</span>
                                    }
                                </span>
                            </label>
                        </div>
                        @if (_youTubeStatus?.Connected != true && Session.IsAdmin)
                        {
                            <div class="form-text">
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                        data-testid="review-connect-youtube"
                                        disabled="@(_busy || _youTubeStatus?.Configured != true)"
                                        @onclick="ConnectYouTubeAsync">
                                    Connect YouTube channel
                                </button>
                                @if (_youTubeStatus?.Configured != true)
                                {
                                    <span class="text-muted"> — configure YouTube client id/secret first</span>
                                }
                            </div>
                        }
                    </div>
                    @if (_saveDestination == "demo")
                    {
                        <div class="mb-2">
                            <label class="form-label small">Film title</label>
                            <input class="form-control form-control-sm" @bind="_demoTitle" maxlength="120"
                                   placeholder="e.g. The Tell-Tale Heart — WIP cut" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">About this film</label>
                            <textarea class="form-control form-control-sm" rows="4" @bind="_demoDescription"
                                      placeholder="A short pitch for the gallery: tone, story, what’s special about this cut…"
                                      maxlength="800"></textarea>
                            <div class="form-text">
                                Shown under the video after an admin approves it for the public wall.
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small d-block">Made for kids? (required by YouTube)</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="demoKidsRadio" id="demoNotForKids"
                                       checked="@(!_demoMadeForKids)" @onchange="@(() => _demoMadeForKids = false)" />
                                <label class="form-check-label small" for="demoNotForKids">No</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="demoKidsRadio" id="demoForKids"
                                       checked="@_demoMadeForKids" @onchange="@(() => _demoMadeForKids = true)" />
                                <label class="form-check-label small" for="demoForKids">Yes</label>
                            </div>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="demoAiDisclosure"
                                   @bind="_demoIsAiSynthetic" />
                            <label class="form-check-label small" for="demoAiDisclosure">
                                Contains AI-generated or synthetic visuals/audio (YouTube disclosure).
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="demoGuidelines"
                                   @bind="_demoAcceptedGuidelines" />
                            <label class="form-check-label small" for="demoGuidelines">
                                I confirm this film is appropriate for a general audience:
                                no NSFW, illegal, hateful, or exploitative content.
                            </label>
                        </div>
                        <div class="form-text">
                            Approved demos are published to YouTube automatically (privacy: public) and embedded
                            on the Demo gallery — no separate upload step.
                        </div>
                        <div class="form-text">
                            Publishing automatically displays your film in the public demo gallery.
                            @if (!string.IsNullOrEmpty(_clientWipUrl))
                            {
                                <span> Uses your browser-stitched preview.</span>
                            }
                            else if (_wipExists && !_wipStale)
                            {
                                <span> Uses the on-disk WIP.</span>
                            }
                        </div>
                    }
                    @if (_saveDestination == "youtube" && _youTubeStatus?.Connected == true)
                    {
                        <div class="mb-2">
                            <label class="form-label small">Title</label>
                            <input class="form-control form-control-sm" @bind="_youTubeTitle" maxlength="100" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Description</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="_youTubeDescription"></textarea>
                        </div>
                        <div class="mb-0">
                            <label class="form-label small">Privacy</label>
                            <select class="form-select form-select-sm" @bind="_youTubePrivacy">
                                <option value="unlisted">Unlisted (link-only)</option>
                                <option value="private">Private</option>
                                <option value="public">Public</option>
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseSaveDialog">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" data-testid="review-save-confirm"
                            disabled="@(_busy
                                        || (_saveDestination == "youtube" && _youTubeStatus?.Connected != true)
                                        || (_saveDestination == "demo" && !_demoAcceptedGuidelines))"
                            @onclick="ConfirmSaveAsync">
                        @(_saveDestination == "youtube" ? "Upload to YouTube" : "Publish to Demo Gallery")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showWipPlayer && _clientStitching)
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            Combining full cut in browser… @_clientStitchStatus
        </div>
    </div>
}
else if (_showWipPlayer && (!string.IsNullOrEmpty(_clientWipUrl) || _wipExists))
{
    <div class="card mb-3 border-success">
        <div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
            <span>
                @if (!string.IsNullOrEmpty(_clientWipUrl))
                {
                    <span>WIP preview <span class="badge bg-info text-dark ms-1">client stitch</span></span>
                }
                else
                {
                    <span>WIP movie <code class="small">@(_wipPath ?? "assets/movie_wip.mp4")</code></span>
                    @if (_wipStale)
                    {
                        <span class="badge bg-warning text-dark ms-1">stale</span>
                    }
                    else
                    {
                        <span class="badge bg-success ms-1">current</span>
                    }
                }
            </span>
            @if (string.IsNullOrEmpty(_clientWipUrl) && !string.IsNullOrEmpty(_wipUpdatedAt))
            {
                <span class="small text-muted">updated @_wipUpdatedAt · @FormatBytes(_wipBytes)</span>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideWipPlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            @if (!string.IsNullOrEmpty(_wipReason) && _wipStale && string.IsNullOrEmpty(_clientWipUrl))
            {
                <p class="small text-warning mb-2">@_wipReason</p>
            }
            <video controls playsinline autoplay
                   style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                   src="@(string.IsNullOrEmpty(_clientWipUrl) ? CacheBust(Engine.WipMovieUrl(_projectId)) : _clientWipUrl)"
                   @key="_wipVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
            @if (string.IsNullOrEmpty(_clientWipUrl))
            {
                <div class="mt-2">
                    <a href="@Engine.WipMovieUrl(_projectId)" target="_blank" rel="noopener" class="small text-muted">Open in new tab</a>
                </div>
            }
        </div>
    </div>
}

@if (_showScenePlayer && _playingScene is int playSn && !_clientStitching)
{
    <div class="card mb-3 border-primary">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Scene
                <code class="small">S@(playSn.ToString("D2"))</code>
                @if (!string.IsNullOrEmpty(_clientSceneUrl))
                {
                    <span class="badge bg-info text-dark ms-1">client stitch</span>
                }
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideScenePlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                   src="@(string.IsNullOrEmpty(_clientSceneUrl) ? CacheBust(Engine.CompositeVideoUrl(_projectId, playSn)) : _clientSceneUrl)"
                   @key="_sceneVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
            <p class="small text-muted mb-0 mt-2">
                @if (string.IsNullOrEmpty(_clientSceneUrl))
                {
                    <a href="@Engine.CompositeVideoUrl(_projectId, playSn)" target="_blank" rel="noopener">Open in new tab</a>
                }
                else
                {
                    <span>Stitched in browser from clips (not written to disk).</span>
                }
            </p>
        </div>
    </div>
}
else if (_showScenePlayer && _clientStitching)
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            Combining scene in browser… @_clientStitchStatus
        </div>
    </div>
}

@if (_showClipPlayer && _playingClipScene is int clipSn && _playingClipNum is int clipCn)
{
    <div class="card mb-3 border-info">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Clip
                <code class="small">S@(clipSn.ToString("D2"))C@(clipCn.ToString("D2"))</code>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideClipPlayer">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:50vh;background:#000;border-radius:0.35rem;"
                   src="@CacheBust(Engine.ClipVideoUrl(_projectId, clipSn, clipCn))"
                   @key="_clipVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
            <p class="small text-muted mb-0 mt-2">
                <a href="@Engine.ClipVideoUrl(_projectId, clipSn, clipCn)" target="_blank" rel="noopener">Open in new tab</a>
                · after regen, <strong>Play scene</strong> stitches the updated cut in the browser
            </p>
        </div>
    </div>
}

@if (_job is not null &&
     (_job.Status is "running" or "done" or "error" or "cancelled") &&
     (_job.Kind is "remux" or "scene" or "batch" or "book_prepare" or "book_import" or "stage1" or "stage2"))
{
    <div class="card mb-3 border-@(_job.Status == "running" ? "primary" : _job.Status == "error" ? "danger" : "secondary")">
        <div class="card-body py-2">
            <span class="badge bg-secondary">@_job.Status</span>
            @if (_job.Kind is { Length: > 0 } k)
            {
                <span class="badge bg-info text-dark ms-1">@k</span>
            }
            @if (_job.Scene is int jsn)
            {
                <span class="ms-1">S@(jsn.ToString("D2"))</span>
            }
            @if (_job.Clip is int jcn)
            {
                <span>C@jcn</span>
            }
            <span class="ms-2 small">@_job.Message</span>
            @if (_job.Total > 0 && string.Equals(_job.Status, "running", StringComparison.OrdinalIgnoreCase))
            {
                @if (KeyFormatting.EstimateTimeRemaining(_job.StartedAt, _job.Index, _job.Total) is { } eta)
                {
                    <span class="ms-2 small text-muted">@eta</span>
                }
                <div class="progress mt-2" style="height:6px">
                    <div class="progress-bar" role="progressbar"
                         style="width:@((_job.Index * 100.0 / Math.Max(1, _job.Total)).ToString("0.#"))%"></div>
                </div>
            }
            @if (_job.Log.Count > 0)
            {
                <pre class="small mb-0 mt-2" style="max-height:160px;overflow:auto;">@string.Join("\n", _job.Log.TakeLast(30))</pre>
            }
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Scenes &amp; clips</span>
                <span class="small text-muted fw-normal">Play stitches in browser · WIP is separate</span>
            </div>
            <div class="card-body p-0">
                @if (_scenes.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No scenes — finish Adaptation first.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="cursor:pointer; user-select:none;" @onclick='() => ToggleSceneSort("number")' title="Sort by scene number">
                                        Scene @(_sceneSortBy == "number" ? (_sceneSortAsc ? "▲" : "▼") : "⇅")
                                    </th>
                                    <th>Clips</th>
                                    <th style="cursor:pointer; user-select:none;" @onclick='() => ToggleSceneSort("duration")' title="Sort by duration">
                                        Dur @(_sceneSortBy == "duration" ? (_sceneSortAsc ? "▲" : "▼") : "⇅")
                                    </th>
                                    <th>Composite</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in SortedReviewScenes)
                                {
                                    var sn = s.SceneNumber;
                                    var clipsDone = s.ClipsComplete || (s.ClipCount > 0 && s.ClipsOnDisk >= s.ClipCount);
                                    <tr class="@(_selectedScene == sn ? "table-active" : "")">
                                        <td class="text-nowrap">
                                            <span class="badge @(clipsDone ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1 rounded-pill"
                                                  style="font-weight:600;cursor:pointer;"
                                                  title="@(clipsDone ? "All clips on disk" : "Missing clips")"
                                                  @onclick="() => SelectSceneAsync(sn)">
                                                S@(sn.ToString("D2"))
                                            </span>
                                            <div class="small text-muted mt-1">@(string.IsNullOrEmpty(s.Setting) ? "—" : s.Setting)</div>
                                        </td>
                                        <td class="small">@s.ClipsOnDisk/@s.ClipCount</td>
                                        <td class="small">
                                            @if (s.ActualDurationSeconds is double ad)
                                            {
                                                <span>@FormatClock(ad)</span>
                                            }
                                            else if (s.PlannedDurationSeconds is double pd)
                                            {
                                                <span class="text-muted">~@FormatClock(pd)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (s.CompositeExists || s.ClipsOnDisk > 0)
                                            {
                                                <span class="badge bg-success">@s.ClipsOnDisk/@s.ClipCount clips</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">—</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                                                <button class="btn btn-sm btn-success"
                                                        disabled="@(_busy || JobRunning || (s.ClipsOnDisk == 0 && !s.CompositeExists))"
                                                        title="Play scene (browser stitch from clips)"
                                                        @onclick="() => PlaySceneAsync(sn)">
                                                    ▶ Play
                                                </button>
                                                @if (s.IsApproved)
                                                {
                                                    <button class="btn btn-sm btn-success"
                                                            disabled="@(_busy || JobRunning)"
                                                            title="Scene is approved. Click to toggle."
                                                            @onclick="() => ApproveAsync(sn)">
                                                        ✓ Approved
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-success"
                                                            disabled="@(_busy || JobRunning)"
                                                            title="Mark scene approved"
                                                            @onclick="() => ApproveAsync(sn)">
                                                        ☐ Approve
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-link"
                                                        @onclick="() => SelectSceneAsync(sn)">
                                                    Clips
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (_selectedScene is int sel)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>S@(sel.ToString("D2")) clip review</span>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-success"
                                disabled="@(_busy || JobRunning || (ClipCountOnDisk(sel) == 0 && !SceneHasComposite(sel)))"
                                title="Play scene (browser stitch from clips)"
                                @onclick="() => PlaySceneAsync(sel)">
                            ▶ Play scene
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label small">Note (required to Pass after auto-review fail)</label>
                        <input class="form-control form-control-sm" @bind="_note" disabled="@_busy"
                               placeholder="Override reason if auto-review failed…" />
                    </div>
                    <div class="d-flex flex-column gap-3">
                        @for (var c = 1; c <= ClipCountFor(sel); c++)
                        {
                            var cn = c;
                            var key = $"S{sel:D2}C{cn:D2}";
                            var st = _reviews.TryGetValue(key, out var r) ? r : "—";
                            var onDisk = ClipOnDisk(sel, cn);
                            var autoBusy = IsAutoReviewRunning(sel, cn);
                            var draft = GetLocalDraft(sel, cn);
                            var editing = _editKey == key;
                            <div class="border rounded p-2 small">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge @(onDisk ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1 rounded-pill"
                                          style="font-weight:600;"
                                          title="@(onDisk ? "On disk" : "Not on disk yet")">
                                        C@(cn.ToString("D2"))
                                    </span>
                                    <span class="badge bg-light text-dark">@st</span>
                                    @if (draft is not null && !editing)
                                    {
                                        <span class="badge bg-info text-dark">AI: @draft.Suggestion</span>
                                    }
                                </div>
                                <div class="btn-group btn-group-sm mt-1 flex-wrap">
                                    <button class="btn btn-outline-dark" disabled="@(_busy || !onDisk)"
                                            title="Play this clip"
                                            @onclick="() => PlayClip(sel, cn)">▶</button>
                                    <button class="btn btn-outline-primary"
                                            data-testid="@($"review-auto-{sel}-{cn}")"
                                            data-scene="@sel"
                                            data-clip="@cn"
                                            disabled="@(_busy || !onDisk || JobRunning || autoBusy)"
                                            title="AI review: this clip + end of previous (does not change files)"
                                            @onclick="() => StartAutoReviewAsync(sel, cn)">
                                        @(autoBusy ? "Reviewing…" : draft is not null && !editing ? "Review again" : "Review")
                                    </button>
                                    @if (draft is not null && !editing && !autoBusy)
                                    {
                                        <button class="btn btn-primary"
                                                data-testid="@($"review-apply-open-{sel}-{cn}")"
                                                disabled="@_busy"
                                                title="Show suggested edits to accept or change"
                                                @onclick="() => OpenApplyPanel(sel, cn)">
                                            Apply suggestions
                                        </button>
                                    }
                                    @if (editing)
                                    {
                                        <button class="btn btn-warning"
                                                data-testid="@($"review-apply-regen-{sel}-{cn}")"
                                                disabled="@(_busy || JobRunning || !HasIncludedEdits())"
                                                title="Save accepted edits and re-generate this clip"
                                                @onclick="() => ApplyAndRegenAsync(sel, cn)">
                                            Apply + regen
                                        </button>
                                        <button class="btn btn-outline-secondary" disabled="@_busy"
                                                @onclick="CloseApplyPanel">Cancel</button>
                                    }
                                    <button class="btn btn-outline-success" data-testid="@($"review-pass-{sel}-{cn}")" disabled="@_busy"
                                            @onclick="() => ReviewAsync(sel, cn, passStatus)">Pass</button>
                                    <button class="btn btn-outline-danger" data-testid="@($"review-fail-{sel}-{cn}")" disabled="@_busy"
                                            @onclick="() => ReviewAsync(sel, cn, failStatus)">Fail</button>
                                </div>
                                @if (autoBusy && _job is not null)
                                {
                                    var pct = _job.Status == "queued" || _job.Total <= 0
                                        ? 8
                                        : (int)Math.Round(100.0 * Math.Clamp(_job.Index, 0, _job.Total) / Math.Max(1, _job.Total));
                                    if (_job.Status == "running" && _job.Index <= 0) pct = 0;
                                    <div class="mt-2">
                                        <div class="d-flex justify-content-between text-muted">
                                            <span>@(_job.Message ?? "Reviewing…")</span>
                                            @if (_job.Total == 100 && _job.Status == "running")
                                            {
                                                <span>@_job.Index%</span>
                                            }
                                        </div>
                                        <div class="progress mt-1" style="height: 0.45rem;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                                 style="width: @(pct)%"></div>
                                        </div>
                                    </div>
                                }
                                @if (draft is not null && !editing && !autoBusy)
                                {
                                    <div class="form-text mt-1">
                                        @draft.Note
                                        @if (draft.IncludedPreviousTail)
                                        {
                                            <span class="text-muted"> · continuity: @draft.Continuity</span>
                                        }
                                        @if (draft.Suggestions.Count > 0)
                                        {
                                            <span> · @draft.Suggestions.Count suggestion(s)</span>
                                        }
                                    </div>
                                }
                                @if (editing && _editRows is not null)
                                {
                                    <div class="mt-2 border-top pt-2">
                                        @if (!string.IsNullOrEmpty(draft?.Note))
                                        {
                                            <div class="mb-2 text-muted">@draft!.Note</div>
                                        }
                                        @if (_editRows.Count == 0)
                                        {
                                            <p class="text-muted mb-1">No field changes suggested. You can Pass or Apply + regen as-is.</p>
                                        }
                                        @foreach (var row in _editRows)
                                        {
                                            <div class="border rounded p-2 mb-2 bg-light">
                                                <div class="form-check mb-1">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="@row.Id" @bind="row.Include" disabled="@_busy" />
                                                    <label class="form-check-label" for="@row.Id">
                                                        <strong>@row.Label</strong>
                                                        <span class="text-muted">(@row.Layer@(string.IsNullOrEmpty(row.CharKey) ? "" : " · " + row.CharKey))</span>
                                                    </label>
                                                </div>
                                                @if (!string.IsNullOrEmpty(row.Rationale))
                                                {
                                                    <div class="text-muted mb-1">@row.Rationale</div>
                                                }
                                                @if (!string.IsNullOrEmpty(row.CurrentValue))
                                                {
                                                    <div class="mb-1">
                                                        <span class="text-muted">Current:</span>
                                                        <div class="small" style="max-height:4rem;overflow:auto;white-space:pre-wrap;">@row.CurrentValue</div>
                                                    </div>
                                                }
                                                <label class="form-label small mb-0">Suggested (editable)</label>
                                                <textarea class="form-control form-control-sm" rows="3"
                                                          @bind="row.Value" disabled="@(_busy || !row.Include)"></textarea>
                                            </div>
                                        }
                                        <p class="form-text mb-0">
                                            Check what to keep, edit text if needed, then <strong>Apply + regen</strong> saves and re-generates this clip.
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <p class="small text-muted mb-0 mt-3">
                        <strong>Review</strong> drafts AI feedback (includes previous clip end when C2+).
                        <strong>Apply suggestions</strong> shows edits; <strong>Apply + regen</strong> writes them and re-gens.
                        <strong>Play scene</strong> / <strong>Play WIP</strong> stitch in the browser when needed (no server ffmpeg for preview).
                    </p>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mt-3 border-secondary-subtle">
    <div class="card-header py-2 bg-transparent">
        <button type="button"
                class="btn btn-link text-decoration-none text-body p-0 d-flex align-items-center gap-2 w-100 text-start"
                @onclick="() => _showActivity = !_showActivity"
                aria-expanded="@_showActivity">
            <span class="small text-muted" style="width:1rem;display:inline-block;">@(_showActivity ? "▾" : "▸")</span>
            <span>Activity / history</span>
            <span class="badge bg-light text-dark border ms-1">@_entries.Count</span>
            <span class="small text-muted ms-auto fw-normal">audit trail of pass / fail / approve</span>
        </button>
    </div>
    @if (_showActivity)
    {
        <div class="card-body p-0 border-top">
            @if (_entries.Count == 0)
            {
                <p class="text-muted p-3 mb-0">No entries yet.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var e in _entries.Take(40))
                    {
                        <li class="list-group-item small">
                            <div class="d-flex justify-content-between">
                                <span class="badge bg-secondary">@e.Type</span>
                                <span class="text-muted">@e.Ts</span>
                            </div>
                            <div>
                                @if (e.Scene is int sn)
                                {
                                    <code>S@(sn.ToString("D2"))</code>
                                    @if (e.Clip is int cn)
                                    {
                                        <code class="ms-1">C@(cn.ToString("D2"))</code>
                                    }
                                }
                                <span class="ms-1">@e.UserNote</span>
                            </div>
                            @if (!string.IsNullOrEmpty(e.SuggestedRule))
                            {
                                <div class="text-muted">@e.SuggestedRule</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>
} @* end _activeTab == "review" *@
else if (_activeTab == "play")
{
    <div class="card mb-3 border-success shadow-lg text-white" style="background-color: #0f172a !important; border-color: #10b981 !important;">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2.5" style="background-color: #1e293b !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">🎬</span>
                <span class="fw-bold fs-6">Full Movie Player</span>
                @if (string.IsNullOrEmpty(_clientWipUrl) && !string.IsNullOrEmpty(_wipUpdatedAt))
                {
                    <span class="badge bg-dark border border-secondary text-white-50">updated @_wipUpdatedAt · @FormatBytes(_wipBytes)</span>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SetTabReview">Back to Review</button>
        </div>
        <div class="card-body p-3">
            @if (_clientStitching)
            {
                <div class="p-5 text-center text-info">
                    <div class="spinner-border text-info me-2" role="status"></div>
                    <div class="fw-semibold mt-2">Stitching full movie preview in browser…</div>
                    <div class="small text-muted mt-1">@_clientStitchStatus</div>
                </div>
            }
            else
            {
                <video controls playsinline autoplay
                       style="width:100%;max-height:75vh;background:#000;border-radius:0.5rem;"
                       src="@(string.IsNullOrEmpty(_clientWipUrl) ? CacheBust(Engine.WipMovieUrl(_projectId)) : _clientWipUrl)"
                       @key="_wipVideoKey">
                    Your browser does not support HTML5 video.
                </video>
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary flex-wrap gap-2">
                    <span class="small text-muted">
                        @if (!string.IsNullOrEmpty(_clientWipUrl))
                        {
                            <span>Stitched directly in browser from scene clips</span>
                        }
                        else
                        {
                            <span>Saved movie file on server</span>
                        }
                    </span>
                    <div class="d-flex gap-2">
                        @if (string.IsNullOrEmpty(_clientWipUrl))
                        {
                            <a href="@Engine.WipMovieUrl(_projectId)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">Open MP4 in new tab</a>
                        }
                        <button type="button" class="btn btn-sm btn-info text-white" @onclick="SetTabShare">
                            Share film →
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (_activeTab == "share")
{
    <div class="card mb-3 border-info text-white shadow-sm" style="background-color: #0f172a !important; border-color: #3b82f6 !important;" data-testid="review-share-card">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2.5" style="background-color: #1e293b !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📤</span>
                <span class="fw-bold fs-6">Share &amp; Export Film</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SetTabReview">Back to Review</button>
        </div>
        <div class="card-body p-4 text-white">
            <div class="mb-4">
                <label class="form-label fw-semibold text-info mb-2">Publish Destination</label>
                <div class="d-flex flex-column gap-2">
                    <label class="form-check p-3 rounded border border-secondary bg-dark mb-0 cursor-pointer">
                        <input class="form-check-input" type="radio" name="saveDest" value="demo"
                               checked="@(_saveDestination == "demo")"
                               @onchange="@(() => _saveDestination = "demo")" />
                        <span class="form-check-label ms-2">
                            <strong>Public Demo Gallery</strong> — Publish film to the public gallery
                        </span>
                    </label>
                    <label class="form-check p-3 rounded border border-secondary bg-dark mb-0 cursor-pointer">
                        <input class="form-check-input" type="radio" name="saveDest" value="youtube"
                               checked="@(_saveDestination == "youtube")"
                               disabled="@(_youTubeStatus?.Connected != true)"
                               @onchange="@(() => _saveDestination = "youtube")" />
                        <span class="form-check-label ms-2">
                            <strong>YouTube Channel</strong> — Upload directly to your YouTube account
                            @if (_youTubeStatus?.Connected != true)
                            {
                                <span class="text-muted ms-1">(channel not connected)</span>
                            }
                        </span>
                    </label>
                </div>
            </div>

            @if (_saveDestination == "demo")
            {
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Film Title</label>
                    <input class="form-control bg-dark text-white border-secondary" @bind="_demoTitle" maxlength="120"
                           placeholder="e.g. The Tell-Tale Heart" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">About this film</label>
                    <textarea class="form-control bg-dark text-white border-secondary" rows="3" @bind="_demoDescription"
                              placeholder="A short description for the gallery wall..." maxlength="800"></textarea>
                </div>
                <div class="mb-3">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="demoAiDisclosure" @bind="_demoIsAiSynthetic" />
                        <label class="form-check-label small" for="demoAiDisclosure">
                            Contains AI-generated visuals or audio.
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="demoGuidelines" @bind="_demoAcceptedGuidelines" />
                        <label class="form-check-label small" for="demoGuidelines">
                            I confirm this film is appropriate for a general audience.
                        </label>
                    </div>
                </div>
            }
            @if (_saveDestination == "youtube" && _youTubeStatus?.Connected == true)
            {
                <div class="mb-3">
                    <label class="form-label small fw-semibold">YouTube Title</label>
                    <input class="form-control bg-dark text-white border-secondary" @bind="_youTubeTitle" maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">YouTube Description</label>
                    <textarea class="form-control bg-dark text-white border-secondary" rows="3" @bind="_youTubeDescription"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Privacy Setting</label>
                    <select class="form-select bg-dark text-white border-secondary" @bind="_youTubePrivacy">
                        <option value="unlisted">Unlisted (link-only)</option>
                        <option value="private">Private</option>
                        <option value="public">Public</option>
                    </select>
                </div>
            }

            <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary">
                <button type="button" class="btn btn-outline-secondary" @onclick="SetTabReview">Cancel</button>
                <button type="button" class="btn btn-primary px-4" data-testid="review-save-confirm"
                        disabled="@(_busy || (_saveDestination == "youtube" && _youTubeStatus?.Connected != true) || (_saveDestination == "demo" && !_demoAcceptedGuidelines))"
                        @onclick="ConfirmSaveAsync">
                    @(_saveDestination == "youtube" ? "Upload to YouTube" : "Publish to Demo Gallery")
                </button>
            </div>
        </div>
    </div>
}
} @* end CanReview gate *@

@code {
    private bool _busy;
    private bool _gateChecked;
    private string? _error;
    private string? _message;
    private string _projectId = "";
    private List<SceneSummary> _scenes = new();
    private string _sceneSortBy = "number"; // "number" | "duration"
    private bool _sceneSortAsc = true;

    private void ToggleSceneSort(string column)
    {
        if (_sceneSortBy == column)
            _sceneSortAsc = !_sceneSortAsc;
        else
        {
            _sceneSortBy = column;
            _sceneSortAsc = true;
        }
    }

    private IEnumerable<SceneSummary> SortedReviewScenes
    {
        get
        {
            return _sceneSortBy switch
            {
                "duration" => _sceneSortAsc
                    ? _scenes.OrderBy(s => s.ActualDurationSeconds ?? s.PlannedDurationSeconds ?? 0)
                    : _scenes.OrderByDescending(s => s.ActualDurationSeconds ?? s.PlannedDurationSeconds ?? 0),
                _ => _sceneSortAsc
                    ? _scenes.OrderBy(s => s.SceneNumber)
                    : _scenes.OrderByDescending(s => s.SceneNumber),
            };
        }
    }

    private static string FormatClock(double seconds)
    {
        if (seconds < 0 || double.IsNaN(seconds) || double.IsInfinity(seconds))
            return "—";
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}:{t.Minutes:D2}:{t.Seconds:D2}"
            : $"{t.Minutes}:{t.Seconds:D2}";
    }

    private string? _activeTab = "review"; // null | "review" | "play" | "share"

    private void ToggleTab(string tab)
    {
        if (_activeTab == tab)
        {
            _activeTab = null; // Toggle off / collapse card
        }
        else
        {
            _activeTab = tab;
            if (tab == "share")
            {
                _showSaveDialog = true;
            }
        }
    }

    private void SetTabReview() => ToggleTab("review");
    private void SetTabShare() => ToggleTab("share");

    private bool CanPlayMovie =>
        _wipExists || _wipCanBuild || MediaFolder.IsConnected || MediaFolder.IsSyncing || _scenes.Any(s => s.CompositeExists || s.ClipsOnDisk > 0);

    private SceneDetail? _selectedDetail;
    private bool _wipExists;
    private bool _wipStale;
    private bool _wipCanBuild;
    private string? _wipReason;
    private bool _showWipPlayer;
    private bool _playWipAfterRemux;
    private int? _playSceneAfterRemux;
    private string? _wipPath;
    private string? _wipUpdatedAt;
    private long _wipBytes;
    private readonly HashSet<string> _expandedSceneGroups = new(StringComparer.OrdinalIgnoreCase);

    private bool IsSceneGroupExpanded(string rangeStr) => _expandedSceneGroups.Contains(rangeStr);

    private void ToggleSceneGroupExpand(string rangeStr)
    {
        if (!_expandedSceneGroups.Add(rangeStr))
            _expandedSceneGroups.Remove(rangeStr);
    }

    private void ToggleAllSceneGroups(bool expand)
    {
        _expandedSceneGroups.Clear();
        if (expand && _movieReport?.GroupFeedback is { Count: > 0 } groups)
        {
            foreach (var g in groups)
                _expandedSceneGroups.Add(g.SceneRange);
        }
    }
    private long _wipVideoKey;
    private YouTubeStatusDto? _youTubeStatus;
    private YouTubeUploadInfo? _youTubeUpload;
    private bool _showSaveDialog;
    private string _saveDestination = "demo"; // "demo" | "youtube"
    private string _youTubeTitle = "";
    private string _youTubeDescription = "";
    private string _youTubePrivacy = "unlisted";
    private string _demoTitle = "";
    private string _demoDescription = "";
    private bool _demoAcceptedGuidelines;
    private bool _demoMadeForKids;
