            static double Dur(ClipSummary c) =>
                c.ActualDurationSeconds ?? (c.DurationSeconds > 0 ? c.DurationSeconds : 0);
            return _clipSortAscending
                ? _detail.Clips.OrderBy(Dur).ThenBy(c => c.ClipNumber)
