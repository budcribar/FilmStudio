            }
            if (_castMissing is not null)
            {
                foreach (var c in _castMissing)
                    if (!string.IsNullOrWhiteSpace(c)) set.Add(c);
            }
            return set.OrderBy(c => ShortChar(c), StringComparer.OrdinalIgnoreCase).ToList();
