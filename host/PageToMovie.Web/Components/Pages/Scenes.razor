    }

    public async ValueTask DisposeAsync()
    {
        Hub.JobUpdated -= OnJobUpdated;
        Hub.JobLog -= OnJobLog;
        MediaFolder.Changed -= OnMediaFolderChanged;
        _clientPreviewUrl = null;
        _clientSceneUrl = null;
        await Stitch.RevokePreviewUrlAsync();
    }
