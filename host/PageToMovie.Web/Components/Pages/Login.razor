@page "/login"
@page "/signup"
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities
@using PageToMovie.Core.Options

<PageTitle>@PageTitleText — PageToMovie</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo d-flex align-items-center justify-content-center gap-3 mb-3">
                <img src="/favicon.png" alt="PageToMovie" width="64" height="64" class="rounded-3 shadow" />
                <span class="logo-text fs-2 fw-bold mb-0">PageToMovie</span>
            </div>
            <p class="auth-subtitle">
                @if (_resetTokenMode)
                {
                    <text>Choose a new password for your account.</text>
                }
                else if (_forgotMode)
                {
                    <text>Enter your username or email — we’ll send a reset link if the account has a confirmed address.</text>
                }
                else if (_isSignup)
                {
                    <text>Create your account to start generating films</text>
                }
                else
                {
                    <text>Sign in with your handle or email</text>
                }

            </p>
        </div>

        @if (_busy && string.IsNullOrEmpty(_error) && string.IsNullOrEmpty(_info))
        {
            <div class="auth-status text-center py-4">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Loading…</span>
                </div>
                <p class="text-muted mb-0">@_status</p>
            </div>
        }
        else if (_resetTokenMode)
        {
            <form class="auth-form" @onsubmit="SubmitResetWithTokenAsync">
                <div class="mb-3">
                    <label class="form-label" for="reset-password-input">New password</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">🔒</span>
                        <input id="reset-password-input"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control"
                               @bind="_password"
                               @bind:event="oninput"
                               placeholder="New password"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="btn btn-outline-secondary password-toggle"
                                @onclick="ToggleShowPassword"
                                title="@(_showPassword ? "Hide password" : "Show password")"
                                aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                aria-pressed="@_showPassword">
                            @(_showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="reset-confirm-input">Confirm new password</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">✓</span>
                        <input id="reset-confirm-input"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control"
                               @bind="_confirmPassword"
                               @bind:event="oninput"
                               placeholder="Confirm password"
                               autocomplete="new-password"
                               required />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2" role="alert">@_error</div>
                }
                @if (!string.IsNullOrEmpty(_info))
                {
                    <div class="alert alert-success py-2" role="alert">@_info</div>
                }

                <button type="submit" class="btn btn-gradient w-100 py-2 mt-2" disabled="@_busy">
                    @(_busy ? "Updating…" : "Set new password")
                </button>
                <button type="button" class="btn btn-link w-100 mt-2 text-decoration-none" @onclick="ExitResetTokenMode">
                    ← Back to sign in
                </button>
            </form>
        }
        else if (_forgotMode)
        {
            <form class="auth-form" @onsubmit="SubmitForgotAsync">
                <div class="mb-3">
                    <label class="form-label" for="forgot-username">Username or email</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">👤</span>
                        <input id="forgot-username"
                               class="form-control"
                               @bind="_username"
                               @bind:event="oninput"
                               placeholder="username or you@example.com"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2" role="alert">@_error</div>
                }
                @if (!string.IsNullOrEmpty(_info))
                {
                    <div class="alert alert-success py-2" role="alert">@_info</div>
                }

                <button type="submit" class="btn btn-gradient w-100 py-2 mt-2" disabled="@_busy">
                    @(_busy ? "Submitting…" : "Send reset link")
                </button>
                <button type="button" class="btn btn-link w-100 mt-2 text-decoration-none" @onclick="ExitForgotMode">
                    ← Back to sign in
                </button>
            </form>
        }
        else
        {
            <form class="auth-form" @onsubmit="SubmitAsync">
                <div class="mb-3">
                    <label class="form-label" for="username-input">Username</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">👤</span>
                        <input id="username-input" class="form-control" @bind="_username" @bind:event="oninput" placeholder="Enter username" autocomplete="username" required />
                    </div>
                </div>

                @if (_isSignup)
                {
                    <div class="mb-3">
                        <label class="form-label" for="email-input">Email</label>
                        <div class="input-group">
                            <span class="input-group-text" aria-hidden="true">✉</span>
                            <input id="email-input"
                                   type="email"
                                   class="form-control"
                                   @bind="_email"
                                   @bind:event="oninput"
                                   placeholder="you@example.com"
                                   autocomplete="email"
                                   required />
                        </div>
                        <div class="form-text text-muted">
                            We’ll send a confirmation link before you can sign in.
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label" for="password-input">Password</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">🔒</span>
                        <input id="password-input"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control"
                               @bind="_password"
                               @bind:event="oninput"
                               placeholder="Enter password"
                               autocomplete="@(_isSignup ? "new-password" : "current-password")"
                               required />
                        <button type="button"
                                class="btn btn-outline-secondary password-toggle"
                                @onclick="ToggleShowPassword"
                                title="@(_showPassword ? "Hide password" : "Show password")"
                                aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                aria-pressed="@_showPassword">
                            @(_showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                @if (_isSignup)
                {
                    <div class="mb-3">
                        <label class="form-label" for="confirm-password-input">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text" aria-hidden="true">✓</span>
                            <input id="confirm-password-input"
                                   type="@(_showPassword ? "text" : "password")"
                                   class="form-control"
                                   @bind="_confirmPassword"
                                   @bind:event="oninput"
                                   placeholder="Confirm password"
                                   autocomplete="new-password"
                                   required />
                            <button type="button"
                                    class="btn btn-outline-secondary password-toggle"
                                    @onclick="ToggleShowPassword"
                                    title="@(_showPassword ? "Hide password" : "Show password")"
                                    aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                    aria-pressed="@_showPassword">
                                @(_showPassword ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger d-flex align-items-start py-2" role="alert">
                        <div>
                            <div>@_error</div>
                            @if (_needsResend)
                            {
                                <button type="button"
                                        class="btn btn-link btn-sm p-0 mt-1"
                                        disabled="@_busy"
                                        @onclick="ResendConfirmationAsync">
                                    Resend confirmation email
                                </button>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_info))
                {
                    <div class="alert alert-success py-2" role="alert">
                        <div>@_info</div>
                        @if (_needsResend)
                        {
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 mt-1"
                                    disabled="@_busy"
                                    @onclick="ResendConfirmationAsync">
                                Resend confirmation email
                            </button>
                        }
                    </div>
                }

                <button type="submit" class="btn btn-gradient w-100 py-2 mt-2" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>@(_isSignup ? "Creating account…" : "Signing in…")</span>
                    }
                    else
                    {
                        <span>@(_isSignup ? "Create Account" : "Sign In")</span>
                    }
                </button>

                @if (!_isSignup)
                {
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="EnterForgotMode">
                            Forgot password?
                        </button>
                    </div>
                }
            </form>
        }

        <div class="auth-footer text-center mt-4">
            @if (_resetTokenMode || _forgotMode)
            {
                <span class="text-muted small">Remembered it? </span>
                <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="BackToSignIn">
                    Sign in
                </button>
            }
            else if (!_isSignup)
            {
                <span class="text-muted">Don't have an account yet? </span>
                <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => SetMode(true)">
                    Sign up now
                </button>
            }
            else
            {
                <span class="text-muted">Already have an account? </span>
                <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => SetMode(false)">
                    Sign in
                </button>
            }
            <div class="mt-3">
                <a href="/demo" class="small text-decoration-none">Watch public demos — no sign-in required</a>
            </div>
        </div>
    </div>
</div>

<style>
