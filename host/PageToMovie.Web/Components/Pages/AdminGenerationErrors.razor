@page "/admin/generation-errors"

<PageTitle>Generation errors — admin</PageTitle>

<div class="container py-3" style="max-width: 76rem;">
    <AdminPageHeader Title="Generation errors">
        <Subtitle>
            Transient-retry and partial-coverage events across every classifier/provider call
            (<code>generation_errors</code>).
        </Subtitle>
        <Actions>
            <a href="/admin" class="btn btn-sm btn-outline-secondary">← Admin</a>
            <button class="btn btn-sm btn-primary" data-testid="gen-errors-refresh"
                    disabled="@_loading" @onclick="LoadAsync">
                @(_loading ? "Loading…" : "Refresh")
            </button>
        </Actions>
    </AdminPageHeader>

    @if (!Session.IsAdmin)
    {
        <InlineAlert Variant="warning">Admin session required. <a href="/admin/login">Sign in</a></InlineAlert>
    }
    else if (_error is not null)
    {
        <InlineAlert Message="@_error" data-testid="gen-errors-error" />
    }
    else if (_loading && _rows.Count == 0)
    {
        <div class="text-muted">Loading…</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="alert alert-info" data-testid="gen-errors-empty">
            No generation-error events logged yet — this fills in as transient retries or partial-coverage
            gaps happen during real (or fakes-mode) generation.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle" data-testid="gen-errors-table">
                <thead><tr>
                    <th>When</th><th>Stage</th><th>Model</th><th>Type</th>
                    <th class="text-end">HTTP</th><th class="text-end">Attempt</th>
                    <th>Resolved</th><th>Detail</th>
                </tr></thead>
                <tbody>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td class="text-nowrap small text-muted">@r.Ts</td>
                            <td><code>@r.Stage</code></td>
                            <td class="small">@r.Model</td>
                            <td><span class="badge text-bg-secondary">@r.ErrorType</span></td>
                            <td class="text-end">@(r.HttpStatus?.ToString() ?? "—")</td>
                            <td class="text-end">@r.Attempt</td>
                            <td>
                                @if (r.Resolved)
                                {
                                    <span class="badge text-bg-success">resolved</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">open</span>
                                }
                            </td>
                            <td class="small text-muted">@r.ErrorMessage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
