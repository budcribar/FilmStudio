@page "/cost"
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject NavigationManager Nav
@using PageToMovie.Core.Models
@using System.Globalization

<PageTitle>Estimate & cost</PageTitle>

<div class="ptm-page-head mb-3">
    <span class="ptm-adapt-kicker">Studio · Step 4 · Confirm</span>
    <h1 class="ptm-adapt-title mb-1">Estimate & cost</h1>
    <p class="ptm-adapt-lede mb-0">
        See what this film is planned to cost, what you’ve spent so far, and where the money went.
    </p>
</div>

<StudioProcessStrip Active="estimate" />

@if (!ActiveProject.CanEstimate)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <strong>Estimate locked.</strong>
            @ActiveProject.EstimateBlockedReason
        </div>
        <a class="btn btn-sm btn-warning fw-semibold" href="adaptation">Go to Book →</a>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success">@_message</div>
    }

    <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <div style="min-width: 12rem;">
            <label class="form-label small mb-0">Project</label>
            <select class="form-select form-select-sm" @bind="_projectId" @bind:after="LoadAsync" disabled="@_busy">
                @foreach (var p in _projectIds)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small mb-0">Video resolution</label>
            <div class="btn-group" role="group" aria-label="Video resolution">
                @foreach (var res in new[] { "480p", "720p", "1080p" })
                {
                    <button type="button"
                            class="btn btn-sm @(_draftRes == res ? "btn-primary" : "btn-outline-secondary")"
                            data-testid="@($"cost-res-{res}")"
                            disabled="@_busy"
                            @onclick="() => SetDraftResolutionAsync(res)">
                        @res
                    </button>
                }
            </div>
        </div>
        <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
    </div>

    @if (_report is null)
    {
        <p class="text-muted">Loading…</p>
    }
    else
    {
        var s = _report.Summary;
        var slices = BuildSpentSlices();
        var totalSpent = slices.Sum(x => x.Usd);
        var estSlices = BuildEstimateSlices();
        var estTotal = estSlices.Sum(x => x.Usd);
        var estimate = s.FullFilmAllDraftUsd;

        @* —— Simple top summary —— *@
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100 cost-hero-card">
                    <div class="card-body text-center py-4">
                        <div class="text-muted small text-uppercase mb-1">Estimate</div>
                        <div class="display-6 fs-2 cost-hero-num" data-testid="cost-estimate">@Usd(estimate)</div>
                        <div class="small text-muted mt-1">
                            Full film · <strong>@_report.DraftResolution</strong>
                            @if (_report.OutputRateDraft > 0)
                            {
                                <span> · @Usd(_report.OutputRateDraft)/sec video</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 cost-hero-card">
                    <div class="card-body text-center py-4">
                        <div class="text-muted small text-uppercase mb-1">Spent</div>
                        <div class="display-6 fs-2 cost-hero-num" data-testid="cost-spent">@Usd(s.ActualUsd)</div>
                        <div class="small text-muted mt-1">So far on this project</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 cost-hero-card">
                    <div class="card-body text-center py-4">
                        <div class="text-muted small text-uppercase mb-1">Remaining</div>
                        <div class="display-6 fs-2 cost-hero-num" data-testid="cost-remaining">
                            @Usd(Math.Max(0, estimate - s.ActualUsd))
                        </div>
                        <div class="small text-muted mt-1">Estimate − spent</div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_report.Notes))
        {
            <p class="small text-muted mb-3" data-testid="cost-estimate-basis">@_report.Notes</p>
        }
        <div class="small text-muted mb-3 d-flex flex-wrap gap-2">
            @if (!string.IsNullOrWhiteSpace(_report.ModelName))
            {
                <span class="badge text-bg-secondary fw-normal">Video · @_report.ModelName</span>
            }
            @if (!string.IsNullOrWhiteSpace(_report.ImageModelName))
            {
                <span class="badge text-bg-secondary fw-normal">Portraits · @_report.ImageModelName</span>
            }
            @if (!string.IsNullOrWhiteSpace(_report.PlanningModelName))
            {
                <span class="badge text-bg-secondary fw-normal">Planning · @_report.PlanningModelName</span>
            }
            @if (_report.VoiceIncludedInEstimate && !string.IsNullOrWhiteSpace(_report.VoiceModelName))
            {
                <span class="badge text-bg-secondary fw-normal">Voice · @_report.VoiceModelName</span>
            }
            else
            {
                <span class="badge text-bg-dark border border-secondary fw-normal text-muted">Voice · not in estimate</span>
            }
            <span class="badge text-bg-primary fw-normal" data-testid="cost-res-badge">
                Video · @_report.DraftResolution · @Usd(_report.OutputRateDraft)/sec
            </span>
        </div>

        @if (_report.Scenarios.Count > 0)
        {
            <div class="card mb-3 border-secondary border-opacity-25">
                <div class="card-body py-2">
                    <div class="small text-muted mb-2">Video cost changes a lot with resolution — pick one:</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var r in _report.Scenarios)
                        {
                            var active = string.Equals(r.Resolution, _draftRes, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="btn btn-sm @(active ? "btn-primary" : "btn-outline-secondary")"
                                    disabled="@_busy"
                                    @onclick="() => SetDraftResolutionAsync(r.Resolution)">
                                <span class="fw-semibold">@r.Resolution</span>
                                <span class="ms-1">@Usd(r.FullFilmUsd)</span>
                                <span class="text-muted ms-1 small">(@Usd(r.RatePerSec)/s)</span>
                            </button>
                        }
                    </div>
                    <div class="form-text mb-0">
                        Full-film numbers above include cast, planning, and optional voice; these chips are video-heavy scenarios at catalog rates for the selected video model.
                    </div>
                </div>
            </div>
        }

        @* —— Estimate pie —— *@
        <div class="card mb-4">
            <div class="card-body">
                <div class="fw-semibold mb-1">Planned cost breakdown</div>
                <p class="small text-muted mb-3">
                    @if (string.Equals(_report.EstimateBasis, "none", StringComparison.OrdinalIgnoreCase))
                    {
                        <span>Import a book so we can size the film. Estimates use your selected models.</span>
                    }
                    else if (string.Equals(_report.EstimateBasis, "screenplay", StringComparison.OrdinalIgnoreCase))
                    {
                        <span>From the imported screenplay (scene lengths). Refines after the shot plan and cast choices.</span>
                    }
                    else
                    {
                        <span>From the shot plan and current cast / voice choices. Model rates from Settings.</span>
                    }
                </p>
                <div class="row g-4 align-items-center">
                    <div class="col-md-5 d-flex justify-content-center">
                        @RenderPie(estSlices, estTotal, "Estimate", "cost-estimate-pie")
                    </div>
                    <div class="col-md-7">
                        @RenderLegend(estSlices, estTotal)
                    </div>
                </div>
            </div>
        </div>

        @* —— Spent pie + legend —— *@
        <div class="card mb-4">
            <div class="card-body">
                <div class="fw-semibold mb-1">Where spend went</div>
                <p class="small text-muted mb-3">
                    Tracked work so far. Open a category for details.
                </p>
                <div class="row g-4 align-items-center">
                    <div class="col-md-5 d-flex justify-content-center">
                        @RenderPie(slices, totalSpent, "Spent", "cost-spent-pie")
                    </div>
                    <div class="col-md-7">
                        @RenderLegend(slices, totalSpent)
                    </div>
                </div>
            </div>
        </div>

        @* —— Expandable category cards —— *@
        <div class="fw-semibold mb-2">Categories</div>
        <div class="vstack gap-2 mb-4">
            @foreach (var slice in slices)
            {
                var open = _openCategory == slice.Id;
                var events = EventsForCategory(slice.Id);
                <div class="card cost-cat-card" data-testid="@($"cost-cat-{slice.Id}")">
                    <button type="button"
                            class="cost-cat-toggle btn btn-link text-start text-decoration-none w-100 px-3 py-3"
                            @onclick="() => ToggleCategory(slice.Id)">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <span class="d-flex align-items-center gap-2 min-w-0">
                                <span class="cost-swatch" style="background:@slice.Color"></span>
                                <span class="fw-semibold text-body">@slice.Label</span>
                                <span class="badge text-bg-secondary fw-normal">@events.Count</span>
                            </span>
                            <span class="d-flex align-items-center gap-2 flex-shrink-0">
                                <strong class="text-body">@Usd(slice.Usd)</strong>
                                <span class="text-muted small">@(open ? "▴" : "▾")</span>
                            </span>
                        </div>
                    </button>
                    @if (open)
                    {
                        <div class="border-top px-3 pb-3">
                            @if (events.Count == 0)
                            {
                                <p class="small text-muted mb-0 pt-2">Nothing tracked in this category yet.</p>
                            }
                            else
                            {
                                <div class="table-responsive pt-2">
                                    <table class="table table-sm mb-0 align-middle">
                                        <thead>
                                            <tr class="small text-muted">
                                                <th>When</th>
                                                <th>Detail</th>
                                                <th class="text-end">Cost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var e in events)
                                            {
                                                <tr>
                                                    <td class="small text-nowrap">@FormatTs(e.Ts)</td>
                                                    <td class="small">
                                                        @EventDetail(e)
                                                    </td>
                                                    <td class="small text-end text-nowrap">@Usd(e.Usd)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* —— Advanced (collapsed) —— *@
        <div class="card mb-3">
            <button type="button"
                    class="btn btn-link text-start text-decoration-none w-100 px-3 py-2 d-flex justify-content-between align-items-center"
                    @onclick="() => _showAdvanced = !_showAdvanced">
                <span class="small fw-semibold text-body">More options</span>
                <span class="text-muted small">@(_showAdvanced ? "▴" : "▾")</span>
            </button>
            @if (_showAdvanced)
            {
                <div class="card-body border-top pt-3">
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-0">Draft res</label>
                            <select class="form-select form-select-sm" value="@_draftRes"
                                    @onchange="OnAdvancedDraftResAsync" disabled="@_busy">
                                <option value="480p">480p</option>
                                <option value="720p">720p</option>
                                <option value="1080p">1080p</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-0">Hero res</label>
                            <select class="form-select form-select-sm" @bind="_heroRes" @bind:after="LoadAsync" disabled="@_busy">
                                <option value="720p">720p</option>
                                <option value="1080p">1080p</option>
                                <option value="480p">480p</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-0">Avg retries</label>
                            <input type="number" class="form-control form-control-sm" min="0" max="3" step="0.25"
                                   @bind="_retries" @bind:after="LoadAsync" disabled="@_busy" />
                        </div>
                        <div class="col-6 col-md-3">
                            <button class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="BackfillAsync">
                                Rebuild spend from clips
                            </button>
                        </div>
                    </div>

                    <div class="small text-muted mb-2">
                        Clips @s.ClipsOnDisk / @s.ClipsTotal
                        · Scenes with media @s.ScenesWithMedia / @s.ScenesTotal
                    </div>
                    <div class="progress mb-3" style="height: 0.65rem;">
                        <div class="progress-bar" role="progressbar"
                             style="width: @(ProgressPct(s))%"></div>
                    </div>

                    @if (_report.Scenarios.Count > 0)
                    {
                        <div class="fw-semibold small mb-2">Resolution scenarios</div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Scenario</th>
                                        <th class="text-end">Full film</th>
                                        <th class="text-end">Still to generate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in _report.Scenarios)
                                    {
                                        <tr>
                                            <td>@r.Label</td>
                                            <td class="text-end">@Usd(r.FullFilmUsd)</td>
                                            <td class="text-end">@Usd(r.RemainingMissingUsd)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private bool _busy;
    private string? _error;
    private string? _message;
    private string _projectId = "";
    private List<string> _projectIds = new();
    private CostReport? _report;
    private string _draftRes = "480p";
    private string _heroRes = "720p";
    private double _retries = 0.5;
    private string? _openCategory;
    private bool _showAdvanced;

    private static readonly (string Id, string Label, string Color)[] Categories =
    {
        ("screenplay", "Screenplay & planning", "#38bdf8"),
        ("characters", "Character generation", "#a78bfa"),
        ("video", "Video generation", "#34d399"),
        ("voice", "Voice & dialogue audio", "#fbbf24"),
        ("music", "Music generation", "#f472b6"),
        ("other", "Other", "#94a3b8"),
    };

    private sealed record CostSlice(string Id, string Label, double Usd, string Color);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var projs = await Engine.GetProjectsAsync();
            _projectIds = projs?.Projects.Select(p => p.Id ?? "").Where(s => s.Length > 0).ToList()
                          ?? new List<string>();
            if (projs?.Active?.Id is { Length: > 0 } aid &&
                _projectIds.Exists(id => string.Equals(id, aid, StringComparison.OrdinalIgnoreCase)))
                _projectId = aid;
            else if (_projectIds.Count > 0)
                _projectId = _projectIds[0];
            else
                _projectId = "";

            if (!string.IsNullOrEmpty(_projectId))
            {
                try
                {
                    var cfg = await Engine.GetConfigAsync(_projectId);
                    if (cfg?.Config is not null &&
                        cfg.Config.TryGetValue("resolution", out var res) &&
                        res.ValueKind == System.Text.Json.JsonValueKind.String &&
                        res.GetString() is { Length: > 0 } r)
                        _draftRes = r;
                    if (cfg?.Config is not null &&
                        cfg.Config.TryGetValue("cost_estimates", out var ce) &&
                        ce.ValueKind == System.Text.Json.JsonValueKind.Object &&
                        ce.TryGetProperty("assume_avg_retries", out var ar) &&
                        ar.TryGetDouble(out var retries))
                        _retries = retries;
                }
                catch { /* ignore */ }

                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task OnAdvancedDraftResAsync(ChangeEventArgs e) =>
        SetDraftResolutionAsync(e.Value?.ToString() ?? _draftRes);

    private async Task SetDraftResolutionAsync(string res)
    {
        res = (res ?? "480p").Trim().ToLowerInvariant();
        if (res is not ("480p" or "720p" or "1080p"))
            return;
        if (string.Equals(_draftRes, res, StringComparison.OrdinalIgnoreCase) && _report is not null)
            return;

        _draftRes = res;
        // Persist so film generation and Home estimate use the same resolution.
        try
        {
            if (!string.IsNullOrWhiteSpace(_projectId))
            {
                await Engine.SaveConfigAsync(_projectId, new Dictionary<string, object?>
                {
                    ["resolution"] = _draftRes,
                });
            }
        }
        catch
        {
            // Still recompute estimate even if save fails
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var dto = await Engine.GetCostAsync(_projectId, _draftRes, _heroRes, _retries);
            _report = dto?.Cost;
            if (_report is not null && !string.IsNullOrWhiteSpace(_report.DraftResolution))
                _draftRes = _report.DraftResolution;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _report = null;
        }
        finally { _busy = false; }
    }

    private async Task BackfillAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var result = await Engine.BackfillCostAsync(_projectId);
            var b = result?.Backfill;
            _message = b is null
                ? "Done"
                : $"Updated spend history ({b.Added} new, {b.Skipped} skipped).";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void ToggleCategory(string id) =>
        _openCategory = string.Equals(_openCategory, id, StringComparison.OrdinalIgnoreCase) ? null : id;

    private List<CostSlice> BuildSpentSlices()
    {
        var totals = Categories.ToDictionary(c => c.Id, _ => 0.0, StringComparer.OrdinalIgnoreCase);
        if (_report?.RecentEvents is { Count: > 0 } events)
        {
            foreach (var e in events)
                totals[MapCategory(e.Kind)] = totals.GetValueOrDefault(MapCategory(e.Kind)) + e.Usd;
        }
        else if (_report?.Actual?.ByKind is { Count: > 0 } byKind)
        {
            foreach (var kv in byKind)
                totals[MapCategory(kv.Key)] = totals.GetValueOrDefault(MapCategory(kv.Key)) + kv.Value;
        }

        // Prefer summary actual total if events are only a "recent" window and under-count
        var sliceSum = totals.Values.Sum();
        var actual = _report?.Summary.ActualUsd ?? 0;
        if (actual > sliceSum + 0.02 && _report?.Actual?.ByKind is { Count: > 0 } bk)
        {
            totals = Categories.ToDictionary(c => c.Id, _ => 0.0, StringComparer.OrdinalIgnoreCase);
            foreach (var kv in bk)
                totals[MapCategory(kv.Key)] = totals.GetValueOrDefault(MapCategory(kv.Key)) + kv.Value;
        }

        return Categories
            .Select(c => new CostSlice(c.Id, c.Label, Math.Round(totals.GetValueOrDefault(c.Id), 2), c.Color))
            .ToList();
    }

    private List<CostEvent> EventsForCategory(string categoryId)
    {
        if (_report?.RecentEvents is not { Count: > 0 } events)
            return new List<CostEvent>();
        return events
            .Where(e => string.Equals(MapCategory(e.Kind), categoryId, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(e => e.Ts ?? "")
            .ToList();
    }

    private List<CostSlice> BuildEstimateSlices()
    {
        var by = _report?.EstimateByCategory;
        return Categories
            .Select(c =>
            {
                var usd = 0.0;
                if (by is not null)
                {
                    if (by.TryGetValue(c.Id, out var v)) usd = v;
                    else
                    {
                        // tolerate alternate keys
                        foreach (var kv in by)
                        {
                            if (string.Equals(kv.Key, c.Id, StringComparison.OrdinalIgnoreCase))
                            {
                                usd = kv.Value;
                                break;
                            }
                        }
                    }
                }
                return new CostSlice(c.Id, c.Label, Math.Round(usd, 2), c.Color);
            })
            .ToList();
    }

    private RenderFragment RenderPie(List<CostSlice> slices, double total, string centerLabel, string testId) => __builder =>
    {
        if (total <= 0.0001)
        {
            <div class="cost-pie-empty text-center text-muted py-4" data-testid="@testId">
                <div class="cost-pie-placeholder mb-2" aria-hidden="true"></div>
                <div class="small">No @centerLabel.ToLowerInvariant() yet</div>
            </div>
        }
        else
        {
            <svg class="cost-pie" viewBox="0 0 42 42" width="220" height="220"
                 role="img" aria-label="@centerLabel by category" data-testid="@testId">
                <circle cx="21" cy="21" r="15.915" fill="transparent"
                        stroke="rgba(148,163,184,0.15)" stroke-width="6" />
                @{
                    var offset = 25.0;
                    foreach (var slice in slices.Where(x => x.Usd > 0))
                    {
                        var pct = 100.0 * slice.Usd / total;
                        <circle class="cost-pie-slice"
                                cx="21" cy="21" r="15.915"
                                fill="transparent"
                                stroke="@slice.Color"
                                stroke-width="6"
                                stroke-dasharray="@pct.ToString("0.###", CultureInfo.InvariantCulture) @((100 - pct).ToString("0.###", CultureInfo.InvariantCulture))"
                                stroke-dashoffset="@offset.ToString("0.###", CultureInfo.InvariantCulture)" />
                        offset -= pct;
                    }
                }
                <circle cx="21" cy="21" r="11.5" class="cost-pie-hole" />
                <text x="21" y="20.2" text-anchor="middle" class="cost-pie-center-label">@centerLabel</text>
                <text x="21" y="24.5" text-anchor="middle" class="cost-pie-center-value">@Usd(total)</text>
            </svg>
        }
    };

    private RenderFragment RenderLegend(List<CostSlice> slices, double total) => __builder =>
    {
        <ul class="list-unstyled mb-0 cost-legend">
            @foreach (var slice in slices)
            {
                var pct = total > 0 ? 100.0 * slice.Usd / total : 0;
                <li class="d-flex align-items-center justify-content-between gap-2 py-1">
                    <span class="d-flex align-items-center gap-2 min-w-0">
                        <span class="cost-swatch" style="background:@slice.Color"></span>
                        <span class="text-truncate">@slice.Label</span>
                    </span>
                    <span class="text-nowrap small">
                        <strong>@Usd(slice.Usd)</strong>
                        @if (total > 0 && slice.Usd > 0)
                        {
                            <span class="text-muted ms-1">(@pct.ToString("0")%)</span>
                        }
                    </span>
                </li>
            }
        </ul>
    };

    /// <summary>Map raw ledger kind → user-facing category id.</summary>
    internal static string MapCategory(string? kind)
    {
        var k = (kind ?? "other").Trim().ToLowerInvariant();
        return k switch
        {
            "video" or "film" or "clip" => "video",
            "image" or "image_edit" or "character" or "portrait" or "plates" => "characters",
            "music" or "bgm" or "score" => "music",
            "audio" or "voice" or "tts" or "voice-preview" or "voice_clone" or "speech" => "voice",
            "chat" or "planning" or "script" or "screenplay" or "vision" or "ocr"
                or "import" or "cast_extract" or "shot_plan" => "screenplay",
            _ => "other",
        };
    }

    private static string EventDetail(CostEvent e)
    {
        var bits = new List<string>();
        if (e.Scene is int sn)
            bits.Add(e.Clip is int cn ? $"Scene {sn} · clip {cn}" : $"Scene {sn}");
        if (!string.IsNullOrWhiteSpace(e.Character))
            bits.Add(KeyFormatting.ShortChar(e.Character));
        if (!string.IsNullOrWhiteSpace(e.Resolution))
            bits.Add(e.Resolution!);
        if (e.DurationSec is double d && d > 0)
            bits.Add($"{d:0.#}s");
        if (!string.IsNullOrWhiteSpace(e.Model))
            bits.Add(e.Model!);
        if (bits.Count == 0)
            bits.Add(string.IsNullOrWhiteSpace(e.Kind) ? "Work item" : e.Kind);
        return string.Join(" · ", bits);
    }

    private static string FormatTs(string? ts)
    {
        if (string.IsNullOrWhiteSpace(ts)) return "—";
        if (DateTimeOffset.TryParse(ts, CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal, out var dto))
            return dto.ToLocalTime().ToString("MMM d · HH:mm");
        return ts.Length <= 16 ? ts : ts[..16];
    }

    private static string Usd(double v) => $"${v:0.00}";

    private static int ProgressPct(CostReportSummary s) =>
        (int)Math.Round(100.0 * s.ClipsOnDisk / Math.Max(1, s.ClipsTotal));
}
