@using Microsoft.AspNetCore.Components
@inject EngineApiClient Engine

@if (IsOpen)
{
    @* Backdrop and panel are siblings — Bootstrap .modal-backdrop.show applies opacity
       to the whole element, which would make child text unreadable if nested. *@
    <div class="modal-backdrop fade show"
         style="z-index: 1050;"
         @onclick="Close"></div>
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="invite-collab-title"
         style="z-index: 1055;"
         @onclick="Close">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-3">
                    <h5 class="modal-title fw-semibold" id="invite-collab-title">Invite collaborator</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success") mb-3 py-2">@statusMessage</div>
                    }

                    <div class="mb-3 position-relative">
                        <label class="form-label" for="invite-handle">Handle</label>
                        <div class="input-group">
                            <span class="input-group-text">@@</span>
                            <input id="invite-handle"
                                   type="text"
                                   class="form-control"
                                   placeholder="Start typing a handle…"
                                   autocomplete="off"
                                   value="@searchHandle"
                                   @oninput="OnHandleInput" />
                        </div>
                        @if (_searching)
                        {
                            <div class="form-text">Searching…</div>
                        }
                        else if (_suggestions.Count > 0)
                        {
                            <ul class="list-group position-absolute w-100 shadow mt-1"
                                style="z-index: 20; max-height: 12rem; overflow-y: auto;">
                                @foreach (var h in _suggestions)
                                {
                                    var bare = h.TrimStart('@');
                                    <li class="list-group-item list-group-item-action py-2"
                                        style="cursor: pointer;"
                                        @onclick="() => PickHandle(bare)">
                                        @h
                                    </li>
                                }
                            </ul>
                        }
                        else if (_searchAttempted && searchHandle.Trim().Length >= 2 && !_searching)
                        {
                            <div class="form-text">No matching handles. You can still send by email.</div>
                        }
                    </div>

                    <div class="mb-0">
                        <label class="form-label" for="invite-email">Email</label>
                        <input id="invite-email"
                               type="email"
                               class="form-control"
                               placeholder="collaborator@example.com"
                               autocomplete="email"
                               @bind="emailInput"
                               @bind:event="oninput" />
                        <div class="form-text">Use email if they don’t have a handle yet.</div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close" disabled="@isSending">Cancel</button>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(isSending || (string.IsNullOrWhiteSpace(searchHandle) && string.IsNullOrWhiteSpace(emailInput)))"
                            @onclick="SendInvite">
                        @(isSending ? "Sending…" : "Send invite")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private string searchHandle = "";
    private string emailInput = "";
    private string statusMessage = "";
    private bool isError;
    private bool isSending;
    private bool _searching;
    private bool _searchAttempted;
    private List<string> _suggestions = new();
    private int _searchSeq;
    private CancellationTokenSource? _searchCts;

    private async Task Close()
    {
        statusMessage = "";
        isError = false;
        searchHandle = "";
        emailInput = "";
        _suggestions.Clear();
        _searchAttempted = false;
        CancelSearch();
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private void CancelSearch()
    {
        try { _searchCts?.Cancel(); } catch { /* */ }
        _searchCts?.Dispose();
        _searchCts = null;
    }

    private async Task OnHandleInput(ChangeEventArgs e)
    {
        searchHandle = e.Value?.ToString() ?? "";
        _suggestions.Clear();
        _searchAttempted = false;
        await DebouncedSearchAsync();
    }

    private void PickHandle(string bare)
    {
        searchHandle = bare ?? "";
        _suggestions.Clear();
        _searchAttempted = false;
        StateHasChanged();
    }

    private async Task DebouncedSearchAsync()
    {
        CancelSearch();
        var q = searchHandle.Trim().TrimStart('@');
        if (q.Length < 2)
        {
            _searching = false;
            return;
        }

        var cts = new CancellationTokenSource();
        _searchCts = cts;
        var seq = ++_searchSeq;
        _searching = true;
        try
        {
            await Task.Delay(250, cts.Token);
            if (seq != _searchSeq) return;
            var found = await Engine.SearchUserHandlesAsync(q, cts.Token);
            if (seq != _searchSeq) return;
            _suggestions = found.ToList();
            _searchAttempted = true;
        }
        catch (OperationCanceledException)
        {
            // newer keystroke
        }
        catch
        {
            if (seq == _searchSeq)
            {
                _suggestions.Clear();
                _searchAttempted = true;
            }
        }
        finally
        {
            if (seq == _searchSeq)
                _searching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendInvite()
    {
        isSending = true;
        statusMessage = "";
        isError = false;
        _suggestions.Clear();
        try
        {
            var handle = string.IsNullOrWhiteSpace(searchHandle) ? null : searchHandle.Trim().TrimStart('@');
            var email = string.IsNullOrWhiteSpace(emailInput) ? null : emailInput.Trim();
            var res = await Engine.SendProjectInviteAsync(ProjectId, handle, email);

            if (res is { Ok: true })
            {
                statusMessage = res.Delivered
                    ? "Invite sent — expires in 48 hours."
                    : "Invite created. Share this link: " + res.InviteUrl;
                isError = !res.Delivered;
                searchHandle = "";
                emailInput = "";
            }
            else
            {
                statusMessage = res?.Error ?? "Could not send the invite.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isSending = false;
        }
    }
}
