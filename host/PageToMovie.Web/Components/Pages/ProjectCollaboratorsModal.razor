@using Microsoft.AspNetCore.Components
@inject EngineApiClient Engine

@if (IsOpen)
{
    <div class="modal-backdrop show" style="display: block; background: rgba(0,0,0,0.85); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 99999;">
        <div class="modal-dialog modal-md modal-dialog-centered" style="margin: 5% auto; max-width: 550px;">
            <div class="modal-content text-light" style="background: #181b20; border: 1px solid #323842; border-radius: 12px; box-shadow: 0 12px 32px rgba(0,0,0,0.6);">
                <div class="modal-header" style="border-bottom: 1px solid #2d333f; padding: 18px 24px;">
                    <h5 class="modal-title fw-bold" style="color: #6366f1;">🤝 Invite Collaborator to Fork Project</h5>
                </div>
                <div class="modal-body" style="padding: 24px; color: #cbd5e1; font-size: 0.95rem;">
                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success") mb-3">@statusMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-white fw-bold">Creator Handle (@@username)</label>
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-dark text-secondary border-secondary">@@</span>
                            <input type="text" class="form-control bg-dark text-light border-secondary" placeholder="username" @bind="searchHandle" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white fw-bold">Or Send Blind Email Invite</label>
                        <input type="email" class="form-control bg-dark text-light border-secondary" placeholder="collaborator@example.com" @bind="emailInput" />
                        <div class="form-text text-muted small">Server sends the invite link without exposing whether an account exists.</div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #2d333f; padding: 18px 24px;">
                    <button class="btn btn-secondary me-2" @onclick="Close">Cancel</button>
                    <button class="btn btn-primary fw-bold" style="background: #6366f1; border: none;" @onclick="SendInvite" disabled="@(isSending || (string.IsNullOrWhiteSpace(searchHandle) && string.IsNullOrWhiteSpace(emailInput)))">
                        @(isSending ? "Sending Invite..." : "✉️ Send Invitation")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private string searchHandle = "";
    private string emailInput = "";
    private string statusMessage = "";
    private bool isError;
    private bool isSending;

    private async Task Close()
    {
        statusMessage = "";
        isError = false;
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task SendInvite()
    {
        isSending = true;
        statusMessage = "";
        isError = false;
        try
        {
            var handle = string.IsNullOrWhiteSpace(searchHandle) ? null : searchHandle.Trim();
            var email = string.IsNullOrWhiteSpace(emailInput) ? null : emailInput.Trim();
            var res = await Engine.SendProjectInviteAsync(ProjectId, handle, email);

            if (res is { Ok: true })
            {
                statusMessage = res.Delivered
                    ? "Invite sent — expires in 48 hours."
                    : "Invite created, but no email is on file for that handle yet. Share this link directly: " + res.InviteUrl;
                isError = !res.Delivered;
                searchHandle = "";
                emailInput = "";
            }
            else
            {
                statusMessage = res?.Error ?? "Could not send the invite.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isSending = false;
        }
    }
}
