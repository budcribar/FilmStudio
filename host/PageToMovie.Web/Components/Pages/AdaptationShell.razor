@* Shared header + step strip + job log for Adaptation step pages *@
@inject AdminSessionService Session
@inject ActiveProjectState ActiveProject

@if (Host is null)
{
    return;
}

<div class="ptm-adapt-header d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
    <div>
        <span class="ptm-adapt-kicker">Studio · Book pipeline</span>
        <h1 class="mb-0 ptm-adapt-title">Book & screenplay</h1>
        <p class="ptm-adapt-lede mb-0">Import source → screenplay → cast (voice optional) → shot plan. Then film on Scenes.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (!string.IsNullOrEmpty(Host.ProjectLabel))
        {
            <span class="badge text-bg-secondary px-2 py-1 fs-6">@Host.ProjectLabel</span>
        }
        @if (!string.IsNullOrEmpty(ActiveProject.ParentProjectId))
        {
            <span class="badge text-bg-info px-2 py-1 fs-6" title="Forked from @ActiveProject.ParentProjectId">🍴 Fork of @ActiveProject.ParentProjectId</span>
        }
    </div>
</div>

@* ---- Step strip (unlock logic unchanged; prototype look-feel) ---- *@
@{
    var stepsLocked = Host.JobRunning;
    var importActive = Step == "import" || Step == "book";
    var lookActive = Step == "look";
    var screenplayActive = Step == "screenplay";
    var embellishActive = Step == "embellish";
    var trimActive = Step == "trim";
    var castActive = Step == "characters";
    var shotsActive = Step == "shots";
    var lookOff = !OutlineEnabled || stepsLocked;
    var screenplayOff = !OutlineEnabled || stepsLocked;
    var embellishOff = !OutlineEnabled || stepsLocked;
    var trimOff = !OutlineEnabled || stepsLocked;
    var castOff = !ShotsEnabled || stepsLocked;
    var shotsOff = !ShotsEnabled || stepsLocked;
}
<nav class="ptm-step-strip" aria-label="Book pipeline steps">
    <a class="ptm-step @(importActive ? "is-active" : "") @(stepsLocked ? "is-disabled" : "")"
       href="@(stepsLocked ? "javascript:void(0)" : "adaptation/import")"
       @onclick:preventDefault="stepsLocked"
       data-testid="adapt-step-import">
        <span class="ptm-step__num">1</span>
        <span class="ptm-step__body">
            <span class="ptm-step__label">Book</span>
            <span class="ptm-step__hint">PDF · text · fountain</span>
        </span>
    </a>
    <a class="ptm-step @(lookActive ? "is-active" : "") @(lookOff ? "is-disabled" : "")"
       href="@(lookOff ? "javascript:void(0)" : "adaptation/look")"
       @onclick:preventDefault="lookOff"
       title="@(stepsLocked ? "Wait for the current job to finish" : OutlineEnabled ? "Choose the visual style before the screenplay is written" : "Import a source first")"
       data-testid="adapt-step-look">
        <span class="ptm-step__num">2</span>
        <span class="ptm-step__body">
            <span class="ptm-step__label">Look & medium</span>
            <span class="ptm-step__hint">Visual style</span>
        </span>
    </a>
    <a class="ptm-step @(screenplayActive ? "is-active" : "") @(screenplayOff ? "is-disabled" : "")"
       href="@(screenplayOff ? "javascript:void(0)" : "adaptation/screenplay")"
       @onclick:preventDefault="screenplayOff"
       title="@(stepsLocked ? "Wait for the current job to finish" : OutlineEnabled ? null : "Import a source first")"
       data-testid="adapt-step-screenplay">
        <span class="ptm-step__num">3</span>
        <span class="ptm-step__body">
            <span class="ptm-step__label">Screenplay</span>
            <span class="ptm-step__hint">Edit · approve</span>
        </span>
    </a>
    <a class="ptm-step @(embellishActive ? "is-active" : "") @(embellishOff ? "is-disabled" : "")"
       href="@(embellishOff ? "javascript:void(0)" : "adaptation/embellish")"
       @onclick:preventDefault="embellishOff"
       title="@(stepsLocked ? "Wait for the current job to finish" : OutlineEnabled ? "Enrich scene description before cast" : "Write a screenplay first")"
       data-testid="adapt-step-embellish">
        <span class="ptm-step__num">4</span>
        <span class="ptm-step__body">
            <span class="ptm-step__label">Enrich</span>
            <span class="ptm-step__hint">Scene detail</span>
        </span>
    </a>
    <a class="ptm-step @(trimActive ? "is-active" : "") @(trimOff ? "is-disabled" : "")"
       href="@(trimOff ? "javascript:void(0)" : "adaptation/trim")"
       @onclick:preventDefault="trimOff"
       title="@(stepsLocked ? "Wait for the current job to finish" : OutlineEnabled ? "Fit the film to your length and budget" : "Write a screenplay first")"
       data-testid="adapt-step-trim">
        <span class="ptm-step__num">5</span>
        <span class="ptm-step__body">
            <span class="ptm-step__label">Fit length</span>
            <span class="ptm-step__hint">Length · budget</span>
        </span>
    </a>
    <a class="ptm-step @(castActive ? "is-active" : "") @(castOff ? "is-disabled" : "")"
       href="@(castOff ? "javascript:void(0)" : "characters")"
       @onclick:preventDefault="castOff"
       title="@(stepsLocked ? "Wait for the current job to finish" : ShotsEnabled ? "Pin cast likeness and optional voice before clips" : NeedsReapprove ? "Re-approve the edited screenplay first" : "Approve a screenplay first")"
       data-testid="adapt-step-cast">
        <span class="ptm-step__num">6</span>
        <span class="ptm-step__body">
            <span class="ptm-step__label">Cast & voice</span>
            <span class="ptm-step__hint">Looks · optional clone</span>
        </span>
    </a>
    <a class="ptm-step @(shotsActive ? "is-active" : "") @(shotsOff ? "is-disabled" : "")"
       href="@(shotsOff ? "javascript:void(0)" : "adaptation/shots")"
       @onclick:preventDefault="shotsOff"
       title="@(stepsLocked ? "Wait for the current job to finish" : ShotsEnabled ? null : NeedsReapprove ? "Re-approve the edited screenplay first" : "Approve a screenplay first")"
       data-testid="adapt-step-shots">
        <span class="ptm-step__num">7</span>
        <span class="ptm-step__body">
            <span class="ptm-step__label">Shot plan</span>
            <span class="ptm-step__hint">Then film on Scenes</span>
        </span>
    </a>
</nav>

@if (!string.IsNullOrEmpty(Host.Error))
{
    <div class="alert alert-danger">@Host.Error</div>
}
@* Hide completion/status noise while Import or a job is still running *@
@if (!string.IsNullOrEmpty(Host.Message) && !Host.SuppressGuidanceBanners)
{
    <div class="alert alert-info">@Host.Message</div>
}

@* In-page busy (e.g. screenplay approve) — not a background job, but can take many seconds.
   Skip on Import: that page already has its own progress card. *@
@if (Host.Busy && !Host.JobRunning && Step is not "import" and not "book")
{
    <div class="card mb-3 border-primary" data-testid="busy-progress">
        <div class="card-body py-2">
            <div class="small mb-1">@(string.IsNullOrWhiteSpace(Host.BusyMessage) ? "Working…" : Host.BusyMessage)</div>
            <div class="progress" style="height: 0.85rem;" role="progressbar"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="45"
                 aria-label="@(Host.BusyMessage ?? "Working")">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                     style="width: 45%"></div>
            </div>
        </div>
    </div>
}

@* Job panel: progress + Cancel only while running. Admin can expand Details. *@
@if (ShowJobPanel)
{
    <div class="card mb-3 border-@(Host.Job!.Status is "running" or "queued" ? "primary" : Host.Job.Status == "error" ? "danger" : "secondary")"
         data-testid="job-panel"
         data-job-status="@Host.Job.Status"
         data-job-kind="@(Host.Job.Kind ?? "")"
         data-job-running="@(Host.JobRunning ? "true" : "false")">
        <div class="card-body py-2">
            @{
                var (jobIdx, jobTot, waiting, displayIdx) = AdaptationPageBase.ComputeJobProgress(
                    Host.Job, Host.ProgressIndex, Host.ProgressTotal, Host.JobRunning);
            }
            <div class="d-flex justify-content-between flex-wrap gap-2 align-items-center">
                <div class="small">
                    <span class="visually-hidden" data-testid="job-status">@Host.Job.Status</span>
                    @if (Host.JobRunning)
                    {
                        <span>@AdaptationPageBase.OperatorJobRunningMessage(Host.Job)</span>
                    }
                    else
                    {
                        <span>@AdaptationPageBase.OperatorJobDoneMessage(Host.Job)</span>
                    }
                </div>
                @if (Host.JobRunning)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            data-testid="job-cancel"
                            @onclick="Host.CancelAsync">Cancel</button>
                }
            </div>
            @if (Host.JobRunning)
            {
                var pct = AdaptationPageBase.ComputeProgressPercent(
                    displayIdx, jobTot, waiting, Host.JobRunning, Host.Job.StartedAt);
                <div class="progress mt-2" style="height: 0.85rem;" role="progressbar"
                     aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"
                     aria-label="@AdaptationPageBase.OperatorJobRunningMessage(Host.Job)">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         style="width: @pct%"></div>
                </div>
            }
            @* Admin-only: expandable log — not shown by default (avoids stacking with the message line). *@
            @if (Session.IsAdmin && Host.Job.Log.Count > 0 && !Host.JobRunning)
            {
                <button type="button"
                        class="btn btn-sm btn-link text-muted p-0 mt-1 text-decoration-none"
                        @onclick="() => _showHistory = !_showHistory">
                    @(_showHistory ? "Hide details" : "Details (admin)")
                </button>
                @if (_showHistory)
                {
                    <pre class="small mb-0 mt-1" style="max-height: 200px; overflow: auto;">@string.Join("\n", Host.Job.Log.TakeLast(40))</pre>
                }
            }
        </div>
    </div>
}

@if (Host.Status is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    @* Skip “Next” when it only restates the step you’re already on *@
    @if (ShowNextBanner)
    {
        <div class="alert @AdaptationPageBase.NextStepAlertClass(Host.Status.NextStep) py-2">
            <strong>Next:</strong> @AdaptationPageBase.NextStepLabel(Host.Status.NextStep)
            @if (!Host.Status.XaiConfigured && Host.Status.NextStep is "draft_screenplay" or "run_stage1" or "run_stage2" or "replan_stage2")
            {
                <span class="ms-2">· <a href="configuration">Connect service</a></span>
            }
        </div>
    }

    @ChildContent
}

@code {
    [Parameter, EditorRequired] public AdaptationPageBase Host { get; set; } = null!;
    [Parameter, EditorRequired] public string Step { get; set; } = "book";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _showHistory;

    private bool OutlineEnabled => AdaptationPageBase.OutlineEnabled(Host.Status);

    private bool ShotsEnabled => AdaptationPageBase.ShotsEnabled(Host.Status);

    /// <summary>There was a prior sign-off, but the draft has since changed (vs. never approved at all).</summary>
    private bool NeedsReapprove =>
        Host.Status?.Screenplay is { } s
        && !s.ReadyForShots
        && !string.IsNullOrWhiteSpace(s.SignedHash);

    private bool ShowJobPanel => AdaptationPageBase.ShowJobPanel(Session.IsAdmin, Host.Job, Step);

    protected override async Task OnInitializedAsync()
    {
        try { await Session.EnsureHydratedAsync(); } catch { /* optional */ }
    }

    private bool ShowNextBanner =>
        AdaptationPageBase.ShowNextStepBanner(Host.Status, Host.SuppressGuidanceBanners, Step ?? "");

}
