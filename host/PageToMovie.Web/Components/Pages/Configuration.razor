@page "/configuration"
@implements IDisposable
@using System.Text.Json
@using PageToMovie.Core.Models
@inject EngineApiClient Engine
@inject IConfiguration AppConfig
@inject ActiveProjectState ActiveProject
@inject ThemeState Theme
@inject IJSRuntime Js
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject ClientMediaFolderService MediaFolder

<PageTitle>Settings</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <span class="ptm-adapt-kicker">Account & providers</span>
        <h1 class="mb-1 ptm-adapt-title">Settings</h1>
        <p class="text-muted mb-0">
            @if (!string.IsNullOrWhiteSpace(_projectId))
            {
                <span>Settings for active project: <strong class="text-primary">@_projectId</strong></span>
            }
            else
            {
                <span>Settings and provider options for your film projects.</span>
            }
        </p>
    </div>
    @if (_projectIds.Count > 0)
    {
        <div class="d-flex align-items-center gap-2">
            <label class="fw-semibold small text-muted text-nowrap mb-0">Active Project:</label>
            <select class="form-select form-select-sm" value="@_projectId" @onchange="OnProjectChangedAsync" style="min-width: 160px;">
                @foreach (var pid in _projectIds)
                {
                    <option value="@pid">@pid</option>
                }
            </select>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mb-3">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success mb-3">@_message</div>
}
    <!-- STUDIO COVERAGE FIRST: change model, add/remove key just-in-time -->
    <div class="card mb-4 border-primary border-opacity-50 shadow-sm" id="api-keys" data-testid="studio-coverage-card">
        <div class="card-header bg-dark text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Studio coverage</span>
            @{
                var cov = BuildCoverageRows();
                var needed = cov.Count(c => c.Required && !c.OptionalOff);
                var ready = cov.Count(c => c.Required && !c.OptionalOff && c.KeyReady);
                var missing = cov.Where(c => c.Required && !c.OptionalOff && !c.KeyReady).ToList();
            }
            @if (missing.Count == 0)
            {
                <span class="badge text-bg-success">@ready/@needed required ready</span>
            }
            else
            {
                <span class="badge text-bg-warning text-dark">@missing.Count missing · @ready/@needed ready</span>
            }
        </div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                Pick the model for each studio job. Keys appear only when you need them —
                change model, add a key for that provider, or remove a key you no longer use.
            </p>

            @if (!string.IsNullOrEmpty(_apiKeyFeedback))
            {
                <div class="alert alert-success py-2 px-3 small">@_apiKeyFeedback</div>
            }

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" data-testid="capability-coverage">
                    <thead>
                        <tr class="small text-muted">
                            <th style="min-width:9rem">Job</th>
                            <th style="min-width:12rem">Model</th>
                            <th>Key</th>
                            <th style="min-width:11rem">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in cov)
                        {
                            var models = ModelsForCoverage(c.Id);
                            var editing = string.Equals(_coverageEditId, c.Id, StringComparison.OrdinalIgnoreCase);
                            <tr class="@(c.OptionalOff ? "opacity-75" : "")" data-testid="coverage-@c.Id">
                                <td>
                                    <div class="fw-semibold small">@c.Label</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@c.Hint</div>
                                </td>
                                <td>
                                    @if (models.Count > 0)
                                    {
                                        <select class="form-select form-select-sm"
                                                data-testid="coverage-model-@c.Id"
                                                disabled="@(_busy || string.IsNullOrEmpty(_projectId))"
                                                value="@GetCoverageModelId(c.Id)"
                                                @onchange="e => OnCoverageModelChangedAsync(c.Id, e.Value?.ToString())">
                                            @foreach (var m in models)
                                            {
                                                <option value="@m.Id">@ModelOptionLabel(m)</option>
                                            }
                                        </select>
                                        @if (string.IsNullOrEmpty(_projectId))
                                        {
                                            <div class="form-text">Select a project to save model choice.</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="small text-muted">@c.ModelId</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (c.OptionalOff)
                                    {
                                        <span class="badge text-bg-secondary">Off</span>
                                    }
                                    else if (c.KeyReady)
                                    {
                                        <span class="badge text-bg-success">Ready</span>
                                        @if (!string.IsNullOrWhiteSpace(c.ProviderDisplay))
                                        {
                                            <div class="text-muted mt-1" style="font-size:0.75rem;">@c.ProviderDisplay</div>
                                        }
                                    }
                                    else if (string.IsNullOrWhiteSpace(c.ProviderId))
                                    {
                                        <span class="badge text-bg-secondary">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Need key</span>
                                        <div class="text-muted mt-1" style="font-size:0.75rem;">@c.ProviderDisplay</div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (!c.OptionalOff && !c.KeyReady && !string.IsNullOrWhiteSpace(c.ProviderId))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-testid="coverage-add-key-@c.Id"
                                                    disabled="@_busy"
                                                    @onclick="() => BeginAddKey(c.Id, c.ProviderId)">
                                                Add key
                                            </button>
                                        }
                                        else if (!c.OptionalOff && c.KeyReady && !string.IsNullOrWhiteSpace(c.ProviderId))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-testid="coverage-change-key-@c.Id"
                                                    disabled="@_busy"
                                                    @onclick="() => BeginAddKey(c.Id, c.ProviderId)">
                                                Replace key
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-testid="coverage-remove-key-@c.Id"
                                                    disabled="@_busy"
                                                    title="Remove personal key for this provider"
                                                    @onclick="() => ClearProviderKeyAsync(c.ProviderId)">
                                                Remove key
                                            </button>
                                        }
                                        @if (c.Id is "music" or "voice")
                                        {
                                            @if (!c.OptionalOff)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-link text-muted px-1"
                                                        disabled="@(_busy || string.IsNullOrEmpty(_projectId))"
                                                        @onclick="() => TurnOffOptionalAsync(c.Id)">
                                                    Turn off
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                            @if (editing)
                            {
                                <tr class="table-active" data-testid="coverage-key-panel-@c.Id">
                                    <td colspan="4" class="bg-dark bg-opacity-25">
                                        <div class="p-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                                <div class="small fw-semibold">
                                                    Add key for <span class="text-primary">@c.Label</span>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link" @onclick="CancelAddKey">Cancel</button>
                                            </div>
                                            <p class="small text-muted mb-2">
                                                Only providers that can run this job are listed.
                                                <strong>Suno</strong> and <strong>AI Music API</strong> are different resellers — each needs its own key.
                                                If a card already says <em>Has key</em>, click <strong>Use this key</strong> (we switch the model to match).
                                            </p>
                                            <div class="row g-2">
                                                @foreach (var p in ProvidersForCoverage(c.Id))
                                                {
                                                    var selected = string.Equals(_coverageKeyProviderId, p.ProviderId, StringComparison.OrdinalIgnoreCase);
                                                    <div class="col-md-6 col-lg-4">
                                                        <div class="border rounded p-2 h-100 @(selected ? "border-primary" : "")"
                                                             data-testid="coverage-provider-@p.ProviderId">
                                                            <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                                                <div class="fw-semibold small">@p.DisplayName</div>
                                                                @if (p.IsConfigured)
                                                                {
                                                                    <span class="badge text-bg-success">Has key</span>
                                                                }
                                                            </div>
                                                            @if (!selected)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm @(p.IsConfigured ? "btn-primary" : "btn-outline-primary")"
                                                                        data-testid="coverage-pick-@p.ProviderId"
                                                                        @onclick="() => ChooseProviderForCoverageAsync(p.ProviderId, c.Id)">
                                                                    @(p.IsConfigured ? "Use this key" : "Select")
                                                                </button>
                                                                @if (p.IsConfigured)
                                                                {
                                                                    <div class="form-text">Uses your saved @p.DisplayName key and switches the model to match.</div>
                                                                }
                                                            }
                                                            else if (p.IsConfigured)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-primary mb-2"
                                                                        data-testid="coverage-use-saved-@p.ProviderId"
                                                                        disabled="@_busy"
                                                                        @onclick="() => UseSavedProviderForCoverageAsync(p.ProviderId, c.Id)">
                                                                    Use saved key
                                                                </button>
                                                                <div class="form-text mb-2">Already on file — no need to paste again unless you want to replace it.</div>
                                                                <label class="form-label small mb-1">Replace API key (optional)</label>
                                                                <div class="input-group input-group-sm mb-1">
                                                                    <input type="@(IsKeyVisible(p.ProviderId) ? "text" : "password")"
                                                                           class="form-control font-monospace"
                                                                           placeholder="@ProviderPlaceholder(p.ProviderId)"
                                                                           value="@GetKeyInput(p.ProviderId)"
                                                                           @oninput="e => SetKeyInput(p.ProviderId, e.Value?.ToString())"
                                                                           disabled="@(_busy || _apiKeySaving)" />
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            @onclick="() => ToggleKeyVisible(p.ProviderId)">
                                                                        @(IsKeyVisible(p.ProviderId) ? "Hide" : "Show")
                                                                    </button>
                                                                    <button class="btn btn-outline-primary" type="button"
                                                                            disabled="@(_busy || _apiKeySaving || string.IsNullOrWhiteSpace(GetKeyInput(p.ProviderId)))"
                                                                            @onclick="() => SaveCoverageKeyAsync(p.ProviderId, c.Id)">
                                                                        Replace
                                                                    </button>
                                                                </div>
                                                                <button type="button" class="btn btn-link btn-sm text-danger p-0"
                                                                        disabled="@_busy"
                                                                        @onclick="() => ClearProviderKeyAsync(p.ProviderId)">
                                                                    Remove saved key
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <label class="form-label small mb-1">API key</label>
                                                                <div class="input-group input-group-sm mb-1">
                                                                    <input type="@(IsKeyVisible(p.ProviderId) ? "text" : "password")"
                                                                           class="form-control font-monospace"
                                                                           placeholder="@ProviderPlaceholder(p.ProviderId)"
                                                                           value="@GetKeyInput(p.ProviderId)"
                                                                           @oninput="e => SetKeyInput(p.ProviderId, e.Value?.ToString())"
                                                                           disabled="@(_busy || _apiKeySaving)" />
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            @onclick="() => ToggleKeyVisible(p.ProviderId)">
                                                                        @(IsKeyVisible(p.ProviderId) ? "Hide" : "Show")
                                                                    </button>
                                                                    <button class="btn btn-primary" type="button"
                                                                            disabled="@(_busy || _apiKeySaving || string.IsNullOrWhiteSpace(GetKeyInput(p.ProviderId)))"
                                                                            @onclick="() => SaveCoverageKeyAsync(p.ProviderId, c.Id)">
                                                                        Save
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            @if (!ProvidersForCoverage(c.Id).Any())
                                            {
                                                <div class="alert alert-warning py-2 small mb-0">No providers available for this job in the catalog.</div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @{
                var savedKeys = ProviderRows.Where(pr => pr.HasPersonalKey).ToList();
            }
            @if (savedKeys.Count > 0)
            {
                <details class="mt-3" data-testid="manage-saved-keys">
                    <summary class="small text-muted" style="cursor:pointer">Manage saved keys (@savedKeys.Count)</summary>
                    <div class="row g-2 mt-2">
                        @foreach (var p in savedKeys)
                        {
                            var used = CoverageUsesForProvider(p.ProviderId);
                            <div class="col-md-6 col-lg-4">
                                <div class="border rounded p-2 small">
                                    <div class="fw-semibold">@p.DisplayName</div>
                                    @if (used.Count > 0)
                                    {
                                        <div class="text-success">In use: @string.Join(" · ", used)</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Not used by current models</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.MaskedPersonalKey))
                                    {
                                        <div class="text-muted"><code>@p.MaskedPersonalKey</code></div>
                                    }
                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 mt-1"
                                            disabled="@_busy"
                                            @onclick="() => ClearProviderKeyAsync(p.ProviderId)">
                                        Remove key
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }
        </div>
    </div>

    <!-- PROJECT STORAGE & CONFIGURATION -->
    @if (_projectIds.Count == 0 && string.IsNullOrWhiteSpace(_projectId))
    {
        <div class="alert alert-info mb-4">
            📌 <strong>No projects created yet.</strong> You can set up your global API keys above. To configure project models and options, create your first project on <a href="/" class="fw-bold">Home</a>.
        </div>
    }
    else if (_cfg is null)
    {
        <div class="alert alert-warning mb-4">
            📌 <strong>No project selected.</strong> Select an active project from the top right dropdown or visit <a href="/" class="fw-bold">Home</a> to open a project.
        </div>
    }
    else
    {
    <div class="card mb-3 border-secondary">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>📁 Project Storage &amp; Local Media Folder</span>
            <span class="badge @(MediaFolder.IsConnected ? "bg-success" : "bg-warning text-dark")">
                @(MediaFolder.IsConnected ? "Local Folder Connected" : "Local Folder Not Connected")
            </span>
        </div>
        <div class="card-body py-3">
            <div class="row align-items-stretch g-3">
                <div class="col-md-7">
                    <div class="fw-semibold mb-1">Local media folder</div>
                    <p class="small text-muted mb-2">
                        Clips and audio save on <strong>this computer</strong> via the Chrome/Edge folder picker.
                        One button selects the folder — no typed paths.
                    </p>
                    @if (MediaFolder.IsConnected)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <div class="font-monospace small bg-dark p-2 rounded border border-secondary text-info flex-grow-1 text-break" data-testid="config-media-folder-name">
                                @(MediaFolder.FolderName ?? MediaFolder.FullPath ?? "Selected folder")
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary flex-shrink-0"
                                    data-testid="config-select-media-folder"
                                    disabled="@_busy"
                                    @onclick="ConnectMediaFolderAsync">
                                Change folder
                            </button>
                        </div>
                        <div class="small text-muted">
                            Media for <strong>@_projectId</strong> is written here.
                        </div>
                    }
                    else if (MediaFolder.NeedsReconnect)
                    {
                        <div class="alert alert-warning py-2 small mb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>Browser needs permission again for <strong>@(MediaFolder.PendingReconnectFolderName ?? "your folder")</strong>.</span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-warning" data-testid="config-reconnect-media-folder" @onclick="ReconnectMediaFolderAsync">
                                    Reconnect
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="config-select-media-folder" @onclick="ConnectMediaFolderAsync">
                                    Choose different folder
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                data-testid="config-select-media-folder"
                                disabled="@_busy"
                                @onclick="ConnectMediaFolderAsync">
                            Select folder
                        </button>
                        <div class="form-text">Opens your system folder picker.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(MediaFolder.LastStatus))
                    {
                        <div class="small text-muted mt-2" data-testid="config-media-status">@MediaFolder.LastStatus</div>
                    }
                </div>
                <div class="col-md-5 border-start border-secondary ps-md-4">
                    <div class="fw-semibold small mb-1">Active Project</div>
                    <div class="h5 mb-2 text-primary">@_projectId</div>
                    <div class="small text-muted">
                        Screenplays, shot plans, and project metadata for <strong>@_projectId</strong> are safely stored on the server.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Appearance &amp; Workflow</div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">Theme</label>
                <select class="form-select" data-testid="config-theme" @bind="_uiTheme" @bind:after="PreviewThemeAsync" disabled="@_busy">
                    <option value="dark">Dark</option>
                    <option value="light">Light</option>
                    <option value="system">Use system</option>
                </select>
                <div class="form-text">
                    Saved with this project's settings. Previews immediately; click Save to persist.
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Preferred External Video Editor</label>
                <input type="text" class="form-control" list="video-editor-suggestions" @bind="_preferredVideoEditor" placeholder="ClipChamp" disabled="@_busy" />
                <datalist id="video-editor-suggestions">
                    <option value="ClipChamp" />
                    <option value="DaVinci Resolve" />
                    <option value="Adobe Premiere" />
                    <option value="iMovie" />
                </datalist>
                <div class="form-text">
                    Personalized external editor used for scene refinement instructions.
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="models">
        <div class="card-header fw-bold">Models</div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                Select models for each stage of production. These choices correspond directly to the 5 capabilities in <strong>Account &amp; API Keys</strong>.
            </p>
            @if (FocusActive)
            {
                <div class="alert alert-info py-2 small d-flex flex-wrap justify-content-between align-items-center gap-2" data-testid="models-focus-banner">
                    <span>
                        Showing models for <strong>@FocusLabel</strong> — pick one below, then save.
                        @if (!string.IsNullOrWhiteSpace(FocusKeyHint))
                        {
                            <span class="text-muted">(@FocusKeyHint)</span>
                        }
                    </span>
                    <a class="btn btn-sm btn-outline-secondary" href="/configuration#models">Show all models</a>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6 col-xl-4 @FocusSlotClass("video")" data-testid="model-slot-video" style="@FocusSlotStyle("video")">
                    <label class="form-label fw-semibold">Video Generation</label>
                    <select class="form-select" @bind="_modelName" disabled="@_busy">
                        @foreach (var m in _videoModels)
                        {
                            <option value="@m.Id">@ModelOptionLabel(m)</option>
                        }
                        @if (_videoModels.All(m => !string.Equals(m.Id, _modelName, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@_modelName">@_modelName (not in list)</option>
                        }
                    </select>
                    @if (ModelHint(_modelName, "video") is { } vh)
                    {
                        <div class="form-text">@vh</div>
                    }
                    <div class="form-text text-muted">Generates MP4 video clips from prompts and character plates.</div>
                </div>

                <div class="col-md-6 col-xl-4 @FocusSlotClass("image")" data-testid="model-slot-image" style="@FocusSlotStyle("image")">
                    <label class="form-label fw-semibold">Portrait / Image Generation</label>
                    <select class="form-select" @bind="_imageModel" disabled="@_busy">
                        @foreach (var m in _imageModels)
                        {
                            <option value="@m.Id">@ModelOptionLabel(m)</option>
                        }
                        @if (_imageModels.All(m => !string.Equals(m.Id, _imageModel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@_imageModel">@_imageModel (not in list)</option>
                        }
                    </select>
                    @if (ModelHint(_imageModel, "image") is { } ih)
                    {
                        <div class="form-text">@ih</div>
                    }
                    <div class="form-text text-muted">Creates character reference portraits and book plate graphics.</div>
                </div>

                <div class="col-md-6 col-xl-4 @FocusSlotClass("planning")" data-testid="model-slot-planning" style="@FocusSlotStyle("planning")">
                    <label class="form-label fw-semibold">Script &amp; Planning</label>
                    <select class="form-select" @bind="_planningModel" disabled="@_busy">
                        @foreach (var m in _planningModels)
                        {
                            <option value="@m.Id">@ModelOptionLabel(m)</option>
                        }
                        @if (_planningModels.All(m => !string.Equals(m.Id, _planningModel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@_planningModel">@_planningModel (not in list)</option>
                        }
                    </select>
                    @if (ModelHint(_planningModel, "chat") is { } ph)
                    {
                        <div class="form-text">@ph</div>
                    }
                    <div class="form-text text-muted">Screenplay reasoning, shot planning, and cast analysis.</div>
                </div>

                <div class="col-md-6 col-xl-4 @FocusSlotClass("vision")" data-testid="model-slot-vision" style="@FocusSlotStyle("vision")">
                    <label class="form-label fw-semibold">Image Vision &amp; OCR</label>
                    <select class="form-select" @bind="_visionModel" disabled="@_busy">
                        @foreach (var m in _visionModels)
                        {
                            <option value="@m.Id">@ModelOptionLabel(m)</option>
                        }
                        @if (_visionModels.All(m => !string.Equals(m.Id, _visionModel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@_visionModel">@_visionModel (not in list)</option>
                        }
                    </select>
                    @if (ModelHint(_visionModel, "vision") is { } vish)
                    {
                        <div class="form-text">@vish</div>
                    }
                    <div class="form-text text-muted">Book page OCR, cast-on-image classification, and frame inspection.</div>
                </div>

                <div class="col-md-6 col-xl-4 @FocusSlotClass("review")" data-testid="model-slot-review" style="@FocusSlotStyle("review")">
                    <label class="form-label fw-semibold">Video &amp; Clip Review (Multimodal)</label>
                    <select class="form-select" @bind="_qualityModel" disabled="@_busy">
                        @foreach (var m in _videoReviewModels)
                        {
                            var tag = m.SupportsVideoReview ? " [⭐ Native MP4 Video Review]" : " [Image Stills Only]";
                            <option value="@m.Id">@ModelOptionLabel(m)@tag</option>
                        }
                        @if (_videoReviewModels.All(m => !string.Equals(m.Id, _qualityModel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@_qualityModel">@_qualityModel (not in list)</option>
                        }
                    </select>
                    @if (ModelHint(_qualityModel, "chat") is { } qh)
                    {
                        <div class="form-text">@qh</div>
                    }
                    <div class="form-text text-muted">Evaluates dialogue &amp; lip sync (Google Gemini natively analyzes MP4 video files).</div>
                </div>

                <div class="col-md-6 col-xl-4 @FocusSlotClass("music")" data-testid="model-slot-music" style="@FocusSlotStyle("music")">
                    <label class="form-label fw-semibold">Audio &amp; Music Generation</label>
                    <select class="form-select" @bind="_audioModel" disabled="@_busy">
                        @foreach (var m in _audioModels)
                        {
                            <option value="@m.Id">@ModelOptionLabel(m)</option>
                        }
                        @if (_audioModels.All(m => !string.Equals(m.Id, _audioModel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@_audioModel">@_audioModel (not in list)</option>
                        }
                    </select>
                    @if (ModelHint(_audioModel, "audio") is { } ah)
                    {
                        <div class="form-text">@ah</div>
                    }
                    <div class="form-text text-muted">Generates beat-aligned background music scores and audio soundscapes.</div>
                </div>

                <div class="col-md-6 col-xl-4 @FocusSlotClass("voice")" data-testid="model-slot-voice" style="@FocusSlotStyle("voice")">
                    <label class="form-label fw-semibold">Voice clone</label>
                    <select class="form-select" @bind="_voiceModel" disabled="@_busy">
                        @foreach (var m in _voiceModels)
                        {
                            <option value="@m.Id">@ModelOptionLabel(m)</option>
                        }
                        @if (_voiceModels.All(m => !string.Equals(m.Id, _voiceModel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@_voiceModel">@_voiceModel (not in list)</option>
                        }
                    </select>
                    @if (ModelHint(_voiceModel, "voice") is { } vch)
                    {
                        <div class="form-text">@vch</div>
                    }
                    <div class="form-text text-muted">
                        Personal voice samples for characters. Choose a model and add the provider key above.
                        Set to None to leave clone off.
                    </div>
                </div>
            </div>

            <div class="border-top pt-3 mt-3">
                <div class="row align-items-center g-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="enableBgMusicSwitch" @bind="_enableBackgroundMusic" disabled="@_busy" />
                            <label class="form-check-label fw-semibold" for="enableBgMusicSwitch">Enable Background Music Generation</label>
                        </div>
                        <div class="form-text text-muted">Automatically score and remux background music for completed scenes.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold mb-1">Background Music Volume (@_backgroundMusicVolumePercent%)</label>
                        <input type="range" class="form-range" min="5" max="100" step="5" @bind="_backgroundMusicVolumePercent" disabled="@(!_enableBackgroundMusic || _busy)" />
                        <div class="form-text text-muted">Volume ratio under character dialogue (default 20%).</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Format & Resolution</div>
        <div class="card-body row g-2">
            <div class="col-md-4">
                <label class="form-label">Aspect ratio</label>
                <select class="form-select" @bind="_aspect" disabled="@_busy">
                    <option value="16:9">16:9</option>
                    <option value="9:16">9:16</option>
                    <option value="1:1">1:1</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Resolution</label>
                <select class="form-select" @bind="_resolution" disabled="@_busy">
                    <option value="480p">480p</option>
                    <option value="720p">720p</option>
                    <option value="1080p">1080p</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Duration (seconds)</label>
                <input type="number" class="form-control" min="1" max="15" @bind="_durationSeconds" disabled="@_busy" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Pipeline Behavior</div>
        <div class="card-body row g-3">
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="smart" @bind="_smartContinuation" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="smart">Smart Continuation</label>
                <div class="form-text">Seamlessly extend visual prompts across consecutive clips in a scene.</div>
            </div>
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="qaRetry" @bind="_qaRetry" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="qaRetry">Quality Gate Retry</label>
                <div class="form-text">
                    When dialogue QA fails, auto-regenerate the clip (admin mode). Cost estimate uses a ~1.3× video prior until we learn real retry rates from production data.
                </div>
            </div>
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="regenSilent" @bind="_regenSilent" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="regenSilent">Regenerate Silent Beats</label>
                <div class="form-text">Re-synthesize audio for silent action beats during scene updates.</div>
            </div>
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="useDur" @bind="_useDurationDefaults" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="useDur">Use Default Clip Durations</label>
                <div class="form-text">Fall back to standard duration budgeting when shot plan timing is unspecified.</div>
            </div>
        </div>

        <div class="card-footer">
            <details class="small">
                <summary class="text-muted role-button py-1 fw-semibold" style="cursor: pointer;">⚙️ Advanced QA Tuning</summary>
                <div class="row g-2 mt-2 pt-2 border-top">
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" id="merge" @bind="_mergeAfterClip" disabled="@_busy" />
                        <label class="form-check-label" for="merge">Auto-merge scene after each clip</label>
                    </div>
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" id="rebuildWip" @bind="_rebuildWip" disabled="@_busy" />
                        <label class="form-check-label" for="rebuildWip">Auto-rebuild WIP movie after scene</label>
                    </div>
                    <div class="col-md-4 mt-3">
                        <label class="form-label">QA Max Retries</label>
                        <input type="number" class="form-control form-control-sm" min="0" max="5" @bind="_qaMaxRetries" disabled="@_busy" />
                    </div>
                    <div class="col-md-4 mt-3">
                        <label class="form-label">QA Sample Frames</label>
                        <input type="number" class="form-control form-control-sm" min="1" max="8" @bind="_qaFrameCount" disabled="@_busy" />
                    </div>
                    <div class="col-md-4 mt-3">
                        <label class="form-label">Composite Audio Gain (dB)</label>
                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="_audioGain" disabled="@_busy" />
                    </div>
                </div>
            </details>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Cost estimates (vendor list rates)</div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                Planning rates come from the <strong>selected models</strong> above (supported-model catalog),
                not free-form dollars. Change the video or portrait model to update these.
                Ledger “actuals” use the same list rates — not provider invoices.
            </p>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="fw-semibold mb-1">Video · @VendorLabel(_modelName, "video")</div>
                    <div class="small text-muted mb-2"><code>@_modelName</code></div>
                    <div class="row g-2">
                        <div class="col-4">
                            <div class="form-control-plaintext border rounded px-2 py-1">
                                <span class="small text-muted">480p</span><br />
                                <strong>@UsdRate(CatalogVideoRate("480p"))</strong><span class="small">/sec</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-control-plaintext border rounded px-2 py-1">
                                <span class="small text-muted">720p</span><br />
                                <strong>@UsdRate(CatalogVideoRate("720p"))</strong><span class="small">/sec</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-control-plaintext border rounded px-2 py-1">
                                <span class="small text-muted">1080p</span><br />
                                <strong>@UsdRate(CatalogVideoRate("1080p"))</strong><span class="small">/sec</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold mb-1">Image · @VendorLabel(_imageModel, "image")</div>
                    <div class="small text-muted mb-2"><code>@_imageModel</code></div>
                    <div class="form-control-plaintext border rounded px-2 py-1">
                        <span class="small text-muted">Per image</span><br />
                        <strong>@UsdRate(CatalogImageRate())</strong>
                    </div>
                    <div class="small text-muted mt-2">
                        Planning / quality chat models also have per-token catalog rates used in telemetry;
                        video spend dominates most film budgets.
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 mb-4 p-3 border rounded card">
            <span class="text-muted small">Configuring active project: <strong>@_projectId</strong></span>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" disabled="@(_busy || string.IsNullOrEmpty(_projectId))" @onclick="LoadAsync">Reload settings</button>
                <button class="btn btn-primary" disabled="@(_busy || _cfg is null || string.IsNullOrEmpty(_projectId))" @onclick="SaveAsync">
                    @(_busy ? "Saving…" : $"Save settings for {_projectId}")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _message;
    private string _projectId = "";
    private List<string> _projectIds = new();
    private Dictionary<string, JsonElement>? _cfg;
    private string? _projectDir;

    private string _uiTheme = "dark";
    private string _preferredVideoEditor = "ClipChamp";
    private string _blueprintFile = "blueprint.clips.grok.json";
    private string _modelName = "grok-imagine-video";
    private string _imageModel = "grok-imagine-image-quality";
    private string _planningModel = "grok-4.5";
    private string _visionModel = "grok-4.5";
    private string _qualityModel = "gemini-2.5-flash";
    private string _audioModel = "fal-ai/stable-audio-2.0";
    private string _voiceModel = "none";
    /// <summary>Deep-link from gated features: music | voice | review | video | …</summary>
    private string? _focusCapability;
    private bool _enableBackgroundMusic = true;
    private int _backgroundMusicVolumePercent = 20;
    private string _aspect = "16:9";
    private string _resolution = "480p";
    private int _durationSeconds = 8;
    private bool _useDurationDefaults = true;
    private bool _smartContinuation = true;
    private bool _mergeAfterClip = true;
    private bool _qaRetry = true;
    private bool _regenSilent = true;
    private bool _rebuildWip = true;
    private int _qaMaxRetries = 2;
    private int _qaFrameCount = 4;
    private double _audioGain = 6;
    private string _wipPath = "assets/movie_wip.mp4";

    private List<SupportedModelDto> _allModels = new();
    private List<SupportedModelDto> _videoModels = new();
    private List<SupportedModelDto> _imageModels = new();
    private List<SupportedModelDto> _planningModels = new();
    private List<SupportedModelDto> _visionModels = new();
    private List<SupportedModelDto> _videoReviewModels = new();
    private List<SupportedModelDto> _audioModels = new();
    private List<SupportedModelDto> _voiceModels = new();

    protected override async Task OnInitializedAsync()
    {
        ParseFocusFromUri();
        try
        {
            try { await Session.EnsureHydratedAsync(); } catch { /* optional */ }
            if (!Session.IsLoggedIn)
            {
                _error = "Sign in required to view or save API keys.";
                Nav.NavigateTo("/login?returnUrl=/configuration");
                return;
            }

            try { _userSettings = await Engine.GetUserSettingsAsync(); } catch { }
            await LoadCatalogAsync();

            var projs = await Engine.GetProjectsAsync();
            _projectIds = projs?.Projects.Select(p => p.Id ?? "").Where(s => s.Length > 0).ToList()
                          ?? new List<string>();

            var candidateId = ActiveProject.ProjectId;
            if (string.IsNullOrWhiteSpace(candidateId))
                candidateId = projs?.Active?.Id;

            if (!string.IsNullOrWhiteSpace(candidateId))
            {
                _projectId = candidateId;
                if (!_projectIds.Contains(_projectId, StringComparer.OrdinalIgnoreCase))
                    _projectIds.Insert(0, _projectId);
            }
            else if (_projectIds.Count > 0)
            {
                _projectId = _projectIds[0];
            }
            else
            {
                _projectId = "";
            }

            if (!string.IsNullOrEmpty(_projectId))
                await LoadAsync();

            // Deep-link ?focus=voice|music|… opens just-in-time key panel for that coverage row.
            if (FocusActive)
                BeginAddKey(_focusCapability!);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnProjectChangedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(id)) return;
        _projectId = id;
        ActiveProject.Set(id);
        await LoadAsync();
    }

    private async Task LoadCatalogAsync()
    {
        try
        {
            // WASM: hydrate SupportedModelCatalog from API (no local models_catalog.json).
            try
            {
                var raw = await Engine.GetModelsCatalogJsonAsync();
                if (!string.IsNullOrWhiteSpace(raw))
                    SupportedModelCatalog.TryLoadFromJson(raw);
            }
            catch { /* rate UI uses defaults */ }

            var list = await Engine.GetSupportedModelsAsync();
            _allModels = list.ToList();
            bool Cap(SupportedModelDto m, string c) =>
                string.Equals(m.Capability, c, StringComparison.OrdinalIgnoreCase);
            _videoModels = _allModels.Where(m => Cap(m, "video")).ToList();
            _imageModels = _allModels.Where(m => Cap(m, "image")).ToList();
            _planningModels = _allModels.Where(m => Cap(m, "chat")).ToList();
            _visionModels = _allModels.Where(m => Cap(m, "vision")).ToList();
            _audioModels = _allModels.Where(m => Cap(m, "audio")).ToList();
            _voiceModels = _allModels.Where(m => Cap(m, "voice")).ToList();
            // Prefer models that natively accept video files (e.g. Gemini 2.5 Flash)
            _videoReviewModels = _allModels.Where(m => m.SupportsVideoReview).ToList();
            if (_videoReviewModels.Count == 0)
                _videoReviewModels = _allModels.Where(m => Cap(m, "chat") || Cap(m, "vision")).ToList();
            _videoReviewModels = _videoReviewModels
                .Concat(_allModels.Where(m => m.SupportsVideoReview || Cap(m, "chat") || Cap(m, "vision")))
                .GroupBy(m => m.Id, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .ToList();

            if (_videoModels.Count == 0)
                _videoModels.Add(new SupportedModelDto { Id = "grok-imagine-video", DisplayName = "Grok Imagine Video", Provider = "Xai" });
            if (_imageModels.Count == 0)
                _imageModels.Add(new SupportedModelDto { Id = "grok-imagine-image-quality", DisplayName = "Grok Imagine Image", Provider = "Xai" });
            if (_planningModels.Count == 0)
                _planningModels.Add(new SupportedModelDto { Id = "grok-4.5", DisplayName = "Grok 4.5", Provider = "Xai" });
            if (_visionModels.Count == 0)
                _visionModels.Add(new SupportedModelDto { Id = "grok-4.5", DisplayName = "Grok 4.5 (vision)", Provider = "Xai" });
            if (_videoReviewModels.Count == 0)
                _videoReviewModels.Add(new SupportedModelDto { Id = "gemini-2.5-flash", DisplayName = "Gemini 2.5 Flash", Provider = "Google", SupportsVideoReview = true });
            if (_audioModels.Count == 0)
                _audioModels.Add(new SupportedModelDto { Id = "fal-ai/stable-audio-2.0", DisplayName = "Stable Audio 2.0 (Fal.ai)", Provider = "Fal", ProviderId = "fal" });

            if (!_audioModels.Any(m => m.Id == "none"))
                _audioModels.Insert(0, new SupportedModelDto { Id = "none", DisplayName = "None / Disabled (No Background Music)", Provider = "None" });
            if (_voiceModels.Count == 0)
            {
                _voiceModels.Add(new SupportedModelDto { Id = "eleven_voice_clone", DisplayName = "Instant voice clone (ElevenLabs)", Provider = "ElevenLabs", ProviderId = "elevenlabs", IsVoiceCloneStep = true });
                _voiceModels.Add(new SupportedModelDto { Id = "eleven_multilingual_v2", DisplayName = "Multilingual TTS (ElevenLabs)", Provider = "ElevenLabs", ProviderId = "elevenlabs" });
                _voiceModels.Add(new SupportedModelDto { Id = "fal-ai/minimax/voice-clone", DisplayName = "MiniMax voice clone (Fal)", Provider = "Fal", ProviderId = "fal", IsVoiceCloneStep = true });
                _voiceModels.Add(new SupportedModelDto { Id = "fal-ai/minimax/speech-02-hd", DisplayName = "MiniMax speech (Fal)", Provider = "Fal", ProviderId = "fal" });
            }
            // Clone models first so Settings / coverage pick the right step, not TTS-only ids.
            _voiceModels = _voiceModels
                .OrderBy(m => string.Equals(m.Id, "none", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(m => m.IsVoiceCloneStep ? 0 : 1)
                .ThenBy(m => m.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (!_voiceModels.Any(m => m.Id == "none"))
                _voiceModels.Insert(0, new SupportedModelDto { Id = "none", DisplayName = "None / Disabled (no voice clone)", Provider = "None" });
        }
        catch
        {
            _videoModels = [new SupportedModelDto { Id = "grok-imagine-video", DisplayName = "Grok Imagine Video", Provider = "Xai" }];
            _imageModels = [new SupportedModelDto { Id = "grok-imagine-image-quality", DisplayName = "Grok Imagine Image", Provider = "Xai" }];
            _planningModels = [new SupportedModelDto { Id = "grok-4.5", DisplayName = "Grok 4.5", Provider = "Xai" }];
            _visionModels = [new SupportedModelDto { Id = "grok-4.5", DisplayName = "Grok 4.5 (vision)", Provider = "Xai" }];
            _videoReviewModels = [new SupportedModelDto { Id = "gemini-2.5-flash", DisplayName = "Gemini 2.5 Flash", Provider = "Google", SupportsVideoReview = true }];
            _audioModels = [
                new SupportedModelDto { Id = "none", DisplayName = "None / Disabled (No Background Music)", Provider = "None" },
                new SupportedModelDto { Id = "fal-ai/stable-audio-2.0", DisplayName = "Stable Audio 2.0 (Fal.ai)", Provider = "Fal", ProviderId = "fal" }
            ];
            _voiceModels = [
                new SupportedModelDto { Id = "none", DisplayName = "None / Disabled (no voice clone)", Provider = "None" },
                new SupportedModelDto { Id = "eleven_voice_clone", DisplayName = "Instant voice clone (ElevenLabs)", Provider = "ElevenLabs", ProviderId = "elevenlabs", IsVoiceCloneStep = true },
                new SupportedModelDto { Id = "eleven_multilingual_v2", DisplayName = "Multilingual TTS (ElevenLabs)", Provider = "ElevenLabs", ProviderId = "elevenlabs" },
                new SupportedModelDto { Id = "fal-ai/minimax/voice-clone", DisplayName = "MiniMax voice clone (Fal)", Provider = "Fal", ProviderId = "fal", IsVoiceCloneStep = true },
                new SupportedModelDto { Id = "fal-ai/minimax/speech-02-hd", DisplayName = "MiniMax speech (Fal)", Provider = "Fal", ProviderId = "fal" },
            ];
        }
    }


    private void ParseFocusFromUri()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (q.TryGetValue("focus", out var f) && !string.IsNullOrWhiteSpace(f))
                _focusCapability = NormalizeFocus(f.ToString());
        }
        catch { _focusCapability = null; }
    }

    private static string? NormalizeFocus(string? raw)
    {
        var s = (raw ?? "").Trim().ToLowerInvariant();
        return s switch
        {
            "music" or "audio" or "bgm" => "music",
            "voice" or "voice_clone" or "clone" or "tts" => "voice",
            "review" or "qa" or "video_review" or "quality" => "review",
            "video" or "film" => "video",
            "image" or "portrait" or "characters" => "image",
            "planning" or "script" or "chat" or "screenplay" => "planning",
            "vision" or "ocr" => "vision",
            _ => string.IsNullOrWhiteSpace(s) ? null : s,
        };
    }

    private bool FocusActive => !string.IsNullOrWhiteSpace(_focusCapability);

    private string FocusLabel => _focusCapability switch
    {
        "music" => "Background music",
        "voice" => "Voice clone",
        "review" => "Video review (QA)",
        "video" => "Video generation",
        "image" => "Character portraits",
        "planning" => "Script & planning",
        "vision" => "Image vision / OCR",
        _ => _focusCapability ?? "Models",
    };

    private string? FocusKeyHint => _focusCapability switch
    {
        "music" => "needs music model + provider key",
        "voice" => "needs voice model + Voice cloning key",
        "review" => "often Gemini for native video review",
        _ => null,
    };

    private string FocusSlotClass(string slot) =>
        FocusActive && string.Equals(_focusCapability, slot, StringComparison.OrdinalIgnoreCase)
            ? "border border-info rounded p-2 bg-info bg-opacity-10"
            : "";

    private string FocusSlotStyle(string slot) =>
        FocusActive && !string.Equals(_focusCapability, slot, StringComparison.OrdinalIgnoreCase)
            ? "display:none"
            : "";

    private string? ModelHint(string modelId, string capability)
    {
        var m = _allModels.FirstOrDefault(x =>
            string.Equals(x.Id, modelId, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(x.Capability, capability, StringComparison.OrdinalIgnoreCase))
            ?? _allModels.FirstOrDefault(x =>
                string.Equals(x.Id, modelId, StringComparison.OrdinalIgnoreCase));
        if (m is null) return null;
        // Product copy only — skip vendor/env key plumbing for end users.
        if (!string.IsNullOrWhiteSpace(m.Notes))
            return m.Notes;
        return m.DisplayName;
    }

    private UserSettingsDto? _userSettings;
    private readonly Dictionary<string, string?> _keyInputs = new(StringComparer.OrdinalIgnoreCase)
    {
        ["grok"] = null,
        ["gemini"] = null,
        ["anthropic"] = null,
        ["fal"] = null,
    };
    private readonly HashSet<string> _visibleKeyProviders = new(StringComparer.OrdinalIgnoreCase);

    private bool IsKeyVisible(string providerId) => _visibleKeyProviders.Contains(providerId);

    private void ToggleKeyVisible(string providerId)
    {
        if (!IsKeyVisible(providerId)) _visibleKeyProviders.Add(providerId);
        else _visibleKeyProviders.Remove(providerId);
    }

    private bool _apiKeySaving;
    private string? _savingProviderId;
    private string? _apiKeyFeedback;
    /// <summary>Coverage row open for just-in-time key entry.</summary>
    private string? _coverageEditId;
    private string? _coverageKeyProviderId;

    private sealed class CoverageRow
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Hint { get; set; } = "";
        public string ModelId { get; set; } = "";
        public string ProviderId { get; set; } = "";
        public string ProviderDisplay { get; set; } = "";
        public bool Required { get; set; } = true;
        public bool OptionalOff { get; set; }
        public bool KeyReady { get; set; }
    }

    private IReadOnlyList<CoverageRow> BuildCoverageRows()
    {
        var rows = new List<CoverageRow>
        {
            MakeCoverage("video", "Video generation", "Clips / film", _modelName, "video", required: true),
            MakeCoverage("image", "Character portraits", "Image gen", _imageModel, "image", required: true),
            MakeCoverage("planning", "Script & planning", "Screenplay, cast, shot plan", _planningModel, "chat", required: true),
            MakeCoverage("vision", "Image vision / OCR", "Book pages & image understanding", _visionModel, "vision", required: true),
            MakeCoverage("review", "Video review (QA)", "Dialogue check & auto-review", _qualityModel, "chat", required: true, preferVideoReview: true),
            MakeCoverage("music", "Background music", "Optional scores", _audioModel, "audio", required: false),
            MakeCoverage("voice", "Voice clone", "Optional character voice sample", _voiceModel, "voice", required: false),
        };
        return rows;
    }

    private CoverageRow MakeCoverage(
        string id,
        string label,
        string hint,
        string modelId,
        string capability,
        bool required,
        bool preferVideoReview = false,
        string? forceProviderId = null)
    {
        // Optional stage turned off (music "none", etc.).
        var off = string.IsNullOrWhiteSpace(modelId)
                  || modelId.Equals("none", StringComparison.OrdinalIgnoreCase)
                  || modelId.Equals("disabled", StringComparison.OrdinalIgnoreCase);


        string providerId;
        if (!string.IsNullOrWhiteSpace(forceProviderId))
            providerId = SupportedModelCatalog.NormalizeProviderId(forceProviderId);
        else if (off)
            providerId = "";
        else
            providerId = ResolveProviderIdForModel(modelId, capability, preferVideoReview);

        var providerRow = ProviderRows.FirstOrDefault(pr =>
            string.Equals(pr.ProviderId, providerId, StringComparison.OrdinalIgnoreCase));
        var display = providerRow?.DisplayName
                      ?? (string.IsNullOrWhiteSpace(providerId) ? "" : providerId);
        var keyReady = off || string.IsNullOrWhiteSpace(providerId) || (providerRow?.IsConfigured ?? false);

        return new CoverageRow
        {
            Id = id,
            Label = label,
            Hint = hint,
            ModelId = off ? "Off" : modelId,
            ProviderId = providerId,
            ProviderDisplay = display,
            Required = required,
            OptionalOff = !required && off,
            // Optional + off counts as "ready" for the checklist (nothing missing).
            KeyReady = keyReady || (!required && off),
        };
    }

    private string ResolveProviderIdForModel(string modelId, string capability, bool preferVideoReview)
    {
        // Legacy music id still present in some project configs.
        if (string.Equals(modelId, "fal-ai/stable-audio", StringComparison.OrdinalIgnoreCase))
            modelId = "fal-ai/stable-audio-2.0";

        var m = _allModels.FirstOrDefault(x =>
            string.Equals(x.Id, modelId, StringComparison.OrdinalIgnoreCase) &&
            (preferVideoReview
                ? (x.SupportsVideoReview || string.Equals(x.Capability, capability, StringComparison.OrdinalIgnoreCase))
                : string.Equals(x.Capability, capability, StringComparison.OrdinalIgnoreCase)))
            ?? _allModels.FirstOrDefault(x => string.Equals(x.Id, modelId, StringComparison.OrdinalIgnoreCase));

        if (m is not null)
        {
            if (!string.IsNullOrWhiteSpace(m.ProviderId))
                return SupportedModelCatalog.NormalizeProviderId(m.ProviderId);
            if (!string.IsNullOrWhiteSpace(m.Provider))
                return SupportedModelCatalog.NormalizeProviderId(m.Provider);
        }

        // Infer from model id before synthetic catalog fallback (which wrongly maps unknown audio → grok).
        var inferred = InferProviderIdFromModelId(modelId);
        if (!string.IsNullOrWhiteSpace(inferred))
            return inferred;

        var cap = capability.ToLowerInvariant() switch
        {
            "video" => ModelCapability.Video,
            "image" => ModelCapability.Image,
            "vision" => ModelCapability.Vision,
            "audio" => ModelCapability.Audio,
            "voice" => ModelCapability.Voice,
            _ => ModelCapability.Chat,
        };
        var resolved = SupportedModelCatalog.NormalizeProviderId(
            SupportedModelCatalog.ProviderIdFor(modelId, cap));
        // Guard: ProviderIdFor synthesizes unknown audio as Xai/grok — never treat that as music.
        if (cap == ModelCapability.Audio && string.Equals(resolved, "grok", StringComparison.OrdinalIgnoreCase))
            return "fal";
        return resolved;
    }

    private static string InferProviderIdFromModelId(string? modelId)
    {
        if (string.IsNullOrWhiteSpace(modelId)) return "";
        var id = modelId.Trim().ToLowerInvariant();
        if (id is "none" or "disabled") return "";
        if (id.StartsWith("fal-ai/") || id.StartsWith("fal/")) return "fal";
        if (id.StartsWith("suno")) return "suno";
        if (id.StartsWith("aimusicapi") || id.Contains("aimusic")) return "aimusicapi";
        if (id.StartsWith("eleven")) return "elevenlabs";
        if (id.StartsWith("grok") || id.StartsWith("grok-")) return "grok";
        if (id.StartsWith("gemini") || id.StartsWith("veo")) return "gemini";
        if (id.StartsWith("gpt") || id.StartsWith("o1") || id.StartsWith("o3")) return "openai";
        if (id.StartsWith("claude")) return "anthropic";
        return "";
    }

    private List<string> CoverageUsesForProvider(string providerId)
    {
        return BuildCoverageRows()
            .Where(c => !c.OptionalOff
                        && !string.IsNullOrWhiteSpace(c.ProviderId)
                        && string.Equals(c.ProviderId, providerId, StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Label)
            .Distinct()
            .ToList();
    }


    private void BeginAddKey(string coverageId, string? preferredProviderId = null)
    {
        _coverageEditId = coverageId;
        _apiKeyFeedback = null;
        var list = ProvidersForCoverage(coverageId).ToList();
        if (!string.IsNullOrWhiteSpace(preferredProviderId) &&
            list.Any(x => string.Equals(x.ProviderId, preferredProviderId, StringComparison.OrdinalIgnoreCase)))
            _coverageKeyProviderId = preferredProviderId;
        else
            _coverageKeyProviderId = list.FirstOrDefault()?.ProviderId;
    }

    private void CancelAddKey()
    {
        _coverageEditId = null;
        _coverageKeyProviderId = null;
    }

    private void SelectKeyProvider(string providerId) => _coverageKeyProviderId = providerId;

    /// <summary>
    /// Click on a provider card. If a personal key is already saved, use it and align the model.
    /// Otherwise open the paste form for that provider only.
    /// </summary>
    private async Task ChooseProviderForCoverageAsync(string providerId, string coverageId)
    {
        var row = ProviderRows.FirstOrDefault(pr =>
            string.Equals(pr.ProviderId, providerId, StringComparison.OrdinalIgnoreCase));
        if (row?.IsConfigured == true)
        {
            await UseSavedProviderForCoverageAsync(providerId, coverageId);
            return;
        }
        SelectKeyProvider(providerId);
    }

    /// <summary>
    /// User already saved this provider key — point the coverage model at it and close the panel.
    /// Fixes: model is aimusicapi-suno but Suno (sunoapi) key exists → switch to suno-v5-5.
    /// </summary>
    private async Task UseSavedProviderForCoverageAsync(string providerId, string coverageId)
    {
        _error = null;
        _apiKeyFeedback = null;
        var label = ProviderRows.FirstOrDefault(pr =>
            string.Equals(pr.ProviderId, providerId, StringComparison.OrdinalIgnoreCase))?.DisplayName
            ?? providerId;

        if (string.Equals(coverageId, "music", StringComparison.OrdinalIgnoreCase))
            EnsureMusicModelForProvider(providerId);
        else if (string.Equals(coverageId, "voice", StringComparison.OrdinalIgnoreCase))
            EnsureVoiceModelForProvider(providerId);
        else
        {
            // Required stages (video, image, …): switch selected model to one from this provider if possible.
            AlignCoverageModelToProvider(coverageId, providerId);
        }

        if (!string.IsNullOrWhiteSpace(_projectId) && _cfg is not null)
        {
            try { await PersistProjectConfigAsync(); }
            catch (Exception ex) { _error = ex.Message; return; }
        }

        var ready = BuildCoverageRows().FirstOrDefault(c =>
            string.Equals(c.Id, coverageId, StringComparison.OrdinalIgnoreCase));
        if (ready?.KeyReady == true)
        {
            _apiKeyFeedback = $"{label}: using your saved key · model set to match.";
            _message = _apiKeyFeedback;
            CancelAddKey();
        }
        else
        {
            // Still not ready — open paste (key missing or model couldn't align).
            SelectKeyProvider(providerId);
            _apiKeyFeedback = $"{label}: could not mark ready — paste a key for this provider or pick another model.";
        }
    }

    private void AlignCoverageModelToProvider(string coverageId, string providerId)
    {
        var pid = SupportedModelCatalog.NormalizeProviderId(providerId);
        var models = ModelsForCoverage(coverageId);
        static string PidOf(SupportedModelDto m) =>
            !string.IsNullOrWhiteSpace(m.ProviderId)
                ? SupportedModelCatalog.NormalizeProviderId(m.ProviderId)
                : SupportedModelCatalog.NormalizeProviderId(m.Provider);

        var pick = models.FirstOrDefault(m =>
            !string.Equals(m.Id, "none", StringComparison.OrdinalIgnoreCase)
            && string.Equals(PidOf(m), pid, StringComparison.OrdinalIgnoreCase));
        if (pick is not null)
            SetCoverageModelId(coverageId, pick.Id);
    }

    private async Task SaveCoverageKeyAsync(string providerId, string coverageId)
    {
        await SaveProviderKeyAsync(providerId);
        var row = BuildCoverageRows().FirstOrDefault(c => string.Equals(c.Id, coverageId, StringComparison.OrdinalIgnoreCase));
        if (row?.KeyReady == true)
            CancelAddKey();
    }

