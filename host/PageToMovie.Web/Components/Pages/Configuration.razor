@page "/configuration"
@implements IAsyncDisposable
@implements IDisposable
@using System.Text.Json
@using PageToMovie.Core.Models
@inject EngineApiClient Engine
@inject IConfiguration AppConfig
@inject ActiveProjectState ActiveProject
@inject ThemeState Theme
@inject IJSRuntime Js
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject ClientMediaFolderService MediaFolder
@inject IAppLocalizer L

<PageTitle>@L["Nav.Settings"]</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <div class="mb-2">
            <a href="/" class="btn btn-sm btn-outline-secondary" data-testid="settings-back">@L["SettingsPage.BackToStudio"]</a>
        </div>
        <span class="ptm-adapt-kicker">@L["SettingsPage.AccountProviders"]</span>
        <h1 class="mb-1 ptm-adapt-title">@L["Nav.Settings"]</h1>
        <p class="text-muted mb-0">
            @if (!string.IsNullOrWhiteSpace(_projectId))
            {
                <span>@L["SettingsPage.SettingsForActiveProject"] <strong class="text-primary">@_projectId</strong></span>
                @if (!string.IsNullOrWhiteSpace(_saveStatus))
                {
                    <span class="ms-2 small @(_saveStatus == "Saved" ? "text-success" : "text-muted")" data-testid="settings-autosave-status">· @_saveStatus</span>
                }
            }
            else
            {
                <span>Settings and provider options for your film projects.</span>
            }
        </p>
    </div>
    @if (_projectIds.Count > 0)
    {
        <div class="d-flex align-items-center gap-2">
            <label class="fw-semibold small text-muted text-nowrap mb-0">@L["SettingsPage.ActiveProject"]</label>
            <select class="form-select form-select-sm" value="@_projectId" @onchange="OnProjectChangedAsync" style="min-width: 160px;">
                @foreach (var pid in _projectIds)
                {
                    <option value="@pid">@pid</option>
                }
            </select>
        </div>
    }
</div>

<InlineAlert Message="@_error" CssClass="mb-3" />
<InlineAlert Message="@_message" Variant="success" CssClass="mb-3" />
    <!-- STUDIO COVERAGE FIRST: change model, add/remove key just-in-time -->
    <div class="card mb-4 border-primary border-opacity-50 shadow-sm" id="api-keys" data-testid="studio-coverage-card">
        <div class="card-header bg-dark text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Studio coverage</span>
            @{
                var cov = BuildCoverageRows();
                var needed = cov.Count(c => c.Required && !c.OptionalOff);
                var ready = cov.Count(c => c.Required && !c.OptionalOff && c.KeyReady);
                var missing = cov.Where(c => c.Required && !c.OptionalOff && !c.KeyReady).ToList();
            }
            @if (missing.Count == 0)
            {
                <span class="badge text-bg-success">@ready/@needed required ready</span>
            }
            else
            {
                <span class="badge text-bg-warning text-dark">@missing.Count missing · @ready/@needed ready</span>
            }
        </div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                For each job: choose a <strong>provider</strong> (who holds the key), then a <strong>model</strong> from that provider.
                Add a provider only when you need another key. Model lists only show what that provider can run.
            </p>

            <InlineAlert Message="@_apiKeyFeedback" Variant="success" CssClass="py-2 px-3 small" />

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" data-testid="capability-coverage">
                    <thead>
                        <tr class="small text-muted">
                            <th style="min-width:9rem">Job</th>
                            <th style="min-width:10rem">Provider</th>
                            <th style="min-width:12rem">Model</th>
                            <th>Status</th>
                            <th style="min-width:10rem">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in cov)
                        {
                            var allModels = ModelsForCoverage(c.Id);
                            var providers = ProvidersForCoverage(c.Id).ToList();
                            var providerModels = ModelsForCoverageProvider(c.Id, c.ProviderId).ToList();
                            var editing = string.Equals(_coverageEditId, c.Id, StringComparison.OrdinalIgnoreCase);
                            <tr @key="@($"cov-row-{c.Id}")" class="@(c.OptionalOff ? "opacity-75" : "")" data-testid="coverage-@c.Id">
                                <td>
                                    <div class="fw-semibold small">@c.Label</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@c.Hint</div>
                                </td>
                                <td>
                                    @{
                                        // Music / voice default to "none" (off). Still show provider picker so a key
                                        // can be wired without a hidden empty dropdown.
                                        var showProviderPicker = !c.OptionalOff || c.Id is "music" or "voice";
                                    }
                                    @if (showProviderPicker && providers.Count > 0)
                                    {
                                        var provSelected = SupportedModelCatalog.NormalizeProviderId(c.ProviderId);
                                        @* Stable key per job only — do not include selection in @key (remount mid-diff
                                           with keyed <option>s caused "return wrong pooled instance"). *@
                                        <select class="form-select form-select-sm"
                                                @key="@($"cov-prov-{c.Id}")"
                                                data-testid="coverage-provider-@c.Id"
                                                disabled="@(_busy || string.IsNullOrEmpty(_projectId))"
                                                value="@provSelected"
                                                @onchange="e => OnCoverageProviderChangedAsync(c.Id, e.Value?.ToString())">
                                            @if (string.IsNullOrWhiteSpace(provSelected)
                                                 || !providers.Any(pr => string.Equals(
                                                     SupportedModelCatalog.NormalizeProviderId(pr.ProviderId),
                                                     provSelected, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="">Choose provider…</option>
                                            }
                                            @foreach (var pr in providers)
                                            {
                                                var pid = SupportedModelCatalog.NormalizeProviderId(pr.ProviderId);
                                                <option value="@pid">
                                                    @FriendlyProviderLabel(pid)@(pr.IsConfigured ? " · key saved" : " · no key")
                                                </option>
                                            }
                                        </select>
                                    }
                                    else if (c.OptionalOff)
                                    {
                                        <span class="small text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">@FriendlyProviderLabel(c.ProviderId)</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var showModelPicker = !c.OptionalOff || c.Id is "music" or "voice";
                                        var modelChoices = providerModels.ToList();
                                        // Always offer Off for optional jobs so users can enable then disable without a separate control.
                                        if (c.Id is "music" or "voice"
                                            && !modelChoices.Any(m => string.Equals(m.Id, "none", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            modelChoices.Insert(0, new SupportedModelDto
                                            {
                                                Id = "none",
                                                DisplayName = c.Id == "music" ? "Off (no background music)" : "Off (no voice clone)",
                                                Provider = "None",
                                                ProviderId = "none",
                                            });
                                        }
                                    }
                                    @if (showModelPicker && modelChoices.Count > 0 && (!string.IsNullOrWhiteSpace(c.ProviderId) || c.Id is "music" or "voice"))
                                    {
                                        var modelSelected = GetCoverageModelId(c.Id);
                                        @* Remount model list only when the provider (option set) changes. *@
                                        <select class="form-select form-select-sm"
                                                @key="@($"cov-model-{c.Id}-{SupportedModelCatalog.NormalizeProviderId(c.ProviderId)}")"
                                                data-testid="coverage-model-@c.Id"
                                                disabled="@(_busy || string.IsNullOrEmpty(_projectId))"
                                                value="@modelSelected"
                                                @onchange="e => OnCoverageModelChangedAsync(c.Id, e.Value?.ToString())">
                                            @if (string.IsNullOrWhiteSpace(c.ProviderId) && c.Id is "music" or "voice")
                                            {
                                                <option value="none">Off — pick a provider to enable</option>
                                            }
                                            else
                                            {
                                                @foreach (var m in modelChoices)
                                                {
                                                    <option value="@m.Id">
                                                        @ModelOptionLabel(m)
                                                    </option>
                                                }
                                            }
                                        </select>
                                        @if (string.IsNullOrEmpty(_projectId))
                                        {
                                            <div class="form-text">Select a project to save.</div>
                                        }
                                        else if (string.IsNullOrWhiteSpace(c.ProviderId) && c.Id is "music" or "voice")
                                        {
                                            <div class="form-text">Choose a provider (left), or Add provider if your key is not listed.</div>
                                        }
                                    }
                                    else if (c.OptionalOff)
                                    {
                                        <span class="small text-muted">Off</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(c.ProviderId))
                                    {
                                        <span class="small text-muted">No models for this provider in the catalog</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">Pick a provider first</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (c.OptionalOff)
                                    {
                                        <span class="badge text-bg-secondary">Off</span>
                                    }
                                    else if (c.KeyReady)
                                    {
                                        <span class="badge text-bg-success">Ready</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(c.ProviderId))
                                    {
                                        <span class="badge text-bg-secondary">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Need key</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-testid="coverage-add-provider-@c.Id"
                                                disabled="@_busy"
                                                title="Add another provider key for this job"
                                                @onclick="() => BeginAddProvider(c.Id)">
                                            Add provider
                                        </button>
                                        @if (!c.OptionalOff && !c.KeyReady && !string.IsNullOrWhiteSpace(c.ProviderId))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-testid="coverage-add-key-@c.Id"
                                                    disabled="@_busy"
                                                    @onclick="() => BeginAddKeyForProvider(c.Id, c.ProviderId)">
                                                Add key
                                            </button>
                                        }
                                        else if (!c.OptionalOff && c.KeyReady && !string.IsNullOrWhiteSpace(c.ProviderId))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-testid="coverage-change-key-@c.Id"
                                                    disabled="@_busy"
                                                    title="Replace only the @FriendlyProviderLabel(c.ProviderId) key"
                                                    @onclick="() => BeginReplaceKey(c.Id, c.ProviderId)">
                                                Replace key
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-testid="coverage-remove-key-@c.Id"
                                                    disabled="@_busy"
                                                    title="Remove personal key for this provider"
                                                    @onclick="() => ClearProviderKeyAsync(c.ProviderId)">
                                                Remove key
                                            </button>
                                        }
                                        @if (c.Id is "music" or "voice")
                                        {
                                            @if (!c.OptionalOff)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-link text-muted px-1"
                                                        disabled="@(_busy || string.IsNullOrEmpty(_projectId))"
                                                        @onclick="() => TurnOffOptionalAsync(c.Id)">
                                                    Turn off
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                            @if (editing)
                            {
                                <tr @key="@($"cov-edit-{c.Id}")" class="table-active" data-testid="coverage-key-panel-@c.Id">
                                    <td colspan="5" class="bg-dark bg-opacity-25">
                                        <div class="p-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                                <div class="small fw-semibold">
                                                    @if (_coverageKeyMode == "replace")
                                                    {
                                                        <span>Replace key · <span class="text-primary">@FriendlyProviderLabel(_coverageKeyProviderId)</span></span>
                                                    }
                                                    else if (_coverageKeyMode == "add-key")
                                                    {
                                                        <span>Add key · <span class="text-primary">@FriendlyProviderLabel(_coverageKeyProviderId)</span></span>
                                                    }
                                                    else
                                                    {
                                                        <span>Add provider for <span class="text-primary">@c.Label</span></span>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link" @onclick="CancelAddKey">Cancel</button>
                                            </div>
                                            <p class="small text-muted mb-2">
                                                @if (_coverageKeyMode is "replace" or "add-key")
                                                {
                                                    <span>Only this provider — paste a new key or remove the saved one.</span>
                                                }
                                                else if (c.Id == "music")
                                                {
                                                    <span>
                                                        Pick a provider for this job.
                                                        <strong>Suno API (sunoapi.org)</strong> and <strong>AI Music API (aimusicapi.ai)</strong> are different keys
                                                        (Suno is the model family).
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>Pick a provider that can run this job, then paste its key (or use a saved one).</span>
                                                }
                                            </p>
                                            <div class="row g-2">
                                                @foreach (var p in ProvidersForKeyPanel(c.Id))
                                                {
                                                    var selected = string.Equals(_coverageKeyProviderId, p.ProviderId, StringComparison.OrdinalIgnoreCase);
                                                    <div class="col-md-6 col-lg-4">
                                                        <div class="border rounded p-2 h-100 @(selected ? "border-primary" : "")"
                                                             data-testid="coverage-provider-@p.ProviderId">
                                                            <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                                                <div class="fw-semibold small">@FriendlyProviderLabel(p.ProviderId)</div>
                                                                @if (p.IsConfigured)
                                                                {
                                                                    <span class="badge text-bg-success">Has key</span>
                                                                }
                                                            </div>
                                                            @if (!selected)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm @(p.IsConfigured ? "btn-primary" : "btn-outline-primary")"
                                                                        data-testid="coverage-pick-@p.ProviderId"
                                                                        @onclick="() => ChooseProviderForCoverageAsync(p.ProviderId, c.Id)">
                                                                    @(p.IsConfigured ? "Use this key" : "Select")
                                                                </button>
                                                                @if (p.IsConfigured)
                                                                {
                                                                    <div class="form-text">Uses your saved @FriendlyProviderLabel(p.ProviderId) key and switches the model to match.</div>
                                                                }
                                                            }
                                                            else if (p.IsConfigured)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-primary mb-2"
                                                                        data-testid="coverage-use-saved-@p.ProviderId"
                                                                        disabled="@_busy"
                                                                        @onclick="() => UseSavedProviderForCoverageAsync(p.ProviderId, c.Id)">
                                                                    Use saved key
                                                                </button>
                                                                <div class="form-text mb-2">Already on file — no need to paste again unless you want to replace it.</div>
                                                                <label class="form-label small mb-1">Replace API key (optional)</label>
                                                                <div class="input-group input-group-sm mb-1">
                                                                    <input type="@(IsKeyVisible(p.ProviderId) ? "text" : "password")"
                                                                           class="form-control font-monospace"
                                                                           placeholder="@ProviderPlaceholder(p.ProviderId)"
                                                                           value="@GetKeyInput(p.ProviderId)"
                                                                           @oninput="e => SetKeyInput(p.ProviderId, e.Value?.ToString())"
                                                                           disabled="@(_busy || _apiKeySaving)" />
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            title="@(IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            aria-label="@(IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            @onclick="() => ToggleKeyVisible(p.ProviderId)">
                                                                        @if (IsKeyVisible(p.ProviderId))
                                                                        {
                                                                            @* eye-slash *@
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295l.772.772zm-2.151-2.151.772.772a.5.5 0 0 1 0 .707l-.48.48a.5.5 0 0 1-.707 0l-.772-.772a4 4 0 0 1-5.14-5.14l-.772-.772a.5.5 0 0 1 0-.707l.48-.48a.5.5 0 0 1 .707 0l.772.772A4 4 0 0 1 11.208 9.087z"/>
                                                                                <path d="M13.646 14.354a.5.5 0 0 1-.708 0l-12-12a.5.5 0 0 1 .708-.708l12 12a.5.5 0 0 1 0 .708M3.707 2.293l.773.772A7 7 0 0 0 0 8s3 5.5 8 5.5a7 7 0 0 0 3.935-1.206l.773.772A8 8 0 0 1 8 14.5C3 14.5 0 8 0 8a9 9 0 0 1 3.707-5.707"/>
                                                                            </svg>
                                                                        }
                                                                        else
                                                                        {
                                                                            @* eye *@
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                                                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                                                            </svg>
                                                                        }
                                                                    </button>
                                                                    <button class="btn btn-outline-primary" type="button"
                                                                            disabled="@(_busy || _apiKeySaving || string.IsNullOrWhiteSpace(GetKeyInput(p.ProviderId)))"
                                                                            @onclick="() => SaveCoverageKeyAsync(p.ProviderId, c.Id)">
                                                                        Replace
                                                                    </button>
                                                                </div>
                                                                <button type="button" class="btn btn-link btn-sm text-danger p-0"
                                                                        disabled="@_busy"
                                                                        @onclick="() => ClearProviderKeyAsync(p.ProviderId)">
                                                                    Remove saved key
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <label class="form-label small mb-1">API key</label>
                                                                <div class="input-group input-group-sm mb-1">
                                                                    <input type="@(IsKeyVisible(p.ProviderId) ? "text" : "password")"
                                                                           class="form-control font-monospace"
                                                                           placeholder="@ProviderPlaceholder(p.ProviderId)"
                                                                           value="@GetKeyInput(p.ProviderId)"
                                                                           @oninput="e => SetKeyInput(p.ProviderId, e.Value?.ToString())"
                                                                           disabled="@(_busy || _apiKeySaving)" />
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            title="@(IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            aria-label="@(IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            @onclick="() => ToggleKeyVisible(p.ProviderId)">
                                                                        @if (IsKeyVisible(p.ProviderId))
                                                                        {
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295l.772.772zm-2.151-2.151.772.772a.5.5 0 0 1 0 .707l-.48.48a.5.5 0 0 1-.707 0l-.772-.772a4 4 0 0 1-5.14-5.14l-.772-.772a.5.5 0 0 1 0-.707l.48-.48a.5.5 0 0 1 .707 0l.772.772A4 4 0 0 1 11.208 9.087z"/>
                                                                                <path d="M13.646 14.354a.5.5 0 0 1-.708 0l-12-12a.5.5 0 0 1 .708-.708l12 12a.5.5 0 0 1 0 .708M3.707 2.293l.773.772A7 7 0 0 0 0 8s3 5.5 8 5.5a7 7 0 0 0 3.935-1.206l.773.772A8 8 0 0 1 8 14.5C3 14.5 0 8 0 8a9 9 0 0 1 3.707-5.707"/>
                                                                            </svg>
                                                                        }
                                                                        else
                                                                        {
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                                                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                                                            </svg>
                                                                        }
                                                                    </button>
                                                                    <button class="btn btn-primary" type="button"
                                                                            disabled="@(_busy || _apiKeySaving || string.IsNullOrWhiteSpace(GetKeyInput(p.ProviderId)))"
                                                                            @onclick="() => SaveCoverageKeyAsync(p.ProviderId, c.Id)">
                                                                        Save
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            @if (!ProvidersForKeyPanel(c.Id).Any())
                                            {
                                                <InlineAlert Variant="warning" CssClass="py-2 small mb-0" Message="No providers available for this job in the catalog." />
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @{
                var savedKeys = ProviderRows.Where(pr => pr.HasPersonalKey).ToList();
            }
            @if (savedKeys.Count > 0)
            {
                <details class="mt-3" data-testid="manage-saved-keys">
                    <summary class="small text-muted" style="cursor:pointer">Manage saved keys (@savedKeys.Count)</summary>
                    <div class="row g-2 mt-2">
                        @foreach (var p in savedKeys)
                        {
                            var used = CoverageUsesForProvider(p.ProviderId);
                            <div class="col-md-6 col-lg-4">
                                <div class="border rounded p-2 small">
                                    <div class="fw-semibold">@p.DisplayName</div>
                                    @if (used.Count > 0)
                                    {
                                        <div class="text-success">In use: @string.Join(" · ", used)</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Not used by current models</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.MaskedPersonalKey))
                                    {
                                        <div class="text-muted"><code>@p.MaskedPersonalKey</code></div>
                                    }
                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 mt-1"
                                            disabled="@_busy"
                                            @onclick="() => ClearProviderKeyAsync(p.ProviderId)">
                                        Remove key
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }
        </div>
    </div>

    <!-- PROJECT STORAGE & CONFIGURATION -->
    @if (_projectIds.Count == 0 && string.IsNullOrWhiteSpace(_projectId))
    {
        <div class="alert alert-info mb-4">
            📌 <strong>No projects created yet.</strong> You can set up your global API keys above. To configure project models and options, create your first project on <a href="/" class="fw-bold">Home</a>.
        </div>
    }
    else if (_cfg is null)
    {
        <div class="alert alert-warning mb-4">
            📌 <strong>No project selected.</strong> Select an active project from the top right dropdown or visit <a href="/" class="fw-bold">Home</a> to open a project.
        </div>
    }
    else
    {
    <div class="card mb-3 border-secondary">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>📁 Project Storage &amp; Local Media Folder</span>
            <span class="badge @(MediaFolder.IsConnected ? "bg-success" : "bg-warning text-dark")">
                @(MediaFolder.IsConnected ? "Local Folder Connected" : "Local Folder Not Connected")
            </span>
        </div>
        <div class="card-body py-3">
            <div class="row align-items-stretch g-3">
                <div class="col-md-7">
                    <div class="fw-semibold mb-1">Local media folder</div>
                    <p class="small text-muted mb-2">Project media files are written here</p>
                    @if (MediaFolder.IsConnected)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <div class="font-monospace small bg-dark p-2 rounded border border-secondary text-info flex-grow-1 text-break" data-testid="config-media-folder-name">
                                @(MediaFolder.FullPath ?? MediaFolder.FolderName ?? "Selected folder")
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary flex-shrink-0"
                                    data-testid="config-select-media-folder"
                                    disabled="@_busy"
                                    @onclick="ConnectMediaFolderAsync">
                                Change folder
                            </button>
                        </div>
                    }
                    else if (MediaFolder.NeedsReconnect)
                    {
                        <div class="alert alert-warning py-2 small mb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>Browser needs permission again for <strong>@(MediaFolder.PendingReconnectFolderName ?? "your folder")</strong>.</span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-warning" data-testid="config-reconnect-media-folder" @onclick="ReconnectMediaFolderAsync">
                                    Reconnect
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="config-select-media-folder" @onclick="ConnectMediaFolderAsync">
                                    Choose different folder
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                data-testid="config-select-media-folder"
                                disabled="@_busy"
                                @onclick="ConnectMediaFolderAsync">
                            Select folder
                        </button>
                        <div class="form-text">Opens your system folder picker.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(MediaFolder.LastStatus))
                    {
                        <div class="small text-muted mt-2" data-testid="config-media-status">@MediaFolder.LastStatus</div>
                    }
                </div>
                <div class="col-md-5 border-start border-secondary ps-md-4">
                    <div class="fw-semibold small mb-1">Active Project</div>
                    <div class="h5 mb-2 text-primary">@_projectId</div>
                    <div class="small text-muted">
                        Screenplays, shot plans, and project metadata for <strong>@_projectId</strong> are safely stored on the server.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Appearance &amp; Workflow</div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">Theme</label>
                <select class="form-select" data-testid="config-theme" @bind="_uiTheme" @bind:after="OnThemeChangedAsync" disabled="@_busy">
                    <option value="dark">Dark</option>
                    <option value="light">Light</option>
                    <option value="system">Use system</option>
                </select>
                <div class="form-text">
                    Previews immediately and saves with this project.
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Preferred External Video Editor</label>
                <input type="text" class="form-control" list="video-editor-suggestions" @bind="_preferredVideoEditor" @bind:after="ScheduleAutoSaveAsync" placeholder="ClipChamp" disabled="@_busy" />
                <datalist id="video-editor-suggestions">
                    <option value="ClipChamp" />
                    <option value="DaVinci Resolve" />
                    <option value="Adobe Premiere" />
                    <option value="iMovie" />
                </datalist>
                <div class="form-text">
                    Personalized external editor used for scene refinement instructions.
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="background-music-options">
        <div class="card-header">Background music options</div>
        <div class="card-body">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <ToggleSwitch Value="_enableBackgroundMusic"
                                  ValueChanged="@(async v => { _enableBackgroundMusic = v; await ScheduleAutoSaveAsync(); })"
                                  Id="enableBgMusicSwitch" Disabled="@_busy" LabelClass="form-check-label fw-semibold">
                        <Label>Enable background music generation</Label>
                    </ToggleSwitch>
                    <div class="form-text text-muted">Score and remux music for completed scenes (provider/model above under Studio coverage).</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold mb-1">Background music volume (@_backgroundMusicVolumePercent%)</label>
                    <input type="range" class="form-range" min="5" max="100" step="5" @bind="_backgroundMusicVolumePercent" @bind:after="ScheduleAutoSaveAsync" disabled="@(!_enableBackgroundMusic || _busy)" />
                    <div class="form-text text-muted">Under dialogue (default 20%).</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Format & Resolution</div>
        <div class="card-body row g-2">
            <div class="col-md-4">
                <label class="form-label">Aspect ratio</label>
                <select class="form-select" @bind="_aspect" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy">
                    <option value="16:9">16:9</option>
                    <option value="9:16">9:16</option>
                    <option value="1:1">1:1</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Resolution</label>
                <select class="form-select" @bind="_resolution" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy">
                    <option value="480p">480p</option>
                    <option value="720p">720p</option>
                    <option value="1080p">1080p</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Duration (seconds)</label>
                <input type="number" class="form-control" min="1" max="15" @bind="_durationSeconds" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Pipeline Behavior</div>
        <div class="card-body row g-3">
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="smart" @bind="_smartContinuation" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="smart">Smart Continuation</label>
                <div class="form-text">Seamlessly extend visual prompts across consecutive clips in a scene.</div>
            </div>
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="qaRetry" @bind="_qaRetry" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="qaRetry">Quality Gate Retry</label>
                <div class="form-text">
                    When dialogue QA fails, auto-regenerate the clip (admin mode).
                </div>
            </div>
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="regenSilent" @bind="_regenSilent" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="regenSilent">Regenerate Silent Beats</label>
                <div class="form-text">Re-synthesize audio for silent action beats during scene updates.</div>
            </div>
            <div class="col-md-6 form-check">
                <input class="form-check-input" type="checkbox" id="useDur" @bind="_useDurationDefaults" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                <label class="form-check-label fw-semibold" for="useDur">Use Default Clip Durations</label>
                <div class="form-text">Fall back to standard duration budgeting when shot plan timing is unspecified.</div>
            </div>
        </div>

        <div class="card-footer">
            <details class="small">
                <summary class="text-muted role-button py-1 fw-semibold" style="cursor: pointer;">⚙️ Advanced QA Tuning</summary>
                <div class="row g-2 mt-2 pt-2 border-top">
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" id="merge" @bind="_mergeAfterClip" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                        <label class="form-check-label" for="merge">Auto-merge scene after each clip</label>
                    </div>
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" id="rebuildWip" @bind="_rebuildWip" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                        <label class="form-check-label" for="rebuildWip">Auto-rebuild WIP movie after scene</label>
                    </div>
                    <div class="col-md-4 mt-3">
                        <label class="form-label">QA Max Retries</label>
                        <input type="number" class="form-control form-control-sm" min="0" max="5" @bind="_qaMaxRetries" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                    </div>
                    <div class="col-md-4 mt-3">
                        <label class="form-label">QA Sample Frames</label>
                        <input type="number" class="form-control form-control-sm" min="1" max="8" @bind="_qaFrameCount" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                    </div>
                    <div class="col-md-4 mt-3">
                        <label class="form-label">Composite Audio Gain (dB)</label>
                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="_audioGain" @bind:after="ScheduleAutoSaveAsync" disabled="@_busy" />
                    </div>
                </div>
            </details>
        </div>
    </div>

}
