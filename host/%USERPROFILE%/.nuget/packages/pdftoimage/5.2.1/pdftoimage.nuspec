<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PDFtoImage</id>
    <version>5.2.1</version>
    <authors>David Sungaila</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>Icon_128.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/sungaila/PDFtoImage</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/sungaila/PDFtoImage/master/etc/Icon_128.png</iconUrl>
    <description>A .NET library to render PDF files into images.</description>
    <releaseNotes>- Added target framework monikers for WASM (e.g. net10.0-browser).
- Fixed a crash in linux-x64 builds.
- Fixed a crash when .NET Framework builds attempt to open a PDF file with a password containing non-ASCII characters.</releaseNotes>
    <tags>PDF Bitmap Image Convert Conversion C# PDFium SkiaSharp Skia PNG JPG JPEG WEBP Xamarin Android iOS MacCatalyst Catalyst MAUI wasm WebAssembly</tags>
    <repository type="git" url="https://github.com/sungaila/PDFtoImage.git" commit="0eb81fdffb9bcd27ba34a4fa0bac63318844de1b" />
