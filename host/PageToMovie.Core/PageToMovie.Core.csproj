<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The models catalog is the single source of truth and is loaded ONLY from these embedded
         resources (SupportedModelCatalog.EnsureLoaded) — no on-disk file, no /data override. Real
         servers embed/use models_catalog.json; fakes mode uses the standalone models_catalog.fake.json
         (a one-time copy of the real rows + the Fake Studio vendor). The real server never loads the
         fake resource. Change the catalog in git and rebuild; runtime edits are unsupported. -->
    <EmbeddedResource Include="config\models_catalog.json">
      <LogicalName>PageToMovie.Core.config.models_catalog.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="config\models_catalog.fake.json">
      <LogicalName>PageToMovie.Core.config.models_fake_catalog.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
