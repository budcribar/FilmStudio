{
  "version": 1,
  "description": "Voice model catalog. Add providers here; Settings UI and server prefs pick among them. API keys live in ptm_secrets / env — never in this file.",
  "defaults": {
    "cloneProvider": "mock",
    "sampleMinSec": 2,
    "sampleTargetSec": 12,
    "sampleMaxSec": 20,
    "outputFormat": "audio/mpeg",
    "outputExtension": "mp3"
  },
  "models": [
    {
      "id": "mock-instant-clone",
      "providerId": "mock",
      "displayName": "Mock Instant Clone",
      "description": "Synthetic MP3 on the client — no API key. Always available for demos.",
      "kind": "instant_clone",
      "apiModelId": null,
      "requiresApiKey": false,
      "clientSideOnly": true,
      "input": {
        "accept": ["audio/*", "video/*"],
        "minSec": 2,
        "maxSec": 60,
        "maxBytes": 5242880
      },
      "output": {
        "mimeType": "audio/mpeg",
        "extension": "mp3",
        "storage": "client_media"
      },
      "pricing": {
        "creditsBase": 5,
        "creditsPerRole": 4,
        "notes": "Mirrors VOICE_ADDON_* demo credits."
      },
      "enabled": true
    },
    {
      "id": "elevenlabs-instant-ivc",
      "providerId": "elevenlabs",
      "displayName": "ElevenLabs Instant Voice Clone",
      "description": "Clone from a short sample, then TTS lines. Store key in Settings (or ELEVENLABS_API_KEY env). Audio returns to client media store for stitch.",
      "kind": "instant_clone",
      "apiModelId": "eleven_multilingual_v2",
      "cloneEndpoint": "https://api.elevenlabs.io/v1/voices/add",
      "ttsEndpoint": "https://api.elevenlabs.io/v1/text-to-speech/{voice_id}",
      "requiresApiKey": true,
      "apiKeyEnv": "ELEVENLABS_API_KEY",
      "clientSideOnly": false,
      "input": {
        "accept": ["audio/*"],
        "minSec": 10,
        "maxSec": 120,
        "maxBytes": 10485760
      },
      "output": {
        "mimeType": "audio/mpeg",
        "extension": "mp3",
        "storage": "client_media"
      },
      "pricing": {
        "creditsBase": 5,
        "creditsPerRole": 4,
        "notes": "Reconcile with ElevenLabs character pricing later."
      },
      "enabled": true
    }
  ]
}
